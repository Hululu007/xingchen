<?xml version="1.0" encoding="utf-8"?>
<!-- 红果合集详情页·集行（批四卡 8）：横版封面＋标题＋副行（回包
     sub_title_list 文案段，如点赞数）。字段只用 album_detail 名单行
     实有键（series_cover/series_title/sub_title_list），不编时长等
     未进模型的字段。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/hg_ae_cover"
        android:layout_width="112dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_hg_cover_r6"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hg_ae_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_ae_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
