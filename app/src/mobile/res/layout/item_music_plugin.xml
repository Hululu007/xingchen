<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/card_music"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/formatTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/badge_music"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 对照表 P10 作者行（版本行后，空则不显） -->
        <TextView
            android:id="@+id/author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- C4 检测状态文案（四态色见 MusicPluginTest.labelColor） -->
        <TextView
            android:id="@+id/testStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <!-- 对照表 P12 失败 message 行内展开（检测失败且 message 非空时显，11sp，色与状态色一致） -->
        <TextView
            android:id="@+id/pluginError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFF3B30"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- C4 行内“检测”钮（放开关左侧；与 pluginMenu 菜单项二选一，定行内钮，菜单不另加检测项） -->
    <TextView
        android:id="@+id/pluginTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/badge_music"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="检测"
        android:textColor="#1C1C1E"
        android:textSize="12sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/pluginSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/pluginMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/player_more"
        android:padding="10dp"
        android:src="@drawable/ic_music_more" />
</LinearLayout>
