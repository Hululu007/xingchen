<?xml version="1.0" encoding="utf-8"?>
<!-- 经典主题（GZ PlayerScreenKt 经典分支 :22309-22575 装配转写）：
     封面 → SongMeta（歌名/歌手/专辑＋收藏小爱心＋右侧三键 40dp）→ 内嵌封面歌词（横向内边距 28dp）
     → 间隔 6dp → PlaybackScrubber（音质筹/歌词筹＋细进度，横向内边距 28dp）→ 底部间隔 45dp。
     经典主题无上一首/下一首键：切歌靠封面横滑（代码侧手势）；播放/暂停在 SongMeta 三键内。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="0dp">

    <!-- 封面区：GZ 经典＝封面图本身满幅铺底（上半原图、下半模糊延伸），不是 28dp 边距的卡片；
         手势在代码侧挂 tpCoverWrap（双击收藏/长按工具面板/竖滑切歌/单击开全屏歌词页）。
         满幅后封面不再是卡片：去边距、去卡片投影，宽＝屏宽、高随图（方图即方幅）。 -->
    <FrameLayout
        android:id="@+id/tpCoverWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/tpCover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop" />

        <!-- 出场封面层（redo3 F1）：切歌时旧封面暂存于此做 出场动画，平时 gone -->
        <ImageView
            android:id="@+id/tpCoverExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- SongMeta：GZ 经典两行——歌名一行、歌手 ♡ 专辑同行一行（不是星辰旧的三行）；
         歌名 18sp/800/白 0.95/行高 24sp/字距 -0.022em，歌手 14sp/白 0.34、专辑 14sp/白 0.26、
         收藏心 13dp＋外垫 7dp（27dp 盒）在歌手专辑同一行里恒在；右侧三键点击区 40dp 见方，与标题间距 8dp；
         歌名到第二行间距 2dp（GZ 紧凑口径确数未抠到，先按现行 2dp，真机核）。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontWeight="800"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.022"
                    android:lineHeight="24dp"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 第二行：TableLayout + shrinkColumns="0"（歌手列可缩）——LinearLayout 下长歌手会把爱心/专辑顶出右边缘
                 （歌手先量 AT_MOST 整列宽），短歌手时又不许用 weight（会把专辑顶到右边缘，刚修过的问题）；
                 shrink 列两头都对：短时紧贴爱心、长时歌手先省略号收缩、爱心/专辑恒在。行高 22dp（GZ 第二行容器高），
                 爱心盒 27宽×13高（图标 13dp＋左右各 7dp、上下 0dp，竖向 13dp＜22dp 不溢出）。 -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:shrinkColumns="0">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tpArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontWeight="500"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:lineHeight="18dp"
                        android:maxLines="1"
                        android:textColor="#57FFFFFF"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/tpFavHeart"
                        android:layout_width="27dp"
                        android:layout_height="13dp"
                        android:contentDescription="@string/music_favorite"
                        android:paddingLeft="7dp"
                        android:paddingRight="7dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:src="@drawable/ic_music_heart"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tpAlbum"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontWeight="500"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:lineHeight="18dp"
                        android:maxLines="1"
                        android:textColor="#42FFFFFF"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpBtnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_more"
                android:padding="9.5dp"
                android:src="@drawable/ic_music_menu"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnQueueTitle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_queue"
                android:padding="10dp"
                android:src="@drawable/ic_music_queue"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpPlayTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/pl_play_pause"
                android:padding="7.5dp"
                android:src="@drawable/ic_music_play"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 内嵌封面歌词：横向内边距 28dp、weight 占余下高度（组件 cover 模式，窗口 4 行）；点行开全屏歌词页 -->
    <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
        android:id="@+id/tpLyricView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />

    <!-- PlaybackScrubber：与歌词区间隔 6dp、横向内边距 28dp；
         音质筹（实测值，取不到整筹隐藏）＋歌词筹一行在进度之上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tpPositionTop"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:includeFontPadding="false"
                android:letterSpacing="0.018"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tpChipQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_player_chip"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tpQualityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.054"
                        android:maxLines="1"
                        android:textColor="#B8FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tpChipLyric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_player_chip"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/tpLyricChipText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.054"
                        android:maxLines="1"
                        android:text="@string/music_lyric_chip_line"
                        android:textColor="#B8FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tpDurationTop"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:gravity="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.018"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 进度：轨道上方间隔 4dp、容器高 18dp（GZ Canvas 高）、轨道基高 4dp（拖动 5dp 见代码 swapSeekDrawable）；
             顶盒两侧时间 11sp：静止不可见、拖动 0.72（GZ 口径，代码 setTopTimesAlpha） -->
        <SeekBar
            android:id="@+id/tpSeek"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/bg_player_seek_progress"
            android:thumb="@drawable/bg_player_seek_thumb" />

        <!-- 下一首块已按用户令拿掉：进度条直接贴底一档（45dp 间隔），不再显示下首歌名。 -->
    </LinearLayout>

    <!-- 底部间隔 45dp（GZ 经典分支末尾 Spacer） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="45dp" />
</LinearLayout>
