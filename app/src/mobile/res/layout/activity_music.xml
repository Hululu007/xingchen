<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐首页（第十稿定稿构成，从零重写）：独立页、自有背景铺满整屏——
     根 FrameLayout＝MusicGlassBackgroundView 一份（全域统一背景）＋滚动层并列；
     边距只打滚动层（左右 16dp、底 16dp、顶＝状态栏高＋12dp 由代码补），背景层不吃边距。
     自上而下：渐变标题＋金星＋黑胶斜探 → 通知权限提示条（不可用才显） → 搜索胶囊＋⋮ →
     五快捷独立玻璃片一行（本地音乐居中第三） → 继续播放卡（有断点才显） →
     三彩卡横排（卡面本体＝各自渐变，光晕只作卡内淡水印） → 心情电台卡（末卡） →
     122dp 留白（给悬浮迷你条让位，迷你条只在首页显示）。
     玻璃件一律先挂 bg_music_glass_* XML 件作可见下限，运行时 MusicGlassWire 升级同源液态玻璃。
     顶栏只有左对齐标题、无返回箭头（铁律）；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/homeGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 标题行：渐变标题（24sp/800、字距紧、带一点斜）＋小金星＋右上黑胶斜探出 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/homeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.029"
                        android:text="星辰音乐"
                        android:textColor="#FF5C8A"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeTitleStar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="★"
                        android:textColor="#F5A623"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/homeVinyl"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-4dp"
                    android:background="@drawable/bg_music_home_vinyl"
                    android:contentDescription="@null"
                    android:rotation="24" />
            </FrameLayout>

            <!-- 通知权限提示条：通知不可用才显（深底白字＋黄钮，2026-10-09 定案形态） -->
            <LinearLayout
                android:id="@+id/notifPermStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/home_bg_notif_strip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="9dp"
                android:paddingBottom="9dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/notifHintText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="通知没开，播放通知可能不显示"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/notifHintGo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_bg_notif_btn"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="去开启"
                    android:textColor="#1C1C1E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 搜索胶囊（整条点进搜索页）＋后面 ⋮ 小菜单（只插件管理／设置两项） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/homeSearchBar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_music_glass_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_music_search" />

                    <TextView
                        android:id="@+id/homeSearchHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/home_search_hint"
                        android:textColor="#8E8E93"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/homeMoreBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/home_more"
                    android:padding="9dp"
                    android:src="@drawable/ic_music_more" />
            </LinearLayout>

            <!-- 五快捷：五片独立玻璃片一行（片间 6dp），彩色图标＋名字＋计数，本地音乐居中第三 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/homeQuickFavorite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_music_glass_quick"
                    android:elevation="2dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_music_heart" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_favorite"
                        android:textColor="#141414"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeQuickFavCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#B2B2B2"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeQuickSheets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_music_glass_quick"
                    android:elevation="2dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_music_queue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_sheets"
                        android:textColor="#141414"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeQuickSheetCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#B2B2B2"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeQuickDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_music_glass_quick"
                    android:elevation="2dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_music_note" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_device"
                        android:textColor="#141414"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeQuickDeviceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#B2B2B2"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeQuickRecent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_music_glass_quick"
                    android:elevation="2dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_music_timer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_recent"
                        android:textColor="#141414"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeQuickRecentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#B2B2B2"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeQuickDownload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_music_glass_quick"
                    android:elevation="2dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_music_download" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_download"
                        android:textColor="#141414"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeQuickDownloadCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#B2B2B2"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 继续播放卡：有历史／断点才显；历史前 4 封面横排，点封面从该首续播整列，圆键切换／断点续播 -->
            <LinearLayout
                android:id="@+id/homeContinueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_music_glass_white_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_continue"
                        android:textColor="#FA243C"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeContinueName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#999999"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/homeContinuePlay"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_music_continue_play"
                        android:contentDescription="@string/home_play"
                        android:padding="12dp"
                        android:src="@drawable/ic_music_play" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeContinueCovers"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/homeContinueCover0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/homeContinueCover1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/homeContinueCover2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/homeContinueCover3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/homeContinueProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/bg_music_continue_progress" />
            </LinearLayout>

            <!-- 三彩卡横排垫底：卡面本体＝各自渐变（粉／蓝绿／绿黄），光晕只作卡内淡水印（代码装环，压在内容下层） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/homeCardGuess"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_weight="1"
                    android:background="@drawable/home_bg_card_pink"
                    android:clipChildren="true">

                    <View
                        android:id="@+id/homeGuessHalo"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="-24dp"
                        android:layout_marginBottom="-24dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_guess"
                            android:textColor="#1A1A1A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_guess_sub"
                            android:textColor="#6E6E73"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/homeGuessCovers"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/homeGuessCover0"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:id="@+id/homeGuessCover1"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="-8dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:id="@+id/homeGuessCover2"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="-8dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/homeCardCharts"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/home_bg_card_teal"
                    android:clipChildren="true">

                    <View
                        android:id="@+id/homeChartHalo"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="-24dp"
                        android:layout_marginBottom="-24dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_charts"
                            android:textColor="#1A1A1A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_charts_sub"
                            android:textColor="#6E6E73"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/homeChartTop0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#3A3A3C"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/homeChartTop1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#3A3A3C"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/homeChartTop2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#3A3A3C"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/homeCardShuffle"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/home_bg_card_lime"
                    android:clipChildren="true">

                    <View
                        android:id="@+id/homeShuffleHalo"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="-24dp"
                        android:layout_marginBottom="-24dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_shuffle"
                            android:textColor="#1A1A1A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/homeShuffleSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_shuffle_sub"
                            android:textColor="#6E6E73"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/homeShuffleDiscWrap"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:id="@+id/homeShuffleDisc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_music_home_glow_disc"
                            android:contentDescription="@null" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_music_play" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 心情电台卡（三彩卡下面）：卡底真玻璃，心情色走选中片／播放钮／波形；12 心情两行片＋波形＋播放钮 -->
            <LinearLayout
                android:id="@+id/homeMoodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_music_glass_entry"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="心情电台"
                        android:textColor="#1C1C1E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeMoodName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#3A3A3C"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeMoodDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#8E8E93"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeMoodPills1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/homeMoodPills2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.fongmi.android.tv.ui.view.MoodWaveView
                        android:id="@+id/homeMoodWave"
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/homeMoodPlay"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/home_play"
                        android:padding="13dp"
                        android:src="@drawable/ic_music_play" />
                </LinearLayout>
            </LinearLayout>

            <!-- 底部留白：给只在首页显示的悬浮迷你条让位（条高 68＋底浮空 10＋净空隙，与改前同口径） -->
            <View
                android:layout_width="match_parent"
                android:layout_height="122dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
