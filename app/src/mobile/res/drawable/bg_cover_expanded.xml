<?xml version="1.0" encoding="utf-8"?>
<!-- 展开态卡面（GZ CoverBackdropCard：圆角 22dp＋黑 0.35 透明度层 #59000000，盖在深灰渐变 #3A3A3C→#1C1C1E 之上；
     内铺模糊封面仍不在本文件内，不编数、不另补）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF3A3A3C" android:endColor="#FF1C1C1E" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
