<?xml version="1.0" encoding="utf-8"?>
<!-- 海阔小程序单页：V1 规则列表 / V2 分类+列表 / V3 搜索结果，三视图栈式切换 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">

        <!-- ============ V1 规则列表 ============ -->
        <RelativeLayout
            android:id="@+id/view_rules"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 规则列表：内容从顶部开始，滚动时从悬浮磨砂顶栏下穿过 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rules"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/btn_import"
                android:layout_alignParentTop="true"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:paddingTop="64dp"
                android:paddingBottom="8dp" />

            <!-- 悬浮磨砂顶栏：独立背景层（真 blur）+ 内容层，列表滚动时从下方穿过 -->
            <FrameLayout
                android:id="@+id/header_cluster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true">

                <View
                    android:id="@+id/header_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hk_header_glass" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 小程序列表顶栏：小程序 …… 右侧 搜索 | 排序 | 编辑 -->
                    <LinearLayout
                        android:id="@+id/top_bar_rules"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">

                        <TextView
                            android:id="@+id/tv_title_rule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="小程序"
                            android:textColor="#101216"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/btn_search_rule"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="搜索小程序"
                            android:padding="4dp"
                            android:src="@drawable/ic_action_search" />

                        <ImageView
                            android:id="@+id/btn_sort_rule"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="排序"
                            android:padding="4dp"
                            android:src="@drawable/ic_fab_filter"
                            android:tint="#101216" />

                        <!-- 编辑模式才显示：分组管理入口 -->
                        <TextView
                            android:id="@+id/btn_group_manage"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="分组管理"
                            android:textColor="#101216"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_edit_rule"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="编辑"
                            android:textColor="#101216"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_rule_group"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:visibility="gone" />

                    <!-- 首页 inline 搜索条：点 🔍 展开，输入实时过滤小程序卡片，不跳页 -->
                    <LinearLayout
                        android:id="@+id/inline_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="16dp"
                        android:background="@drawable/hk_searchbar_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="16dp"
                        android:paddingRight="4dp"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/et_inline_search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="搜索小程序"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#101216"
                            android:textColorHint="#8A8F98"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/btn_inline_close"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="关闭搜索"
                            android:src="@drawable/ic_hk_close" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/empty_rules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/hk_capsule_light"
                    android:gravity="center"
                    android:text="海"
                    android:textColor="#D4A017"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="暂无规则"
                    android:textColor="#101216"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点下方按钮导入你的第一条规则"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_import"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="16dp"
                android:background="@drawable/hk_gold_button"
                android:elevation="8dp"
                android:gravity="center"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:text="＋ 导入规则"
                android:textColor="#101216"
                android:textSize="15sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- ============ V2 分类+列表 ============ -->
        <LinearLayout
            android:id="@+id/view_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 用户要求删除内容页顶栏（返回键/标题/搜索图标）：返回走系统返回键，搜索走内嵌搜索条 -->

            <LinearLayout
                android:id="@+id/miniapp_tabs_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/hk_miniapp_tabs_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_miniapp_tabs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/btn_miniapp_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/dialog_option_card_light"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="全部 ▾"
                    android:textColor="#FF1A1D24"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 8.83 同款原生分类行：横向滚动 + 右侧 ">"（点开"请选择分类"弹窗） -->
            <LinearLayout
                android:id="@+id/category_row"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_category"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/btn_category_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/tab_item_default"
                    android:contentDescription="展开"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="30dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text=">"
                    android:textColor="#666666"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 8.83 同款：JS scroll_button/flex_button 动态 tab 行容器（每条目一行，各带 > 展开按钮） -->
            <LinearLayout
                android:id="@+id/ll_tab_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 8.83 同款：内容页内嵌搜索栏（搜索短剧/演员 + 搜索按钮） -->
            <LinearLayout
                android:id="@+id/search_bar_content"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/hk_capsule_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_search_content"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索短剧 / 演员"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#101216"
                    android:textColorHint="#8A8F98"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_search_content_go"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/hk_gold_button"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="搜索"
                    android:textColor="#101216"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filter_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_videos"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_content_empty"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="加载失败，点我重试"
                        android:textColor="#101216"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/loading_content"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:elevation="8dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:indeterminateTint="#D4A017" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="加载中…"
                            android:textColor="#101216"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="#101216"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>

        <!-- ============ V3 搜索 ============ -->
        <LinearLayout
            android:id="@+id/view_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/hk_searchbar_glass"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="8dp">

                <ImageButton
                    android:id="@+id/btn_back_search"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_hk_back" />

                <EditText
                    android:id="@+id/et_keyword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="输入关键词搜索"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#101216"
                    android:textColorHint="#3A3F45"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btn_clear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="清除"
                    android:src="@drawable/ic_hk_close"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_search_go"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/hk_gold_button"
                    android:gravity="center"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="搜索"
                    android:textColor="#101216"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 小程序内搜索的作用域标识：显示当前在哪个小程序内搜索，避免被误认为全局搜索 -->
            <TextView
                android:id="@+id/tv_search_scope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textColor="#D4A017"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/search_mode_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/hk_mode_seg_glass"
                android:orientation="horizontal"
                android:padding="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_mode_rules"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/hk_seg_on"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="搜小程序"
                    android:textColor="#101216"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mode_content"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/hk_seg_off"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="搜内容"
                    android:textColor="#3A3F45"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="搜索历史"
                        android:textColor="#101216"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_clear_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="清空"
                        android:textColor="#D4A017"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_rules"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tv_search_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="无相关结果"
                android:textColor="#101216"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ V4 详情 ============ -->
        <LinearLayout
            android:id="@+id/view_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/hk_capsule_light"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="20dp">

                <ImageButton
                    android:id="@+id/btn_back_detail"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_hk_back" />

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="#101216"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/detail_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_detail_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#101216"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_detail_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="#101216"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_detail_cover"
                            android:layout_width="100dp"
                            android:layout_height="150dp"
                            android:background="@drawable/hk_capsule_light"
                            android:scaleType="centerCrop" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_detail_intro_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="简介"
                        android:textColor="#101216"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_detail_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#101216"
                        android:textSize="14sp" />

                    <!-- V4 复制按钮行：简介下方、选集上方，每 copy 条目一个按钮 -->
                    <HorizontalScrollView
                        android:id="@+id/copy_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/copy_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tv_detail_line_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="线路"
                        android:textColor="#101216"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_detail_lines"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false" />

                    <TextView
                        android:id="@+id/tv_detail_ep_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="选集"
                        android:textColor="#101216"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_detail_episodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/tv_detail_loading"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="#D4A017" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="加载中…"
                    android:textColor="#101216"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="加载失败，点我重试"
                android:textColor="#101216"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
