<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/bg_notif_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/notifCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_notif_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notifTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notifArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notifPrev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_notif_btn"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_notif_prev" />

    <ImageView
        android:id="@+id/notifPlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_notif_playbtn"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/ic_notif_play" />

    <ImageView
        android:id="@+id/notifNext"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_notif_btn"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_notif_next" />
</LinearLayout>
