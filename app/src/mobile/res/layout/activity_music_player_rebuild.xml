<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页骨架（重做批二从零重写）：背景层满幅拉到状态栏后面，内容层由宿主垫状态栏高。
     根不许 fitsSystemWindows（横版旧坑）；背景层 match_parent 满幅不受垫高影响。
     层序（自下而上）：糊版一体背景 ivBgBlur（CoverAmbientView，含垫底色＋糊图＋渐变罩）→
     流体背景 fluidAmbient（FluidCoverAmbientView，流体开时才显）→ 罩层 viewVeil（宿主附加压暗）→
     主题层 themeContainer（PlayerPageSwipeLayout，主题根挂在它下面）→ 竖滑方向提示 →
     爱心粒子层 heartsOverlay → 全屏歌词页 lyricPage → 通知提示条。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fongmi.android.tv.ui.music.CoverAmbientView
        android:id="@+id/ivBgBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.FluidCoverAmbientView
        android:id="@+id/fluidAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/viewVeil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <com.fongmi.android.tv.ui.custom.PlayerPageSwipeLayout
        android:id="@+id/themeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/swipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/swipeHintDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B8FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/swipeHintName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#EBFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/heartsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/lyricPage"
        layout="@layout/music_lyric_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/notifHintStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_player_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/notifHintText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="通知权限未开启，锁屏与通知栏可能看不到播放卡"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notifHintGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="去开启"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
