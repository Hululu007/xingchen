<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_music_quality_row"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/qr_icon_box"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_music_quality_icon">

        <ImageView
            android:id="@+id/qr_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/qr_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1C1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qr_spec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8E8E93"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/qr_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="未知"
        android:textColor="#8E8E93"
        android:textSize="13sp" />
</LinearLayout>
