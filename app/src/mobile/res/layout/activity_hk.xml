<?xml version="1.0" encoding="utf-8"?>
<!-- 海阔小程序单页：V1 规则列表 / V2 分类+列表 / V3 搜索结果，三视图栈式切换 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">

        <!-- ============ V1 规则列表 ============ -->
        <RelativeLayout
            android:id="@+id/view_rules"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 顶栏：左侧[小程序 20sp][☰菜单]，右侧[编辑][新增][🔍搜索]（搜索放最右） -->
            <LinearLayout
                android:id="@+id/top_bar_rules"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_alignParentTop="true"
                android:background="@drawable/hk_header_glass"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">

                <TextView
                    android:id="@+id/tv_title_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小程序"
                    android:textColor="#101216"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_menu_rule"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="菜单"
                    android:padding="6dp"
                    android:src="@drawable/ic_hk_menu" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_edit_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hk_btn_glass"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="编辑"
                    android:textColor="#101216"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_add_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hk_btn_glass"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="新增"
                    android:textColor="#101216"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_search_rule"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="搜索小程序"
                    android:padding="6dp"
                    android:src="@drawable/ic_action_search" />
            </LinearLayout>

            <!-- 分组 tab：横向滚动，吸附居中，首项"全部" -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rule_group"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_below="@id/top_bar_rules"
                android:clipToPadding="false"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

            <!-- 分组分页：每页一个分组，"全部"页带 TYPE 头卡 -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_rules"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/rv_rule_group" />

            <!-- 右下悬浮按钮：点开快速切换分组弹窗，长按隐藏 -->
            <ImageView
                android:id="@+id/float_btn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="96dp"
                android:background="@drawable/hk_float_btn_bg"
                android:contentDescription="切换分组"
                android:padding="10dp"
                android:src="@drawable/ic_hk_layers" />

            <LinearLayout
                android:id="@+id/empty_rules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/hk_capsule_light"
                    android:gravity="center"
                    android:text="海"
                    android:textColor="#D4A017"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="暂无规则"
                    android:textColor="#101216"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点右上角「新增」创建，或点 ☰ 菜单导入"
                    android:textColor="#8A8F98"
                    android:textSize="12sp" />
            </LinearLayout>

        </RelativeLayout>


        <!-- ============ V2 分类+列表 ============ -->
        <LinearLayout
            android:id="@+id/view_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 用户要求删除内容页顶栏（返回键/标题/搜索图标）：返回走系统返回键，搜索走内嵌搜索条 -->

            <LinearLayout
                android:id="@+id/miniapp_tabs_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/hk_miniapp_tabs_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_miniapp_tabs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/btn_miniapp_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/dialog_option_card_light"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="全部 ▾"
                    android:textColor="#FF1A1D24"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 8.83 同款静态分类 tab 行容器：class/area/year/sort 各独立一行
                 （横向滚动 + 右侧 ">" 点开"请选择分类"弹窗），由 buildCategoryRow 动态建行 -->
            <LinearLayout
                android:id="@+id/category_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 8.83 同款：JS scroll_button/flex_button 动态 tab 行容器（每条目一行，各带 > 展开按钮） -->
            <LinearLayout
                android:id="@+id/ll_tab_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 8.83 同款：内容页内嵌搜索栏（搜索短剧/演员 + 搜索按钮） -->
            <LinearLayout
                android:id="@+id/search_bar_content"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/hk_capsule_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_search_content"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索短剧 / 演员"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#101216"
                    android:textColorHint="#8A8F98"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_search_content_go"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/hk_gold_button"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="搜索"
                    android:textColor="#101216"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filter_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 8.83 同款：SmartRefreshLayout + ClassicsHeader 下拉刷新 + 右侧快速滚动条 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <com.scwang.smart.refresh.layout.SmartRefreshLayout
                    android:id="@+id/refresh_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srlEnableOverScrollBounce="true"
                    app:srlEnableOverScrollDrag="true">

                    <com.scwang.smart.refresh.header.ClassicsHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_videos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />
                </com.scwang.smart.refresh.layout.SmartRefreshLayout>

                <!-- 右侧快速滚动条（对照 8.83 RecyclerFastScroller） -->
                <com.fongmi.android.tv.ui.custom.HkFastScroller
                    android:id="@+id/fast_scroller"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/tv_content_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="加载失败，点我重试"
                    android:textColor="#101216"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/loading_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="#D4A017" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="加载中…"
                        android:textColor="#101216"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="#101216"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ V3 搜索 ============ -->
        <LinearLayout
            android:id="@+id/view_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 对照 8.83 activit_search_one_result：44dp 高 CardView（圆角 8dp 无阴影），
                 EditText 浅灰底，清空按钮在输入框内部右侧 -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="8dp">

                <ImageButton
                    android:id="@+id/btn_back_search"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_hk_back" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <EditText
                            android:id="@+id/et_keyword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/gray_rice_deep"
                            android:gravity="center_vertical"
                            android:hint="请输入搜索关键词"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:lines="1"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingEnd="44dp"
                            android:textColor="#101216"
                            android:textColorHint="#848484"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/btn_clear"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="清空"
                            android:padding="8dp"
                            android:src="@drawable/ic_hk_close"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/btn_search_go"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/hk_gold_button"
                    android:gravity="center"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="搜索"
                    android:textColor="#101216"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 对照 8.83：搜索模式切换小字，点击在 默认/精准 间切换 -->
            <TextView
                android:id="@+id/tv_search_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="搜索模式：默认"
                android:textColor="#3A3F45"
                android:textSize="13sp" />

            <!-- 小程序内搜索的作用域标识：显示当前在哪个小程序内搜索，避免被误认为全局搜索 -->
            <TextView
                android:id="@+id/tv_search_scope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textColor="#D4A017"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/search_mode_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/hk_mode_seg_glass"
                android:orientation="horizontal"
                android:padding="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_mode_rules"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/hk_seg_on"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="搜小程序"
                    android:textColor="#101216"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mode_content"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/hk_seg_off"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="搜内容"
                    android:textColor="#3A3F45"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="搜索历史"
                        android:textColor="#101216"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_clear_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="清空"
                        android:textColor="#D4A017"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_rules"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <!-- 对照 8.83 fragment_search：SmartRefreshLayout（ClassicsHeader/Footer），
                 结果区底部横向不定进度条 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <com.scwang.smartrefresh.layout.SmartRefreshLayout
                    android:id="@+id/search_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginBottom="3dp"
                    app:srlEnableOverScrollBounce="true"
                    app:srlEnableOverScrollDrag="true">

                    <com.scwang.smartrefresh.layout.header.ClassicsHeader
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_search_results"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />

                    <com.scwang.smartrefresh.layout.footer.ClassicsFooter
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.scwang.smartrefresh.layout.SmartRefreshLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/search_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="2dp"
                    android:contentDescription="搜索中"
                    android:src="@drawable/hk_avd_progress_indeterminate"
                    android:visibility="invisible" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_search_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="无相关结果"
                android:textColor="#101216"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ V4 详情 ============ -->
        <LinearLayout
            android:id="@+id/view_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/hk_capsule_light"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="20dp">

                <ImageButton
                    android:id="@+id/btn_back_detail"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_hk_back" />

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="#101216"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_fav_detail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="加入收藏"
                    android:src="@drawable/ic_hk_favorite" />

                <ImageButton
                    android:id="@+id/btn_menu_detail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="更多"
                    android:src="@drawable/ic_hk_more" />
            </LinearLayout>

            <!-- 8.83 原版：详情页走通用列表渲染器（FilmListActivity + ArticleListAdapter），
                 不再用专用定制布局。条目按 col_type 渲染：detail_header/long_text/flex_button -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_detail_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:visibility="gone" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/tv_detail_loading"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="#D4A017" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="加载中…"
                    android:textColor="#101216"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="加载失败，点我重试"
                android:textColor="#101216"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
