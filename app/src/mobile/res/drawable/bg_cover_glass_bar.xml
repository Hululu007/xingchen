<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃歌词条（GZ CoverLyricGlassBar：基底 #1E1E22、白渐变 0.26→0.08、描边 1dp、圆角 22dp；毛玻璃模糊为应用侧近似） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1E1E22" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#42FFFFFF" android:endColor="#14FFFFFF" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
