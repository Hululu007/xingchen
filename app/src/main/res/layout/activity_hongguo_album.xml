<?xml version="1.0" encoding="utf-8"?>
<!-- 红果·合集详情页（批四卡 8 落点，官方 VideoAlbumDetailActivity 对位）：
     头部照 VideoAlbumHeaderLayout 字段位——封面＋标题＋副标题段
     （sub_title_list）＋作者行（头像/名/关注钮）＋简介；下方集列表
     （官方 IAlbumEpisodeListView 的 DETAIL 场景）。底色照详情页沉浸族
     （专辑主色 color_hex 回包带了由代码换底，没带用缺省深底）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF241D16">

    <ImageView
        android:id="@+id/hg_ab_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59241D16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="56dp"
        android:paddingEnd="16dp">

        <!-- 头行：封面小图＋标题＋副标题段（全N集·热度） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hg_ab_cover"
                android:layout_width="84dp"
                android:layout_height="124dp"
                android:background="@drawable/bg_hg_detail_cover"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hg_ab_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hg_ab_subline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 作者行（官方头部 UgcUserTagView 位）：头像＋名，整行进作者页；
             右端关注钮原地翻转（AlbumAuthorDelegate clickToggleFollow） -->
        <LinearLayout
            android:id="@+id/hg_ab_author_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hg_ab_author_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/hg_ab_author_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hg_ab_author_follow"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_hg_author_follow_btn"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="关注"
                android:textColor="#FFFA7705"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/hg_ab_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:lineSpacingExtra="6dp"
            android:maxLines="3"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="16dp"
            android:background="#14FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="合集"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hg_ab_ep_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hg_ab_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hg_ab_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
