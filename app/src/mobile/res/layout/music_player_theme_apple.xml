<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Music（gz-full-parity-1025 §3＋§13.1/13.2）：ApplePagerView 三页——0 信息（tpInfoContent 代码构建）
     ／1 播放（封面 weight→标题列上叠 −12→进度距上 8→运输行高 96 上叠 −18 恒生效 §15.1→音量行→功能行高 52 §13.2
     →底 22）／2 歌词（FullLyricView）。运输行内首 6dp 间隔 §13.2；进度/音量带 noPagerSwipe 不触发翻页。 -->
<com.fongmi.android.tv.ui.music.ApplePagerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tpPager"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 页 0：信息页 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/tpInfoContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp" />
    </ScrollView>

    <!-- 页 1：播放页 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tpCoverWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tpCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/tpCoverExit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 标题列：横垫 24dp、上叠 −12dp；歌名 20sp/26/30dp/0.96/800，歌手 14sp/0.60 距歌名 5dp，
             专辑独立第三行 12sp/0.42（空隐藏）；头右两键玻璃钮盒 34dp 图标 20dp、间距 8/12dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tpTitle"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:ellipsize="end"
                    android:fontWeight="800"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineHeight="26dp"
                    android:maxLines="1"
                    android:textColor="#F5FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp" />

                <TextView
                    android:id="@+id/tpArtist"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:ellipsize="end"
                    android:fontWeight="500"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="18dp"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tpAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:ellipsize="end"
                    android:fontWeight="500"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="16dp"
                    android:maxLines="1"
                    android:textColor="#6BFFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/tpAppleFav"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_glass_btn"
                android:contentDescription="@string/music_favorite"
                android:padding="7dp"
                android:src="@drawable/ic_music_heart"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnMenu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_player_glass_btn"
                android:contentDescription="@string/music_more"
                android:padding="7dp"
                android:src="@drawable/ic_music_more"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <com.fongmi.android.tv.ui.music.MusicScrubberView
            android:id="@+id/tpScrubber"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:tag="noPagerSwipe" />

        <!-- 运输行：行内首 6dp 间隔（§13.2）＋行 marginTop −18dp offset 恒生效（§15.1 第 9 项 d）；
             上/下一首盒 56dp 图标 48×42、播放盒 84dp 图标 60×52.5（padding 得）、键间 24dp -->
        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="-18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpBtnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/music_prev"
                android:paddingStart="4dp"
                android:paddingTop="7dp"
                android:paddingEnd="4dp"
                android:paddingBottom="7dp"
                android:src="@drawable/ic_music_prev"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpPlayTop"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginStart="24dp"
                android:contentDescription="@string/pl_play_pause"
                android:paddingStart="12dp"
                android:paddingTop="15.75dp"
                android:paddingEnd="12dp"
                android:paddingBottom="15.75dp"
                android:src="@drawable/ic_music_pause"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:contentDescription="@string/music_next"
                android:paddingStart="4dp"
                android:paddingTop="7dp"
                android:paddingEnd="4dp"
                android:paddingBottom="7dp"
                android:src="@drawable/ic_music_next"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 音量行：前 6dp／后 2dp；滑杆行高 32dp、轨 6dp（MusicVolumeSliderView） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <com.fongmi.android.tv.ui.music.MusicVolumeSliderView
            android:id="@+id/tpVolumeSlider"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:tag="noPagerSwipe" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- 功能行：高 52dp（§13.2）；歌词菜单 24／音质 24／队列 28、间距 48dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpBtnLyricMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.5"
                android:contentDescription="@string/music_lyric_settings"
                android:src="@drawable/ic_music_note"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnQualityFunc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="48dp"
                android:alpha="0.5"
                android:contentDescription="@string/music_quality"
                android:src="@drawable/ic_music_eq"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnQueue"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="48dp"
                android:alpha="0.5"
                android:contentDescription="@string/music_queue"
                android:src="@drawable/ic_music_queue"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="22dp" />
    </LinearLayout>

    <!-- 页 2：歌词页（横垫 28dp） -->
    <com.fongmi.android.tv.ui.music.FullLyricView
        android:id="@+id/tpAppleLyric"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />
</com.fongmi.android.tv.ui.music.ApplePagerView>
