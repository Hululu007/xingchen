<?xml version="1.0" encoding="utf-8"?>
<!-- 外置迅雷运行时包清单：无界面、无启动入口，只装代码与 .so 供宿主 DexClassLoader 载入。
     extractNativeLibs 显式开：库既留在 APK 内（RuntimeModule 以 "…!/lib/<abi>/*.so" 直载），
     也解到插件包的 nativeLibraryDir，双路都不依赖默认行为。
     FLAG_HAS_CODE 校验（verifyJavaRuntime）要求包内有 dex，application 默认 hasCode 为真。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:extractNativeLibs="true"
        android:hasCode="true" />
</manifest>
