<?xml version="1.0" encoding="utf-8"?>
<!-- Emby 首页分类面板：深色卡片，媒体库/合集勾选行，勾上才上首页 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/emby_cats_title"
        android:textColor="#F2F4F8"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/emby_cats_hint"
        android:textColor="#B9C1D0"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="380dp" />

    <TextView
        android:id="@+id/btn_done"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/xc_capsule_yellow"
        android:gravity="center"
        android:text="@string/emby_done"
        android:textColor="#1A1D24"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
