<?xml version="1.0" encoding="utf-8"?>
<!-- 楼层回复行：缩进到评论正文列下（左缩 46dp＝头像 36＋间距 10），小头像、
     正文带「回复 X：」前缀（代码里拼 span），右列点赞同评论行口径。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="46dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/hg_r_avatar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="头像" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hg_r_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF8A8A8A"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/hg_r_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#FF1F1F1F"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hg_r_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="#FFFFFFFF"
                android:paddingStart="4dp"
                android:text="… 展开"
                android:textColor="#FF3D7DD8"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/hg_r_collapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="收起"
            android:textColor="#FF3D7DD8"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hg_r_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9A9A9A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hg_r_reply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="回复"
                android:textColor="#FF9A9A9A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hg_r_like_box"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/hg_r_like_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="点赞" />

        <TextView
            android:id="@+id/hg_r_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FF8A8A8A"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
