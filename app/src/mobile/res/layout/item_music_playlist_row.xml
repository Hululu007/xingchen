<?xml version="1.0" encoding="utf-8"?>
<!-- GZ 歌单行：封面 50dp、名 14sp、第二行“N 首”11sp、右播放圆钮 34dp＋⋮；封面＝瓜子 CoverMosaic 口径（歌单内曲目封面拼块，1 张铺满、2 张以上 2×2、前 4 张；空歌单才回落彩色圆盘图标；字重未抠到，沿用星辰行粗体） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_music"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/coverBox"
        android:layout_width="50dp"
        android:layout_height="50dp">

        <GridLayout
            android:id="@+id/mosaicGrid"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:columnCount="2"
            android:rowCount="2"
            android:visibility="gone">

            <ImageView
                android:id="@+id/mosaic1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/mosaic2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/mosaic3"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/mosaic4"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop" />
        </GridLayout>

        <ImageView
            android:id="@+id/mosaicSingle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="13dp"
            android:src="@drawable/ic_music_queue"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1C1C1E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9AA7B8"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowPlay"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:src="@drawable/ic_music_play"
        android:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/rowMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_music_more" />
</LinearLayout>
