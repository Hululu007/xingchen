<?xml version="1.0" encoding="utf-8"?>
<!-- GZ 导入歌单大面板：圆角 24dp 内边距 22/26/22/18dp；纵向间距：平台行后 14dp、登录行后 8dp、LX 行后 12dp、导入钮前 20dp、钮与取消间 8dp。
     批 5 F2：面板底按全域液态玻璃口径换 bg_music_glass_panel（与批 4 面板族同件），原纯白底 bg_sheet_panel_home 在本面退场 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_music_glass_panel"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/ivCloud"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_import_cloud"
            android:padding="12dp"
            android:src="@drawable/ic_music_download"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/music_import_playlist"
            android:textColor="#1C1C1E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="5sp"
            android:text="支持各平台歌单链接或分享文案导入"
            android:textColor="#8E8E93"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/platformRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/platformRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/loginRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_music_note"
                android:tint="#FA243C" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录账号导入"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="网易云 / QQ音乐"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_music_chevron"
                android:tint="#8E8E93" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lxRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_inset_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_music_download"
                android:tint="#1C1C1E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="从洛雪(LX)歌单文件导入"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".lxmc"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_music_chevron"
                android:tint="#8E8E93" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPaste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_inset_row"
            android:gravity="top"
            android:hint="粘贴歌单链接或完整分享文案"
            android:inputType="textMultiLine"
            android:minHeight="96dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="#1C1C1E"
            android:textColorHint="#9A9AA0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9AA7B8"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_import_cloud"
            android:gravity="center"
            android:text="@string/music_import_action"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@android:string/cancel"
            android:textColor="#8E8E93"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
