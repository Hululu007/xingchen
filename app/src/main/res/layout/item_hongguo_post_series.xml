<?xml version="1.0" encoding="utf-8"?>
<!-- 红果·帖子页关联剧卡行：封面＋剧名＋集数，整行点进剧（集流）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_hg_author_series_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/hg_ps_cover"
        android:layout_width="48dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_hg_cover_r6"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hg_ps_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FF1D2129"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hg_ps_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF86909C"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
