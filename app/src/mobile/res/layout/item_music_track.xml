<?xml version="1.0" encoding="utf-8"?>
<!-- GZ 歌曲行（搜索／收藏／历史／下载／本地／歌单详情共用）：封面 50dp、名 14sp 行高 20sp、第二行 11sp、纵内边距 10dp、
     横内边距 14dp（第二波按任务要求 4→14dp；星辰页根左右边距 20dp，改后行内容有效离边 34dp，瓜子页边距未抠全，待真机核） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineHeight="20sp"
            android:maxLines="1"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 本地行路径行（批 5 F2／§11.2 各页差异）：仅本地音乐（device）模式且有本地路径时显示文件所在目录，
             其余模式恒 GONE 不占位；回收行在 bindTrack 里逐行定显隐 -->
        <TextView
            android:id="@+id/path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="#B2B2B2"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/badge_music"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#FA243C"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textColor="#9AA7B8"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/more"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/player_more"
        android:padding="12dp"
        android:src="@drawable/ic_music_more" />
</LinearLayout>
