<?xml version="1.0" encoding="utf-8"?>
<!-- Emby 栏目全量列表页：标题栏 + 下拉刷新 + 3 列海报网格 + 空态/错误态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_control_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#F2F4F8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_person"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_filter_glass_chip"
            android:text="@string/emby_filter_person"
            android:textColor="@color/selector_dialog_glass_chip_text"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 排序/筛选横栏：只在媒体库全量（view 模式）显示 -->
    <HorizontalScrollView
        android:id="@+id/sort_bar_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sort_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/btn_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_glass_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/emby_sort"
                android:textColor="@color/selector_dialog_glass_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_glass_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/emby_filter_state"
                android:textColor="@color/selector_dialog_glass_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_glass_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/emby_filter_year"
                android:textColor="@color/selector_dialog_glass_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_glass_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/emby_filter_rating"
                android:textColor="@color/selector_dialog_glass_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_filter_glass_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/emby_filter_tag"
                android:textColor="@color/selector_dialog_glass_chip_text"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 类型筛选 chips 横栏：只在媒体库全量（view 模式）显示 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingBottom="24dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#F0A400" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="48dp"
            android:text="@string/emby_empty_list"
            android:textColor="#8E97A8"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
