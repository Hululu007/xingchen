<?xml version="1.0" encoding="utf-8"?>
<!-- 流光 CD 主题（批 3 D 路，施工图 §4）：三 id 共用一套布局，表面 LIGHT/DARK/AUTO 由代码刷色。
     结构：取色渐变背景层（代码刷四段渐变）＋内容列（顶行 64／盘区权重／展开窗／摘要 78／进度 52／五图标 52／主控 80／底距代码设）。
     顶行构成照瓜子 LuminousCdPlayer 源码：左收起键＋居中标题列＋右播放工具键（任务简述的「左标题＋右键组」与源码不符，报告已注明待裁）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/tpCdBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 内容列：顶部状态栏留位由代码按 status_bar_height 设 paddingTop（顶行文字不许进状态栏区） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- 顶行 64dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpBtnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/music_collapse"
                android:padding="10.5dp"
                android:src="@drawable/ic_music_chevron_down" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tpTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tpArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/tpBtnTools"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/music_tools"
                android:padding="10.5dp"
                android:src="@drawable/ic_music_more" />
        </LinearLayout>

        <!-- 盘区（权重）＋展开窗叠层 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.fongmi.android.tv.ui.music.CdDiscView
                android:id="@+id/tpCdDisc"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/tpCdDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:visibility="gone">

                <com.fongmi.android.tv.ui.music.CdLyricWindowView
                    android:id="@+id/tpCdLyric"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="28dp" />

                <ScrollView
                    android:id="@+id/tpInfoScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/tpInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp" />
                </ScrollView>
            </FrameLayout>
        </FrameLayout>

        <!-- 盘下整列（展开时按 §4 淡出比公式压 alpha） -->
        <LinearLayout
            android:id="@+id/tpCdBelowCol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 摘要行 78dp、纵向偏移 −10dp、横垫 24dp -->
            <FrameLayout
                android:id="@+id/tpCdSummaryBox"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:translationY="-10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/tpCdSummaryMain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tpCdSummarySub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 进度区 52dp：时间行 34dp（偏移 −10dp、9sp）＋轨容器 10dp（轨 2dp 无拇指） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:translationY="-10dp">

                    <TextView
                        android:id="@+id/tpCdPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="9sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tpCdDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="9sp" />
                </LinearLayout>

                <com.fongmi.android.tv.ui.music.CdSeekBarView
                    android:id="@+id/tpCdSeek"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="8dp" />
            </LinearLayout>

            <!-- 五图标行 52dp：信息／音质／歌词版本／收藏／表面切换，图标 26dp、五格均分 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <ImageView
                    android:id="@+id/tpCdBtnInfo"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_song_info"
                    android:paddingVertical="13dp"
                    android:src="@drawable/ic_music_info" />

                <ImageView
                    android:id="@+id/tpCdBtnQuality"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_quality"
                    android:paddingVertical="13dp"
                    android:src="@drawable/ic_music_eq" />

                <ImageView
                    android:id="@+id/tpCdBtnLyricVer"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_lyric_version"
                    android:paddingVertical="13dp"
                    android:src="@drawable/ic_music_note" />

                <ImageView
                    android:id="@+id/tpCdBtnFav"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_favorite"
                    android:paddingVertical="13dp"
                    android:src="@drawable/ic_music_heart" />

                <ImageView
                    android:id="@+id/tpCdBtnSurface"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/music_cd_surface"
                    android:paddingVertical="13dp"
                    android:src="@drawable/ic_music_palette" />
            </LinearLayout>

            <!-- 主控行 80dp、偏移 −10dp：模式／上一首／播放（盒 68、图标 54/58 代码切）／下一首／队列 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:translationY="-10dp">

                <ImageView
                    android:id="@+id/tpCdBtnMode"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/music_mode"
                    android:padding="10.5dp"
                    android:src="@drawable/ic_music_sequential" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/tpCdBtnPrev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/music_prev"
                    android:padding="6dp"
                    android:src="@drawable/ic_music_prev" />

                <ImageView
                    android:id="@+id/tpCdPlay"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/music_play_pause"
                    android:padding="7dp"
                    android:src="@drawable/ic_music_pause" />

                <ImageView
                    android:id="@+id/tpCdBtnNext"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/music_next"
                    android:padding="6dp"
                    android:src="@drawable/ic_music_next" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/tpCdBtnQueue"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/music_queue"
                    android:padding="10.5dp"
                    android:src="@drawable/ic_music_queue" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底距：代码设 max(16dp, 安全区) -->
        <View
            android:id="@+id/tpCdBottomPad"
            android:layout_width="match_parent"
            android:layout_height="16dp" />
    </LinearLayout>
</FrameLayout>
