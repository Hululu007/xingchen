<?xml version="1.0" encoding="utf-8"?>
<!-- 刷剧页单元：一集一页。布局求平：视频面挂载口＋封面＋右列＋底部信息＋本剧条＋细进度线。
     视频面（PlayerView）由 Activity 全局一份，settle 后移进当前页的 hg_surface_host。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hg_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/hg_surface_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/hg_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hg_bottom_scrim" />

    <TextView
        android:id="@+id/hg_fullscreen_watch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="130dp"
        android:background="@drawable/bg_hg_chip"
        android:drawableStart="@drawable/ic_hg_fullscreen"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="全屏观看"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hg_right_rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="110dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/hg_avatar_box"
            android:layout_width="48dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/hg_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="top|center_horizontal"
                android:contentDescription="作者头像" />

            <TextView
                android:id="@+id/hg_avatar_initial"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_hg_avatar_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_follow_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_hg_follow_badge"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/hg_act_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="收藏"
                android:src="@drawable/ic_hg_star" />

            <TextView
                android:id="@+id/hg_fav_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="评论"
                android:src="@drawable/ic_hg_comment" />

            <TextView
                android:id="@+id/hg_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="点赞"
                android:src="@drawable/ic_hg_heart" />

            <TextView
                android:id="@+id/hg_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="分享"
                android:src="@drawable/ic_hg_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="分享"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hg_danmaku"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="158dp"
        android:background="@drawable/bg_hg_chip"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="弹"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/hg_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="44dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hg_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hg_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hg_desc_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="展开"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hg_series_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hg_series_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hg_play" />

        <TextView
            android:id="@+id/hg_series_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="#33FFFFFF">

        <View
            android:id="@+id/hg_progress_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
    </FrameLayout>

    <ImageView
        android:id="@+id/hg_pause_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:src="@drawable/ic_hg_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hg_chip"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="加载失败，点按重试"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
