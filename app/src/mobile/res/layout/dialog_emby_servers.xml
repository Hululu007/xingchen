<?xml version="1.0" encoding="utf-8"?>
<!-- Emby 切服弹窗：深色卡片，已加服列表＋服务器管理入口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/emby_switch_server"
        android:textColor="#F2F4F8"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="380dp" />

    <TextView
        android:id="@+id/btn_manage"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/xc_capsule_glass"
        android:gravity="center"
        android:text="@string/emby_server_manage"
        android:textColor="#EDEFF3"
        android:textSize="14sp" />
</LinearLayout>
