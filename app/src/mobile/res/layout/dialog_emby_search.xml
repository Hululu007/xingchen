<?xml version="1.0" encoding="utf-8"?>
<!-- Emby 首页搜索弹窗：只搜当前服，走 EmbyApi.search 现有链 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_key"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_dark"
            android:hint="@string/emby_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="#EDEFF3"
            android:textColorHint="#B9C1D0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_go"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/xc_capsule_yellow"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/emby_search"
            android:textColor="#1A1D24"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="420dp" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/emby_search_empty"
        android:textColor="#B9C1D0"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
