<?xml version="1.0" encoding="utf-8"?>
<!-- 经典主题（GZ PlayerScreenKt 经典分支 :22309-22575 装配转写）：
     封面 → SongMeta（歌名/歌手/专辑＋收藏小爱心＋右侧三键 40dp）→ 内嵌封面歌词（横向内边距 28dp）
     → 间隔 6dp → PlaybackScrubber（音质筹/歌词筹＋细进度，横向内边距 28dp）→ 底部间隔 45dp。
     经典主题无上一首/下一首键：切歌靠封面横滑（代码侧手势）；播放/暂停在 SongMeta 三键内。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- 封面区：手势在代码侧挂 tpCoverWrap（双击收藏/长按工具面板/横滑切歌/单击开全屏歌词页） -->
    <FrameLayout
        android:id="@+id/tpCoverWrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.4"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/tpCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="12dp"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- SongMeta：外层横向内边距 28dp；歌名 18sp/行高 24sp/字距 -0.4、歌手 14sp/18sp、专辑行高 22dp；
         歌名行内收藏小爱心 13dp（padding 7dp，已收藏才显示）；右侧三键点击区 40dp 见方，与标题间距 8dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.022"
                    android:lineHeight="24dp"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/tpFavHeart"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:contentDescription="@string/music_favorite"
                    android:padding="7dp"
                    android:src="@drawable/ic_music_heart_fill"
                    android:tint="#FA243C"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tpArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineHeight="18dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tpAlbum"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:lineHeight="18dp"
                android:maxLines="1"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpBtnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_more"
                android:padding="9.5dp"
                android:src="@drawable/ic_music_more"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnQueueTitle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_queue"
                android:padding="10dp"
                android:src="@drawable/ic_music_queue"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpPlayTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/pl_play_pause"
                android:padding="7.5dp"
                android:src="@drawable/ic_music_play"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 内嵌封面歌词：横向内边距 28dp、weight 占余下高度（组件 cover 模式，窗口 4 行）；点行开全屏歌词页 -->
    <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
        android:id="@+id/tpLyricView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="3"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />

    <!-- PlaybackScrubber：与歌词区间隔 6dp、横向内边距 28dp；
         音质筹（实测值，取不到整筹隐藏）＋歌词筹一行在进度之上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tpChipQuality"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_player_chip"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tpQualityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/tpChipLyric"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_player_chip"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/music_tab_lyric"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 进度：轨道上方间隔 4dp、容器高 28dp、轨道基高 4dp；时间标签 11sp/字距 0.2/宽 40dp -->
        <SeekBar
            android:id="@+id/tpSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/bg_player_seek_progress"
            android:thumb="@drawable/bg_player_seek_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tpPosition"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.018"
                android:text="00:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tpDuration"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.018"
                android:text="00:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部间隔 45dp（GZ 经典分支末尾 Spacer） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="45dp" />
</LinearLayout>
