<?xml version="1.0" encoding="utf-8"?>
<!-- 第 7 项尾巴＋第二波：下载进行中任务行（名 14sp、状态 11sp、进度条、34dp 圆钮：瓜子 DownloadsScreen 进行中行圆钮 34dp 图标 20dp，
     暂停态播放图标「继续下载」／等待·下载中暂停图标「暂停下载」／取消关闭图标「取消下载」；按压 0.9 星辰侧无现成 helper，未实现，见交卷） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9AA7B8"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressTint="#FA243C" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnPause"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_light"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:tint="#8E8E93" />

    <ImageView
        android:id="@+id/btnCancel"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_light"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:tint="#8E8E93" />
</LinearLayout>
