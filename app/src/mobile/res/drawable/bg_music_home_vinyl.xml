<?xml version="1.0" encoding="utf-8"?>
<!-- 首页标题行右上角黑胶唱片装饰（批 5 F2／第十稿）：黑盘＋沟槽环＋粉色心标，斜探出画面靠布局负边距与旋转实现 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF17171C" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="21dp"
        android:left="21dp"
        android:right="21dp"
        android:top="21dp">
        <shape android:shape="oval">
            <solid android:color="#FFFF5C8A" />
        </shape>
    </item>
    <item
        android:bottom="26dp"
        android:left="26dp"
        android:right="26dp"
        android:top="26dp">
        <shape android:shape="oval">
            <solid android:color="#FFFAFAFC" />
        </shape>
    </item>
</layer-list>
