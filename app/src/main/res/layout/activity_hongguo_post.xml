<?xml version="1.0" encoding="utf-8"?>
<!-- 红果·帖子详情页（作者页动态帖子的去处，2026-10-29 落地）：帖子料
     全在作品列表回包里自带（common.content 正文全文＋materials 图集与
     关联剧、stat 计数），进页不另拉正文。构成＝作者行＋标题＋正文＋
     图集＋关联剧卡（点进剧）＋计数行；评论区与点赞/收藏动作的接口
     未验通、不摆假件（见汇总账）。白底深字与作者页同族；不放页面
     自带返回箭头（走系统返回）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <!-- 作者行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hg_post_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hg_post_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF1D2129"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hg_post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FF86909C"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hg_post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="#FF1D2129"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hg_post_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#FF3C424B"
            android:textSize="15sp" />

        <!-- 图集（代码按 materials 顺序逐张加） -->
        <LinearLayout
            android:id="@+id/hg_post_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 关联剧（代码按详情回包逐张加卡） -->
        <LinearLayout
            android:id="@+id/hg_post_series"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- 计数行（只展示：点赞/收藏/评论动作口未验通，不摆假按钮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hg_post_digg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_hg_author_heart"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="#FF86909C"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hg_post_collect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:drawableStart="@drawable/ic_hg_author_collect"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="#FF86909C"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hg_post_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:drawableStart="@drawable/ic_hg_author_comment"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="#FF86909C"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
