<?xml version="1.0" encoding="utf-8"?>
<!-- 随心听：瓜子三段渐变基色（HomeScreenKt:2579，i7==2 分支；GZ 还会与每日歌曲封面取色混合，
     星辰侧取色源＝首页榜单首首封面，见 MusicActivity.applyShuffleTone，混后无固定值）、圆角 20dp、对角线左上→右下 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="315"
        android:startColor="#B8EFF9"
        android:centerColor="#BCEEDD"
        android:endColor="#E8FAA8"
        android:type="linear" />
</shape>
