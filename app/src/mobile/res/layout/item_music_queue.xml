<?xml version="1.0" encoding="utf-8"?>
<!-- 队列行（GZ PlayQueueSheet QueueItem 证据 redo2-gz-queue-evidence §4）：
     行高 56dp；[序号 %02d 宽 22dp/11sp] [封面 36dp 圆角 8dp] [歌名 13sp/700/行高 16 · 歌手 11sp/行高 14，空歌手兜底「未知歌手」]
     [三钮常显 30dp/图标 18dp/间隔 2dp：收藏（已收藏实心红、未收藏线框灰）/加歌单/移除（垃圾桶）]；
     无时长、无播放指示、无拖动手柄——长按整行拖动排序；当前行歌名红、歌手红 0.72、序号红 0.7；被拖行白底圆角 12（代码侧）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/index"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:textColor="#9A9AA0"
        android:textSize="11sp"
        android:fontWeight="500" />

    <ImageView
        android:id="@+id/cover"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineHeight="16sp"
            android:maxLines="1"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lineHeight="14sp"
            android:maxLines="1"
            android:textColor="#9A9AA0"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnFav"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/music_favorite"
        android:padding="6dp"
        android:src="@drawable/ic_music_heart" />

    <ImageView
        android:id="@+id/btnAdd"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/music_add_to_playlist"
        android:padding="6dp"
        android:src="@drawable/ic_music_playlist_add" />

    <ImageView
        android:id="@+id/btnRemove"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/music_remove"
        android:padding="6dp"
        android:src="@drawable/ic_music_delete" />
</LinearLayout>
