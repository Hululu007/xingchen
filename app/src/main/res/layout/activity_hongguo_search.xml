<?xml version="1.0" encoding="utf-8"?>
<!-- 红果搜索面：整页形态照官方 SearchActivity/AbsSearchFragment 对齐（2026-10-28）：
     页面底＝白（官方应用主题 windowBackground 白、auy 根无自有底）；搜索栏照
     cqh＋c8m 原值（框高 36dp、底 #08000000 圆角 8dp、内嵌 12dp 搜索图标、
     字 14sp 黑、占位 #4D000000、右「搜索」16sp 黑）；官方栏左端的返回图标
     按潇洒哥铁律（页面不放自带返回箭头）不落，走系统返回。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/hg_search_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1">

            <EditText
                android:id="@+id/hg_search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hg_search_input"
                android:hint="搜索短剧"
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="36dp"
                android:paddingEnd="32dp"
                android:textColor="#FF000000"
                android:textColorHint="#4D000000"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_search_find" />

            <ImageView
                android:id="@+id/hg_search_clear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="清空"
                android:src="@drawable/ic_hg_search_clear"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/hg_search_go"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="搜索"
            android:textColor="#FF000000"
            android:textSize="16sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hg_search_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/hg_search_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:textColor="#66000000"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hg_search_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
