<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Music apple_music（批 3，照施工图 §2 全表）：3 页横滑 pager（ApplePagerView）——
     第 0 页歌曲信息（SongInfoPage 口径，内容代码构建）／第 1 页播放页（进页默认停此页）／第 2 页歌词页
     （复用批 2 FullLyricView 本体：横垫 28、行距 6、顶渐隐 40、字号 24、行高 ×1.3；不带全屏页歌名三键头行）。
     播放页：封面 fillMaxSize 占 weight 余高（圆角按 §19-8 以 0 落）→ 标题列（上叠 −12）→ 进度（距上 8）→
     运输行（上叠 −18、高 96）→ 音量行（只有滑杆）→ 功能行 → 底 Spacer 22。 -->
<com.fongmi.android.tv.ui.music.ApplePagerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tpPager"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 第 0 页：歌曲信息（HeroCard＋来源／技术规格·实时／歌词三 GlassSection，代码构建） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/tpInfoContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp" />
    </ScrollView>

    <!-- 第 1 页：播放页 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tpCoverWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tpCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- 出场封面层：切歌转场 AppleMusic 出场（缩放→1.03＋alpha→0），平时 gone -->
            <ImageView
                android:id="@+id/tpCoverExit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 熔边层：封面下沿 84dp 渐隐进整页糊底（代码按氛围色刷渐变），与经典同口径 -->
            <View
                android:id="@+id/tpCoverMelt"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_gravity="bottom"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- 标题列：横垫 24dp、相对封面下沿上叠 −12dp；右两键玻璃钮盒 34dp 图标 20dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tpTitle"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:ellipsize="end"
                    android:fontWeight="800"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineHeight="26dp"
                    android:maxLines="1"
                    android:textColor="#F5FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp" />

                <TextView
                    android:id="@+id/tpArtist"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:ellipsize="end"
                    android:fontWeight="500"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="18dp"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tpAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:ellipsize="end"
                    android:fontWeight="500"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="16dp"
                    android:maxLines="1"
                    android:textColor="#6BFFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/tpAppleFav"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:alpha="0.85"
                android:background="@drawable/bg_player_glass_btn"
                android:contentDescription="@string/music_favorite"
                android:padding="7dp"
                android:src="@drawable/ic_music_heart"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnMenu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="12dp"
                android:alpha="0.85"
                android:background="@drawable/bg_player_glass_btn"
                android:contentDescription="@string/music_more"
                android:padding="7dp"
                android:src="@drawable/ic_music_more"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 进度：横垫 24dp、距标题列 Spacer 8dp；轨 6dp（拖动 7dp）变体由代码设 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <com.fongmi.android.tv.ui.music.MusicScrubberView
            android:id="@+id/tpScrubber"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:tag="noPagerSwipe" />

        <!-- 运输行：上叠 −18dp、高 96dp、键间 24dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="-18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpBtnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/music_prev"
                android:paddingStart="4dp"
                android:paddingTop="7dp"
                android:paddingEnd="4dp"
                android:paddingBottom="7dp"
                android:src="@drawable/ic_music_prev"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpPlayTop"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginStart="24dp"
                android:contentDescription="@string/pl_play_pause"
                android:paddingStart="12dp"
                android:paddingTop="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp"
                android:src="@drawable/ic_music_pause"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:contentDescription="@string/music_next"
                android:paddingStart="4dp"
                android:paddingTop="7dp"
                android:paddingEnd="4dp"
                android:paddingBottom="7dp"
                android:src="@drawable/ic_music_next"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 音量行：只有滑杆（前隔 6、后隔 2）；行高 32dp、轨 6dp -->
        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <com.fongmi.android.tv.ui.music.MusicVolumeSliderView
            android:id="@+id/tpVolumeSlider"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:tag="noPagerSwipe" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- 功能行：间距 48dp；歌词菜单 24／音质 24／播放列表 28（第一键是歌词菜单，不是进歌词页） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpBtnLyricMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.5"
                android:contentDescription="@string/music_lyric_settings"
                android:src="@drawable/ic_music_note"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnQualityFunc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="48dp"
                android:alpha="0.5"
                android:contentDescription="@string/music_quality"
                android:src="@drawable/ic_music_eq"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/tpBtnQueue"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="48dp"
                android:alpha="0.5"
                android:contentDescription="@string/music_queue"
                android:src="@drawable/ic_music_queue"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="22dp" />
    </LinearLayout>

    <!-- 第 2 页：歌词页（FullLyricView 本体，横垫 28dp；无歌名三键头行） -->
    <com.fongmi.android.tv.ui.music.FullLyricView
        android:id="@+id/tpAppleLyric"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />
</com.fongmi.android.tv.ui.music.ApplePagerView>
