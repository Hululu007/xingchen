<?xml version="1.0" encoding="utf-8"?>
<!--
     音乐搜索独立页（2026-10-25 用户定案重做）：构成只有——
     标题「搜索」＋搜索框行（玻璃胶囊＋取消）＋分类页签（单曲／专辑／歌手／歌单）
     ＋源横排 chips（各源分开、点哪个看哪个源的结果）＋结果列表＋状态层（加载／空态）。
     工具行（随机／播放全部／来源下拉／排序）、组筛选条、落地页（最近／热门／猜你想搜）全摘。
     组织摆法照用户参照图（2026-10-20 定「搜索结果按源横排」）；皮走液态玻璃：
     根底 home_bg_page 兜底＋MusicGlassBackgroundView 铺满（与首页同一套背景），
     玻璃件用全 App 共用 bg_music_glass_* 一套。
     无返回箭头（铁律），关页走系统返回／搜索框行「取消」；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/music_search"
                android:textColor="#1C1C1E"
                android:textSize="26sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_music_glass_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_search"
                    android:tint="#8E8E93" />

                <EditText
                    android:id="@+id/etKeyword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/music_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#1C1C1E"
                    android:textColorHint="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/searchCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:text="@string/music_search_cancel"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 分类页签：单曲／专辑／歌手／歌单（构成与次序照参照图），四等分横排，子项由代码 inflate item_music_search_tab -->
        <LinearLayout
            android:id="@+id/tabRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- 源横排 chips：chips 是本 App 自己的可搜源，点哪个看哪个源的结果 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sourceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- 状态层（空状态与「正在加载…」共用）：根 FrameLayout 覆盖层、layout_gravity 居中锚定，不随键盘挤位 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA7B8"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
