<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/music_setting"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 1. 播放音质 -->
        <LinearLayout
            android:id="@+id/rowPlayQuality"
            style="@style/MusicSettingRow">

            <TextView
                style="@style/MusicSettingName"
                android:text="@string/music_set_play_quality" />

            <TextView
                android:id="@+id/tvPlayQuality"
                style="@style/MusicSettingValue" />
        </LinearLayout>

        <!-- U4 行间分隔线：0 间距＋0.5dp 线，左缩进 0、右缩进 16dp（深色页用白 0.06 对应浅色页黑 0.06） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginEnd="16dp"
            android:background="#0FFFFFFF" />

        <!-- 2. 播放失败自动跳下一首 -->
        <LinearLayout
            android:id="@+id/rowAutoSkip"
            style="@style/MusicSettingRow">

            <TextView
                style="@style/MusicSettingName"
                android:text="@string/music_set_auto_skip" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAutoSkip"
                style="@style/MusicSettingSwitch" />
        </LinearLayout>

        <!-- U4 行间分隔线：0 间距＋0.5dp 线，左缩进 0、右缩进 16dp（深色页用白 0.06 对应浅色页黑 0.06） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginEnd="16dp"
            android:background="#0FFFFFFF" />

        <!-- 3. 移动网络播放 -->
        <LinearLayout
            android:id="@+id/rowMobilePlay"
            style="@style/MusicSettingRow">

            <TextView
                style="@style/MusicSettingName"
                android:text="@string/music_set_mobile_play" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swMobilePlay"
                style="@style/MusicSettingSwitch" />
        </LinearLayout>

        <!-- U4 行间分隔线：0 间距＋0.5dp 线，左缩进 0、右缩进 16dp（深色页用白 0.06 对应浅色页黑 0.06） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginEnd="16dp"
            android:background="#0FFFFFFF" />

        <!-- 4. 下载音质 -->
        <LinearLayout
            android:id="@+id/rowDlQuality"
            style="@style/MusicSettingRow">

            <TextView
                style="@style/MusicSettingName"
                android:text="@string/music_set_download_quality" />

            <TextView
                android:id="@+id/tvDlQuality"
                style="@style/MusicSettingValue" />
        </LinearLayout>

        <!-- U4 行间分隔线：0 间距＋0.5dp 线，左缩进 0、右缩进 16dp（深色页用白 0.06 对应浅色页黑 0.06） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginEnd="16dp"
            android:background="#0FFFFFFF" />

        <!-- 5. 歌词缺失自动搜索 -->
        <LinearLayout
            android:id="@+id/rowLyricFallback"
            style="@style/MusicSettingRow">

            <TextView
                style="@style/MusicSettingName"
                android:text="@string/music_set_lyric_fallback" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swLyricFallback"
                style="@style/MusicSettingSwitch" />
        </LinearLayout>

        <!-- U4 行间分隔线：0 间距＋0.5dp 线，左缩进 0、右缩进 16dp（深色页用白 0.06 对应浅色页黑 0.06） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginEnd="16dp"
            android:background="#0FFFFFFF" />

        <!-- U-05 歌词时间偏移（瓜子 LocalLyricOffsetMs，默认 0ms；行样式同 U4 设置行） -->
        <LinearLayout
            android:id="@+id/rowLyricOffset"
            style="@style/MusicSettingRow">

            <TextView
                style="@style/MusicSettingName"
                android:text="歌词时间偏移" />

            <TextView
                android:id="@+id/tvLyricOffset"
                style="@style/MusicSettingValue" />
        </LinearLayout>

        <!-- U4 行间分隔线：0 间距＋0.5dp 线，左缩进 0、右缩进 16dp（深色页用白 0.06 对应浅色页黑 0.06） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginEnd="16dp"
            android:background="#0FFFFFFF" />

        <!-- 6. 清除音乐缓存 -->
        <LinearLayout
            android:id="@+id/rowClearCache"
            style="@style/MusicSettingRow">

            <TextView
                style="@style/MusicSettingName"
                android:text="@string/music_set_clear_cache" />

            <TextView
                android:id="@+id/tvCacheSize"
                style="@style/MusicSettingValue"
                android:textColor="#FF8E8E93" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
