<?xml version="1.0" encoding="utf-8"?>
<!-- 刷剧页单元：一集一页。布局求平：视频面挂载口＋封面＋右列＋底部信息＋本剧条＋细进度线。
     视频面（PlayerView）由 Activity 全局一份，settle 后移进当前页的 hg_surface_host。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hg_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/hg_surface_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 封面与视频同口径：按自身比例完整放、在页面区内居中，不裁切。
         XML 的 fitCenter 只管未加载/素图态；远程图实际由
         HgFeedAdapter.bindCover 统一以 FIT_CENTER 加载（ImgUtil 会覆写
         ImageView 的 scaleType，只改这里曾被竖条目的 CENTER_CROP 盖掉，
         113624 真机点名）。页根底为黑，留黑即黑边 -->
    <ImageView
        android:id="@+id/hg_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <View
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hg_bottom_scrim" />

    <TextView
        android:id="@+id/hg_fullscreen_watch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hg_chip"
        android:drawableStart="@drawable/ic_hg_fullscreen"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="全屏观看"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 右列（官方真值：容器 paddingEnd 4dp/paddingTop 7dp、头像 41.5dp、订阅角标 22dp、
         动作间距 12dp、单件高 40dp/图标 32dp/计数在图标下方居中、点赞槽宽 46dp；
         序位照 undecided-dig 的 cv5 动作序（Series 家族）：头像→收藏→评论→点赞→分享；
         分享件 SeriesShareView 在官方缺省 gone（显隐条件未抠到），与官方实拍/
         录屏右列四件（头像/星/评论/心）一致——咱家同置 gone 保留组件不常显；
         分享件无计数时图标下显「分享」二字＝官方 SeriesShareView 的
         getShareCountText 缺省文案，图标 ic_hg_share 为自绘同形（已登记 strip 清单）） -->
    <LinearLayout
        android:id="@+id/hg_right_rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="58dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="7dp">

        <FrameLayout
            android:id="@+id/hg_avatar_box"
            android:layout_width="41.5dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/hg_avatar"
                android:layout_width="41.5dp"
                android:layout_height="41.5dp"
                android:layout_gravity="top|center_horizontal"
                android:contentDescription="作者头像" />

            <TextView
                android:id="@+id/hg_avatar_initial"
                android:layout_width="41.5dp"
                android:layout_height="41.5dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_hg_avatar_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/hg_follow_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_hg_follow_badge"
                android:contentDescription="关注作者"
                android:padding="5dp"
                android:src="@drawable/ic_hg_follow_plus" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/hg_act_fav"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="收藏"
                android:src="@drawable/ic_hg_star" />

            <TextView
                android:id="@+id/hg_fav_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_comment"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="评论"
                android:src="@drawable/ic_hg_comment" />

            <TextView
                android:id="@+id/hg_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_like"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="点赞"
                android:src="@drawable/ic_hg_heart" />

            <TextView
                android:id="@+id/hg_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_share"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="分享"
                android:src="@drawable/ic_hg_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="分享"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hg_danmaku_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="158dp">

        <TextView
            android:id="@+id/hg_danmaku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hg_chip"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="弹"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- 关态斜杠（集流页官方实拍 113558：弹幕关时「弹」带斜杠常显，
             与官方弹幕关图标的三态画法同义；只集流模式用） -->
        <View
            android:id="@+id/hg_danmaku_slash"
            android:layout_width="30dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="#FFFFFF"
            android:rotation="-45"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hg_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="50dp"
        android:orientation="vertical">

        <!-- 榜单徽章条（官方上榜形态，实拍 113598：奖杯图标＋「喜剧·
             真人剧榜 No.4」＋尾箭头，整条橙青渐变——渐变色由回包
             rec_reason_style 下发、绑定时程序化生成；没上榜整条藏） -->
        <LinearLayout
            android:id="@+id/hg_rank_strip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hg_rank_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/hg_rank_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="›"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 返回指定集引导筹（官方 ctm 定版：高 24dp、底 #33FFFFFF 圆角
             8dp、图标 16dp、文案 12sp 白、尾箭头 10dp）：本剧有断点且断点
             集不在第一集时才出（官方触发链定版），文案串「从第1集开始看」，
             点它回第一集从头播；只集流模式出 -->
        <LinearLayout
            android:id="@+id/hg_guide_chip"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hg_guide_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="从第1集开始看"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_catalog_arrow" />
        </LinearLayout>

        <TextView
            android:id="@+id/hg_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 集流作者行（官方 InfoPanel 作者行 cuc 定版）：头像 30dp 圆形＋
             作者名 16sp 粗＋箭头 8×16＋关注钮（底白 solid 圆角 4dp、文案
             「关注」10sp 粗橘 #FFFA7705、内距 H4/V3；未关注且有作者 uid
             才亮，已关注/无 uid 不亮——与官方 fox 缺省 gone 同向）。
             只集流模式出；流页走上面的 hg_author 纯文本行（流页实拍同此） -->
        <LinearLayout
            android:id="@+id/hg_author_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hg_info_avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_detail_arrow" />

            <TextView
                android:id="@+id/hg_follow_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hg_follow_mini"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3dp"
                android:text="关注"
                android:textColor="#FFFA7705"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 系列剧款（账 §5/§3）：多季系列条目的另一副样子，默认藏；
             胶囊条＝系列剧入口（与剧条/左滑同去处），角标＋剧名、标签筹一排在其下 -->
        <LinearLayout
            android:id="@+id/hg_series_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/hg_album_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hg_play" />

                <TextView
                    android:id="@+id/hg_album_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="›"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_series_title_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hg_badge_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hg_badge"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hg_series_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tags_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 流页剧名行（官方流页信息摞常设行，官方实拍 113476：剧名粗字
             ＋「›」在标签行之上、简介之上）：正剧短片（有剧归属、无作者名）
             才出，作者帖走 @作者行形态（官方实拍 113482）。旧版流页没有
             这行、正剧条目只剩简介一行（113579 真机点名）。点它进剧详情 -->
        <LinearLayout
            android:id="@+id/hg_feed_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/hg_feed_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="›"
                android:textColor="#CCFFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- 集流标题行（官方 InfoPanel 标题位）：角标筹＋剧名 20sp 粗。
             只集流非专辑款出（专辑款用系列剧款内的标题行）；此前集流
             普通款摞里没有标题行、是缺件。点它开选集单（与选集条同去处） -->
        <LinearLayout
            android:id="@+id/hg_ep_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/hg_ep_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hg_badge"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_ep_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 标签筹行（官方 InfoPanel 摞内常设行 hrq：数据有才出筹）：
             此前只有系列剧款里有、普通款有标签也不显——本行给非专辑款用，
             填充逻辑与系列款共用一份 -->
        <LinearLayout
            android:id="@+id/hg_tags_row_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- 热评/主演说行（账 §3.4）：数据有才显，长文带「展开」 -->
        <LinearLayout
            android:id="@+id/hg_hot_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/hg_hot_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hg_hot_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="展开"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 简介行（官方形态：简介单行＋「展开」同行右侧，实拍
             113476/113592；旧版展开独占一行、简介两行，与官方摞形不符） -->
        <LinearLayout
            android:id="@+id/hg_desc_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hg_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hg_desc_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="展开"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 次级信息行（官方 InfoHeader 的 recommendReason）：数据一直在
             条目里（recText）但此前从未绑上屏——本批补行。官方承载布局
             未定位，字号/颜色为自定小字（账里标明待核），数据有才显 -->
        <TextView
            android:id="@+id/hg_rec_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 作者声明（账 §3.5）：数据有才显，没有不编 -->
        <TextView
            android:id="@+id/hg_statement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 未上线剧预约卡（官方 SubscribeViewController 的 cu6 定版形态：
             封面 32×44 圆角 6dp＋标题 14sp 白粗＋副行（上线文案）＋右侧
             48dp 品牌钮；状态色对——未预约底 #FFFA7705 字白、已预约底
             #1AFFFFFF 字 #66FFFFFF。回包带 appointment 才亮，整卡点击
             走预约开关。此前只有一行文字筹、是形态缺件）
             注：本卡只在发现流出；集流页的预约已随追更一起收进下方剧条
             （hg_drama_bar 同槽药丸，见该件注释），集流绑定恒藏本卡 -->
        <LinearLayout
            android:id="@+id/hg_reserve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hg_reserve_cover"
                android:layout_width="32dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_hg_cover_r6"
                android:clipToOutline="true"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hg_reserve_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hg_reserve_due"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hg_reserve_btn"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_hg_reserve_btn"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="预约"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 剧条（集流专款，官方单剧播放页实拍 113630 定版排布）：信息摞
         之下、选集条之上的一整行——封面 24×32 圆角 4dp＋剧名 16sp
         白粗＋副行 12sp（更新至N集／未上线剧的上线文案）＋右端品牌
         药丸（追更与预约同槽互斥：已上线剧＝追更、未上线剧＝
         预约；两态色对走 ks3、形状全圆药丸）。封面/剧名数值出处＝
         官方剧条本体 k4q（布局 dwd／cuc 同值，2026-10-30 抠实，账
         hongguo-rework-p1b-dramabar）。旧版把追更/预约做成
         信息摞内 54dp 大卡：卡底与选集条只隔 2dp、进度线横穿卡面、
         剧名与集数在摞内重复出现——底部全叠（他 113630 对照点名），
         本批整卡废除、动作收进本条。只集流模式亮（正剧条目），发现
         流恒藏（流页追剧走右列星钮、无药丸，官方核查账定版） -->
    <LinearLayout
        android:id="@+id/hg_drama_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hg_drama_cover"
            android:layout_width="24dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_hg_cover_r4"
            android:clipToOutline="true"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hg_drama_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hg_drama_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 品牌药丸（官方 FollowUpdateLottieView 布局 cjw 定版：
             横排、总高 32dp＝铃铛 e63（图框 24 宽含左内距 8、字形
             16×16）＋文案 12sp（文案左距图框 2、容器右内距 10）；
             咱家构成同形：铃铛 ic_hg_bell 16dp＋文字 hg_drama_act
             _text 12sp、容器高 32dp、左内距 8/右内距 10。底图两态
             由适配器按镜像态换：未追 bg_hg_follow_pill（品牌橘
             全圆）、已追 bg_hg_follow_pill_on（透明白全圆）。
             显隐：整条的闸在适配器（集流+正剧型+有 series_id）；
             药丸自身再吃一条官方否定支——完结漫剧不显（见
             HgFeedItem.dramaPillVisible），预约态恒显。
             动画层（官方 cjw 同构）：光晕板 hg_drama_act_plate
             （oy 同源图、fitXY 铺满、缺省藏）＋铃位 Lottie
             hg_drama_act_anim（32×32 覆铃框、缺省藏），一次性
             入场动画的触发/复位全在 HgPillEntrance。 -->
        <FrameLayout
            android:id="@+id/hg_drama_act"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_hg_follow_pill">

            <ImageView
                android:id="@+id/hg_drama_act_plate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_hg_pill_glow"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/hg_drama_bell"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hg_bell" />

                <TextView
                    android:id="@+id/hg_drama_act_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="追更"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/hg_drama_act_anim"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:visibility="gone"
                app:lottie_autoPlay="false"
                app:lottie_fileName="hongguo/follow_update_entrance_v721.json"
                app:lottie_loop="false" />
        </FrameLayout>
    </LinearLayout>

    <!-- 底部行：选集条＋全屏方钮。材料/几何按模式分工（适配器 bind 时切换，
         本布局缺省值＝集流形态）：集流＝官方 CatalogView 材料（cto/ctp 定版：
         条高 40dp、底 #1AFFFFFF 圆角 8dp、文案 14sp 粗起点 16dp、尾箭头图
         20×10、文案＝前缀＋状态段不带剧名——官方实拍 113558 证）；行侧距
         12dp/底距 8dp 照实拍。流页＝全宽深底 strip＋播放图标＋「›」（官方流页
         实拍 113482 同形态，与集流是两副面孔，不共用材料）。
         全屏方钮只集流竖屏出（用户亲点定版：清屏开关——按下界面全隐、
         清屏态唯一留屏件且变淡防烧屏，再按恢复；不走全屏观看筹的横屏跳转） -->
    <LinearLayout
        android:id="@+id/hg_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hg_series_bar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hg_catalog_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hg_series_play_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_play"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_series_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/hg_series_arrow"
                android:layout_width="20dp"
                android:layout_height="10dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_catalog_arrow" />

            <TextView
                android:id="@+id/hg_series_arrow_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="›"
                android:textColor="#CCFFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/hg_fs_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_hg_catalog_bar"
            android:contentDescription="全屏观看"
            android:padding="10dp"
            android:src="@drawable/ic_hg_expand"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hg_progress_box"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="bottom">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:background="#33FFFFFF" />

        <View
            android:id="@+id/hg_progress_fill"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:background="#FFFFFF"
            android:transformPivotX="0dp"
            android:transformPivotY="1dp" />

        <View
            android:id="@+id/hg_progress_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_hg_progress_dot" />
    </FrameLayout>

    <ImageView
        android:id="@+id/hg_pause_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:src="@drawable/ic_hg_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hg_chip"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="加载失败，点按重试"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
