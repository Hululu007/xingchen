<?xml version="1.0" encoding="utf-8"?>
<!--
     音乐搜索独立页（拆页 p10）自有布局：只含本页实际引用子集——
     顶栏（居中标题，btnSearch 在搜索页恒隐藏、照旧布局保留 gone 位）＋搜索框行
     （etKeyword＋取消）＋分类横排 tabRow＋计数条／组筛选条＋结果工具条
     （随机／顺序／来源／排序）＋搜索落地页 searchLanding（最近搜索／热门搜索／猜你想搜）
     ＋结果列表 recycler＋空态覆盖层。
     各块照旧列表布局原块逐字搬（id 全复用、无新 id）；
     旧页大标题行在 search 下恒隐藏、本页不带。
     根与背景层照旧：根底 home_bg_page 兜底＋MusicGlassBackgroundView 铺满。
     无返回箭头（铁律），关页走系统返回／搜索框行「取消」；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/music_playlist"
                android:textColor="#1C1C1E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/music_search"
                android:padding="12dp"
                android:src="@drawable/ic_music_search"
                android:visibility="gone" />

            <!-- 第 1 项：歌单详情页顶栏 ⋮（仅 sheet 模式可见）：刷新歌单／随机播放／搜索歌曲／排序歌曲／分享歌单／多选 -->
            <ImageView
                android:id="@+id/btnSheetMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnSearch"
                android:contentDescription="@string/player_more"
                android:padding="12dp"
                android:src="@drawable/ic_music_more"
                android:visibility="gone" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_music_glass_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_search"
                    android:tint="#8E8E93" />

                <EditText
                    android:id="@+id/etKeyword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/music_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#1C1C1E"
                    android:textColorHint="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/searchCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:text="@string/music_search_cancel"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <!-- 第 5 项：按类计数行（歌手 N 位／歌单 N 个／专辑 N 张；单曲类无此行） -->

        <TextView
            android:id="@+id/searchCountBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9AA7B8"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 第 5 项：组内筛选条（歌手：X ×／专辑：X ×，点 × 回分类；筛选条是过滤控件、不是返回箭头） -->

        <TextView
            android:id="@+id/searchGroupBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_music"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="#FA243C"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivPlayAllIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_shuffle"
                    android:tint="#FA243C" />

                <TextView
                    android:id="@+id/tvPlayAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_shuffle_play"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlaySeq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FA243C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_play_all_order"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 第三波 A2：搜索源选择器（搜索模式工具条内，仅搜索模式可见；歌单／歌词签下隐藏） -->
            <TextView
                android:id="@+id/btnSourceFilter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_overview"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="全部来源 ▾"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnSort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/music_sort_default"
                android:padding="12dp"
                android:src="@drawable/ic_music_sort" />

            <!-- 第三波 R4：通用排序当前档常显（device／收藏／历史有各自对话框时隐藏，见 refreshSortLabel） -->
            <TextView
                android:id="@+id/tvSortCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA7B8"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 第 5 项：搜索落地页（仅 search 模式无结果时可见，与列表互斥；内容超高可滑） -->

        <ScrollView
            android:id="@+id/searchLanding"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/recentHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最近搜索"
                        android:textColor="#1C1C1E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvRecentClear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="清空"
                        android:textColor="#9AA7B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.fongmi.android.tv.ui.widget.FlowLayout
                    android:id="@+id/recentFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvRecentMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:padding="4dp"
                    android:textColor="#9AA7B8"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/hotHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="热门搜索"
                        android:textColor="#1C1C1E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnHotRefresh"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_action_refresh" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hotRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/guessHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="猜你想搜"
                    android:textColor="#1C1C1E"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/guessRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- 状态层（空状态与「正在加载…」共用）：根 FrameLayout 覆盖层、layout_gravity 居中锚定 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA7B8"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
