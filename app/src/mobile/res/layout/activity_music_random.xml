<?xml version="1.0" encoding="utf-8"?>
<!-- 第 10 项：随心听沉浸页（GZ ShuffleListenScreenKt：
     唱片卡顶部“随心而至”12sp＋6dp 圆点分隔＋状态文案 11sp（三态：选歌中／正在播放／等待聆听）；
     底部标语“让喜欢，自然而然发生”11sp 字距 1；
     旋转黑胶结构比例：内圈封面 0.68f、中心黑点 0.053f、封面 fallback 图标 0.24f（外圈绝对 dp 未抠到，
     星辰侧自定为屏宽×0.7、上限 320dp）；转速未抠到，星辰侧自定 20 秒／圈；
     歌名 23sp 字距 -0.5、副文案 12sp、找歌中态“正在寻找下一首…”11sp、“重新发现”11sp；
     传输控制：上一首／中央播放·暂停圆钮 72dp 图标 34dp／下一首（钮内放不下文字＋图标，文案以图标＋无障碍文案随态切换）；
     反馈区：不合口味＋收藏这首／已收藏这首（星辰无偏好学习引擎，不合口味只切下一首，不假装学习）；
     第二波页面侧：身份行 tvShuffleMeta（歌手 · 专辑 · 来源，查不到来源不显示，不拿 platform 原始码冒充名）；
     失败块 failedBlock（失败提示＋重试钮，停在目标曲目不弹回旧歌）；空态块 emptyBlock（明确出口回音乐首页，
     空态下隐藏“再随机一次”，不再空转同一条空链）；“重新发现”改名“再随机一次”（只重洗同一池子，诚实标签）；
     进度条轨道圆角 3dp、两侧时间 11sp mm:ss，可拖动；
     底色未抠到，星辰侧自定深色 #0A0E16 沉浸底；卡内排布未抠到，星辰侧自定为上下结构） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E16"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="随心而至"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot_white" />

            <TextView
                android:id="@+id/tvShuffleState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="选歌中"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/discWrap"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_disc_black" />

            <ImageView
                android:id="@+id/ivDiscCover"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivDiscFallback"
                android:layout_width="67dp"
                android:layout_height="67dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_eq"
                android:visibility="gone" />

            <View
                android:id="@+id/discDot"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dot_black" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvShuffleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShuffleMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvShuffleSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="从你的队列、最近播放、收藏和下载里&#10;随机挑歌，洗好顺序连着播"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvShuffleFinding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/random_finding"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvRediscover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="@string/random_reshuffle"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/failedBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFailedHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/random_failed_hint"
                android:textColor="#FFFF9A9A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/random_retry"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/random_empty_hint"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnEmptyHome"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/random_back_home"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/bg_seek_track"
                android:thumb="@drawable/bg_seek_thumb" />

            <TextView
                android:id="@+id/tvDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_music_prev" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_circle_white"
                android:padding="19dp"
                android:src="@drawable/ic_music_pause" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_music_next" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDislike"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="跳过这首"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnFav"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="收藏这首"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.09"
            android:text="让喜欢，自然而然发生"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
