<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐播放页骨架（全主题共用）：封面糊底背景层＋主题容器＋爱心粒子覆盖层。
     主题容器按 MusicStore.getPlayerTheme() 装 player_theme_*.xml，控件接线在 MusicPlayerActivity。
     整页一体：根布局不吃 fitsSystemWindows，内容顶到边、状态栏透明压在封面底上（GZ 同款）；
     氛围色罩与底部暗罩已撤——GZ 背景是封面本身铺底（上半原图、下半模糊延伸），不许再盖色块。
     歌词内页不吃 fitsSystemWindows，页眉垫高由代码按状态栏高做（wireLyricsPage），其余层全顶到边。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E16">

    <!-- 背景层：封面图本身铺底（糊底是封面图的模糊延伸，歌词压在上面；无封面时才露兜底色） -->
    <ImageView
        android:id="@+id/ivBgBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- 流体背景层（A4）：盖在糊底之上；动态流体背景开时才可见，颜色由播放页封面取色传入 -->
    <com.fongmi.android.tv.ui.custom.FluidCoverAmbientView
        android:id="@+id/fluidAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 主题容器：整页竖滑切歌拦截层（GZ coverAxisLock 模型），五主题通用；
         内嵌歌词不再竖滚（KaraokeLyricsView coverMode 门），手动滚只留全屏歌词页 -->
    <com.fongmi.android.tv.ui.custom.PlayerPageSwipeLayout
        android:id="@+id/themeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 全屏歌词页（GZ 本体为播放页内 HorizontalPager 第 2 页、与播放页同一状态源；
         原独立 MusicLyricsActivity 自带一份取词/解析/取色/进度链，与播放页双份打架，已整条删除并为本内页） -->
    <FrameLayout
        android:id="@+id/lyricsPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- U-03 内页去封面大区：封面只在页眉以 40dp 方形缩略图出现（id 不变，MPA loadIntoCover 照旧喂图；
                 原 pgCoverFade 大区渐变随大区一并去掉，MPA 侧已对 pageCoverFade 判空，不会崩）。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <ImageView
                    android:id="@+id/pgCover"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pgTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:lineHeight="21dp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pgArtist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#8CFFFFFF"
                            android:textSize="13sp"
                            android:lineHeight="17dp" />

                        <ImageView
                            android:id="@+id/pgBtnFav"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:contentDescription="@string/music_favorite"
                            android:padding="7dp"
                            android:src="@drawable/ic_music_heart"
                            android:tint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/pgBtnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/music_more"
                    android:padding="9dp"
                    android:src="@drawable/ic_music_menu"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/pgBtnQueue"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/music_queue"
                    android:padding="9dp"
                    android:src="@drawable/ic_music_queue"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/pgBtnPlayTop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
                android:id="@+id/pgLyricsView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="28dp"
                android:paddingEnd="28dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pgChipQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lyric_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/pgChipWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_lyric_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/music_word_by_word"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/pgSeek"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="10dp"
                    android:clickable="false"
                    android:enabled="false"
                    android:focusable="false"
                    android:maxHeight="2dp"
                    android:minHeight="2dp"
                    android:progressDrawable="@drawable/bg_lyric_hairline_progress"
                    android:thumb="@drawable/lyr_hairline_thumb" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 封面横滑切歌方向提示（GZ G03 SwipeDirectionHint）：拖动中显示方向，松手隐 -->
    <TextView
        android:id="@+id/swipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_lyric_capsule"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 爱心粒子覆盖层（双击封面/收藏按钮爆发，不拦截触摸） -->
    <com.fongmi.android.tv.ui.custom.HeartsBurstView
        android:id="@+id/heartsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- GZ 式迷你进度条（activity 层、五主题共用一个）：平时底下只有一根短条，点一下展开完整进度栈，
         闲置 3s（星辰侧自定，非 GZ 代码值）缩回。视图高 24dp 是点按热区，视觉条 3dp 居中画；
         底边距 12dp，视觉条约在屏底上 22.5-25.5dp（GZ 实拍条底约 44dp 含系统导航区，星辰侧对齐歌词内页 24dp 底边距一档）。 -->
    <com.fongmi.android.tv.ui.custom.MusicMiniProgressView
        android:id="@+id/miniProgress"
        android:layout_width="52dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
