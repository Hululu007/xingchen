<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐播放页骨架·横屏（A7）：id 与竖屏一致，MPA 的 find 不用改；歌词内页改左右分栏（封面列左、歌词＋主控右列），
     左手模式由 MPA 横屏分支换列序。主题内页沿用竖屏组合（逐主题横版文件不在本批清单内）。 -->
<!-- 音乐播放页骨架（全主题共用）：封面糊底背景层＋氛围色罩＋主题容器＋爱心粒子覆盖层。
     主题容器按 MusicStore.getPlayerTheme() 装 player_theme_*.xml，控件接线在 MusicPlayerActivity。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E16"
    android:fitsSystemWindows="true">

    <!-- 背景层：封面 64px 小图放大成糊底（无封面/取色失败时由 viewAmbient 兜底色盖住） -->
    <ImageView
        android:id="@+id/ivBgBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- 流体背景层（A4）：盖在糊底之上、氛围色层之下；动态流体背景开时才可见，颜色由播放页封面取色传入 -->
    <com.fongmi.android.tv.ui.custom.FluidCoverAmbientView
        android:id="@+id/fluidAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 氛围色层：CoverColor 取色，颜色由代码 450ms 渐变过渡 -->
    <View
        android:id="@+id/viewAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.82"
        android:background="#FF1C1C1E" />

    <!-- 可读性渐变罩：上透下暗 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_scrim" />

    <!-- 主题容器 -->
    <FrameLayout
        android:id="@+id/themeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 全屏歌词页（GZ 本体为播放页内 HorizontalPager 第 2 页、与播放页同一状态源；
         原独立 MusicLyricsActivity 自带一份取词/解析/取色/进度链，与播放页双份打架，已整条删除并为本内页） -->
    <FrameLayout
        android:id="@+id/lyricsPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1C1C1E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/lyricsCoverCol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45">

                <ImageView
                    android:id="@+id/pgCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/pgCoverFade"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/lyricsMainCol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="55"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pgTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:lineHeight="21dp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pgArtist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#8CFFFFFF"
                            android:textSize="13sp"
                            android:lineHeight="17dp" />

                        <ImageView
                            android:id="@+id/pgBtnFav"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:contentDescription="@string/music_favorite"
                            android:padding="7dp"
                            android:src="@drawable/ic_music_heart"
                            android:tint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/pgBtnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/music_more"
                    android:padding="9dp"
                    android:src="@drawable/ic_music_menu"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/pgBtnQueue"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/music_queue"
                    android:padding="9dp"
                    android:src="@drawable/ic_music_queue"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/pgBtnPlayTop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
                android:id="@+id/pgLyricsView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="28dp"
                android:paddingEnd="28dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pgChipQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lyric_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/pgChipWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_lyric_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/music_word_by_word"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/pgSeek"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="10dp"
                    android:clickable="false"
                    android:enabled="false"
                    android:focusable="false"
                    android:maxHeight="2dp"
                    android:minHeight="2dp"
                    android:progressDrawable="@drawable/bg_lyric_hairline_progress"
                    android:thumb="@drawable/lyr_hairline_thumb" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 封面横滑切歌方向提示（GZ G03 SwipeDirectionHint）：拖动中显示方向，松手隐 -->
    <TextView
        android:id="@+id/swipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_lyric_capsule"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 爱心粒子覆盖层（双击封面/收藏按钮爆发，不拦截触摸） -->
    <com.fongmi.android.tv.ui.custom.HeartsBurstView
        android:id="@+id/heartsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
