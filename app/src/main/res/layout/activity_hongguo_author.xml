<?xml version="1.0" encoding="utf-8"?>
<!-- 红果·作者主页（官方原生轨 SeriesGuestProfileFragment/ax8 定版构成，
     dig-mine-profile §2.8：置顶 chip 行 22dp 头像＋名、头像姓名行、关注钮、
     「关注 X · 粉丝 Y」数据行、作品页签）。与「我的」面同口径：白底、
     不放页面自带返回箭头（走系统返回；官方 ax8 的返回图标是官方壳的，
     按自家站规矩不抄，偏差见 fix-author-page 账）。
     数据行与作品列表的数据源未在包内抠到（计数嵌在未定名的资料 RPC 里、
     作者维度作品口未证实）——两处先 GONE/空态，不摆假数。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- 置顶 chip 行（官方 ctw：22dp 圆头像＋16sp 粗名横排） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hg_author_chip_avatar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/hg_author_chip_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FF1D2129"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 头像姓名行（官方 c_m：58dp 头像＋20sp 粗名） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hg_author_avatar"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hg_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF1D2129"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 数据行「关注 X · 粉丝 Y」：UserRelation{fans_num,
                 follow_user_num} 字段在包内实证，但承载它的资料 RPC
                 未抠到——本行无数据源时整行 GONE，不显 0 数 -->
            <TextView
                android:id="@+id/hg_author_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF86909C"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_author_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF4E5969"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 关注钮（官方 PugcFollowButton：66dp 宽；未关注＝橙渐变「关注」，
         已关注＝浅底「已关注」，本人隐藏；状态读 HgStore 作者关注集） -->
    <TextView
        android:id="@+id/hg_author_follow"
        android:layout_width="66dp"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_hg_follow_btn"
        android:gravity="center"
        android:text="关注"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 作品页签（官方定版只有「作品」一签）：列表数据源未证实
         （见类头注），先只留标题＋空态文案，不摆假行 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="作品"
        android:textColor="#FF1D2129"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hg_author_works_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="作品列表还没接上"
        android:textColor="#FF86909C"
        android:textSize="13sp" />
</LinearLayout>
