<?xml version="1.0" encoding="utf-8"?>
<!-- 红果评论面板（官方实拍 113610 白面口径）：白底圆角顶、头部左 ⌄＋居中
     双页签「评论 N／剧评 M」（评论＝单集评论、剧评＝整剧评论，两套数据）、
     底部浅灰胶囊输入条（FakePublishLayout 口径：点开独立编辑层）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hg_comments_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hg_cm_collapse"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="收起"
            android:padding="5dp"
            android:src="@drawable/ic_hg_chevron_down" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hg_cm_tab_episode"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="评论"
                android:textColor="#FF1F1F1F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hg_cm_tab_series"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="22dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="剧评"
                android:textColor="#FF9A9A9A"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 与左 ⌄ 等宽占位，保证页签真居中。 -->
        <View
            android:layout_width="32dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hg_cm_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/hg_cm_empty_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/hg_cm_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无评论"
                android:textColor="#FF4A4A4A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hg_cm_empty_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="期待你的第一条评论"
                android:textColor="#FF9A9A9A"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hg_cm_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部假输入条：只在「评论」页签（单集语境）显示；整条一个点按目标
         进编辑层（图片评论上传链未抠到，图片钮只作形态、不摆单独假功能）。 -->
    <LinearLayout
        android:id="@+id/hg_cm_input_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_hg_comment_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hg_cm_input_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="有趣评论千千万，不如你也来一条？"
            android:textColor="#FF9A9A9A"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/hg_cm_input_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:contentDescription="图片"
            android:src="@drawable/ic_hg_image" />

        <ImageView
            android:id="@+id/hg_cm_input_emoji"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="14dp"
            android:contentDescription="表情"
            android:src="@drawable/ic_hg_emoji" />
    </LinearLayout>
</LinearLayout>
