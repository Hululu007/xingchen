<?xml version="1.0" encoding="utf-8"?>
<!-- 发评论/回复编辑层（白面版，评论面专用；与弹幕编辑层的深底小 Dialog 是
     两件，不串）：标题（发评论／回复 @名）、浅灰输入框（hint 照官方串
     「发条友善的评论吧」）、表情条（53 码照官方 emoji_config.json，点插
     [码] 文本、与官方同存码机制）、发表/取消。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hg_comment_editor"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/hg_ce_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发评论"
        android:textColor="#FF1F1F1F"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/hg_ce_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_hg_comment_field"
        android:hint="发条友善的评论吧"
        android:inputType="text"
        android:maxLines="4"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textColor="#FF1F1F1F"
        android:textColorHint="#FF9A9A9A"
        android:textSize="15sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hg_ce_emoji_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/hg_ce_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="没发出去，再试试"
        android:textColor="#FFE64340"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hg_ce_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="取消"
            android:textColor="#FF5C5C5C"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_ce_publish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.45"
            android:enabled="false"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:text="发表"
            android:textColor="#FFFA7705"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
