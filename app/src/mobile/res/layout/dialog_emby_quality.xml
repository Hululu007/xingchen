<?xml version="1.0" encoding="utf-8"?>
<!-- Emby 播前画质/转码选择弹窗：深色毛玻璃底，不用白底 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/emby_quality_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/emby_quality_sub"
        android:textColor="#A8B0C0"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/emby_quality_loading"
        android:textColor="#A8B0C0"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/emby_quality_empty"
        android:textColor="#A8B0C0"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/emby_option_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/emby_btn_cancel"
        android:textColor="#F2F4F8"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
