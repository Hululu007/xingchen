<?xml version="1.0" encoding="utf-8"?>
<!-- 随心听页整页照瓜子 ShuffleListenScreenKt 重做（他亲点，逐项数值对齐）：
     浅色底（页面主题画笔真值未抠到，暂用 discoverySurface #FAFAFC，报告已标）；
     唱片卡：底 #FAFAFC 圆角 20、横内距 24（矮屏 16）、底内距 20（矮屏 12）、顶内距 20（真值未抠到，报告已标）；
     卡头行：「随心而至」12sp 半粗 textMedium #8E8E93 ＋ 右侧 6dp 状态点 ＋ 6dp 间距 ＋ 状态文案 11sp（三态：选歌中／正在播放／等待聆听）；
     唱片区顶距 16（矮屏 10）；盘径＝min(可用宽高， 300dp；矮屏 260dp），盘面用瓜子原图 disc_bg；
     封面 0.68×盘径、中心黑点 0.053×、无封面 fallback 图标 0.24×（白 @0.85）；盘投影 12dp（瓜子 shadow 12/.3/.4 近似，报告已标）；
     盘下刻度带 18dp 整宽（间距/长短真值未抠到，见 MusicRulerView）；口号在卡内：距刻度 10dp、11sp、字距 1sp（≈0.09em），矮屏不显示；
     卡与控制面板间距 20（矮屏 14）；面板限宽 460、内部块间距 16（矮屏 12）；
     身份块横内距 34：歌名 23sp 粗体 textHigh #1C1C1E 字距 -0.5、歌手行 12sp（间距 6）；找歌态骨架条（72%×25dp／48%×13dp、黑 @0.07、圆角 7、间隔 5）＋「正在寻找下一首…」11sp；
     进度块限宽 310、横内距 20：条高 3dp 圆角、轨道 textMedium @0.18、填充为封面 tone 渐变（代码里按 tone 重建）；时间行距条 5dp、11sp 两端对齐；
     运输行限宽 270、横内距 24：上一首/下一首 48dp 钮（图标 20dp、textHigh），中央播放钮 72dp 黑圆（textHigh 底、图标 34dp、contentSurface 色）；
     反馈行限宽 310、横内距 20、间距 10：两颗等宽丸子键高 48、圆角 18、底 discoveryInset #F0F0F4、图标 15dp＋间距 6、字 12sp 半粗；
     底部不画瓜子 App 导航栏、不为它留位（他亲点排除）。
     星辰自有保留：失败块/空态块（诚实出口）、「再随机一次」（只重洗同一池子）、进度条可拖（瓜子此页进度条无拖动手势，星辰保留既有拖动行为不改交互，拖柄透明）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_shuffle_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="随心而至"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/dotState"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_shuffle_dot" />

            <TextView
                android:id="@+id/tvShuffleState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="选歌中"
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/discWrap"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:elevation="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/disc_bg" />

            <ImageView
                android:id="@+id/ivDiscCover"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivDiscFallback"
                android:layout_width="67dp"
                android:layout_height="67dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_eq"
                android:visibility="gone" />

            <View
                android:id="@+id/discDot"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dot_black" />
        </FrameLayout>

        <com.fongmi.android.tv.ui.music.view.MusicRulerView
            android:id="@+id/ruler"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.09"
            android:text="让喜欢，自然而然发生"
            android:textColor="#8E8E93"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/gapCardPanel"
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <LinearLayout
        android:id="@+id/panelRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="34dp"
            android:paddingEnd="34dp">

            <TextView
                android:id="@+id/tvShuffleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShuffleMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvShuffleSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="从你的队列、最近播放、收藏和下载里随机挑歌，洗好顺序连着播"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/findingSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="72"
                        android:background="@drawable/bg_shuffle_skeleton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="28" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="13dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="48"
                        android:background="@drawable/bg_shuffle_skeleton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="52" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvShuffleFinding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/random_finding"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRediscover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:padding="8dp"
                android:text="@string/random_reshuffle"
                android:textColor="#1C1C1E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/failedBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFailedHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/random_failed_hint"
                    android:textColor="#BA1A1A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_shuffle_pill"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/random_retry"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/random_empty_hint"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnEmptyHome"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_shuffle_pill"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/random_back_home"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progressBlock"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="3dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressDrawable="@drawable/bg_shuffle_seek_track"
                android:splitTrack="false"
                android:thumb="@drawable/bg_shuffle_seek_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/transportRow"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="上一首"
                android:padding="14dp"
                android:src="@drawable/ic_music_prev" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shuffle_play"
                android:contentDescription="播放"
                android:padding="19dp"
                android:src="@drawable/ic_music_pause" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="下一首"
                android:padding="14dp"
                android:src="@drawable/ic_music_next" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/prefsRow"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/btnDislike"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_shuffle_pill"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_shuffle_dislike"
                android:gravity="center"
                android:text="不合口味"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_shuffle_pill"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_music_heart"
                android:drawableTint="#1C1C1E"
                android:gravity="center"
                android:text="收藏这首"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
