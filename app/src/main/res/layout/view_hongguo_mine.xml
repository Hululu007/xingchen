<?xml version="1.0" encoding="utf-8"?>
<!-- 红果「我的」面：嵌在刷剧页壳内（底栏「我的」格），构成＝登录区＋页签排
     （历史/收藏/点赞/预约，序为他亲定；预约链已抠实落码 dd184c44）＋海报格子。
     无自带返回箭头（走系统返回），顶部留距由刷剧页按状态栏 insets 注入 padding。 -->
<com.fongmi.android.tv.hongguo.ui.HgMineView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 头部（官方真值）：未登录＝大标题「免费短剧 尽在红果」20sp 粗 #FF000000
         ＋副行「欢迎来到红果短剧」16sp #66000000＋右「立即登录」钮（14sp 粗白字、
         padding 16×8dp、圆角 8dp）；已登录＝头像 60dp＋昵称 20sp 粗。
         旧版自加的「我的」标题行与灰盒账号条官方皆无，摘除。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/hg_mine_guest_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="免费短剧 尽在红果"
                    android:textColor="#FF000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="欢迎来到红果短剧"
                    android:textColor="#66000000"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hg_mine_login_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hg_login_btn"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="立即登录"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_mine_user_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="22dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <TextView
                    android:id="@+id/hg_mine_avatar_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hg_avatar_circle"
                    android:gravity="center"
                    android:text="红"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <ImageView
                    android:id="@+id/hg_mine_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/hg_mine_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FF000000"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 功能列表（官方 pj() 主列表的短剧子集：只留有真数据/真去处的项；
         我的预约开预约页（新剧预约数据面未抠到，本版先做我的预约一面）；
         金币/商城/钱包/会员是官方商业件，第三方不做；我的下载无下载功能不摆） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/hg_mine_entry_reserve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_entry_reserve" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="我的预约"
                android:textColor="#FF000000"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 页签条（官方 qb3/f：标题 16sp 选中粗体；右端搜索图标 20dp）。
         页签＝历史/收藏/点赞（短剧范围）；预约走上方功能位开页，不占页签。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hg_mine_tab_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="历史"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_mine_tab_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="收藏"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_mine_tab_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="点赞"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/hg_mine_search"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hg_search" />
    </LinearLayout>

    <!-- 子筛行（官方书架壳 auf：二级页签条 42dp 高、右端筛选/编辑 14sp 粗）。
         筹集按页签换：历史＝全部/已看完/未看完；收藏＝全部/真人剧/追更（他定）；
         点赞无子筛。编辑进多选删除态。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/hg_mine_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/hg_mine_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="编辑"
            android:textColor="#FF000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/hg_mine_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:textColor="#999999"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hg_mine_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- 编辑模式底条（选中计数＋删除动作；非编辑态 gone） -->
    <LinearLayout
        android:id="@+id/hg_mine_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hg_mine_edit_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#666666"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hg_mine_edit_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="删除"
            android:textColor="#E5484D"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.fongmi.android.tv.hongguo.ui.HgMineView>
