<?xml version="1.0" encoding="utf-8"?>
<!-- 红果搜索卡作者头像描边环：官方 b7l 头像位（ScaleSimpleDraweeView）
     带 roundingBorderWidth 0.5dp、roundingBorderColor＝
     skin_color_gray_10_light #1A000000 的圆环；自家此前只有透明裁剪
     轮廓、无此环，浅色头像会糊进白卡。此件作头像上层同位叠环。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#00000000" />
    <stroke
        android:width="0.5dp"
        android:color="#1A000000" />
</shape>
