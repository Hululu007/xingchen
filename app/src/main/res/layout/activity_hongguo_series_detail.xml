<?xml version="1.0" encoding="utf-8"?>
<!-- 红果·剧详情页（官方实拍 113563 构成，2026-10-29 落地）：封面取色沉浸底
     （服务端 series_color_hex 定色＋虚化封面垫底）、封面小图＋剧名＋副标题段
     （series_sub_title_list：全X集·红果热度值）、简介（标签筹＋可展开）、
     剧集（分段页签＋集格、当前集金底）、剧评（评分卡＋剧评卡横滑）、
     底栏☆收藏＋继续播放、顶右分享/更多。不放页面自带返回箭头（走系统返回）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF241D16">

    <ImageView
        android:id="@+id/hg_sd_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/hg_sd_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59241D16" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="96dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp">

            <!-- 头行：封面小图＋剧名＋副标题段 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hg_sd_cover"
                    android:layout_width="84dp"
                    android:layout_height="124dp"
                    android:background="@drawable/bg_hg_detail_cover"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hg_sd_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFFFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hg_sd_subline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 简介：官方 113563 是「标＋标签筹」同一行；展开收在正文行尾内嵌 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简介"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/hg_sd_tags"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/hg_sd_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingExtra="6dp"
                android:maxLines="3"
                android:textColor="#D9FFFFFF"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="16dp"
                android:background="#14FFFFFF" />

            <!-- 剧集 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="剧集"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hg_sd_ep_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/hg_sd_segments_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/hg_sd_segments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 集格：官方 113563 是横滑单行方格条（格正方、条尾出血到屏缘） -->
            <HorizontalScrollView
                android:id="@+id/hg_sd_ep_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="-16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/hg_sd_ep_cells"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingEnd="16dp" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="18dp"
                android:background="#14FFFFFF" />

            <!-- 剧评 -->
            <TextView
                android:id="@+id/hg_sd_reviews_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="剧评"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hg_sd_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_hg_glass_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hg_sd_score_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="红果分"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="#33FFFFFF" />

                <TextView
                    android:id="@+id/hg_sd_collectors"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hg_sd_threshold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#BFFFFFFF"
                        android:textSize="12sp" />

                    <!-- 参与评分：五星可点（整星，十分制＝星数×2）＋状态/提交行。
                         星在代码里逐个填（点按要分颗接）。 -->
                    <LinearLayout
                        android:id="@+id/hg_sd_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/hg_sd_score_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textColor="#BFFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hg_sd_reviews"
                android:layout_width="match_parent"
                android:layout_height="148dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- 顶右分享/更多（官方实拍 113562 右上两钮；返回走系统不放自带箭头）。
         分享走系统分享；更多只放「不感兴趣」一项真功能（官方「⋯」另一形态是
         举报，走字节 spam SDK 自有链、请求形状未验通，不摆假项）。 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hg_sd_share"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="分享"
            android:padding="8dp"
            android:src="@drawable/ic_hg_share" />

        <ImageView
            android:id="@+id/hg_sd_more"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="更多"
            android:padding="8dp"
            android:src="@drawable/ic_hg_more" />
    </LinearLayout>

    <!-- 底栏：收藏＋继续播放 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E61A1712"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/hg_sd_fav"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hg_sd_fav_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☆"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收藏"
                android:textColor="#BFFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hg_sd_play"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hg_follow_btn"
            android:gravity="center"
            android:text="▶ 继续播放"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
