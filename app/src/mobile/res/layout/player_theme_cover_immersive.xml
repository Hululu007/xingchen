<?xml version="1.0" encoding="utf-8"?>
<!-- 封面卡片主题（GZ PlayerScreenKt CoverImmersivePlayer :8339 装配转写，证据 redo2-gz-player-evidence A 节）：
     间隔 42 → 歌名（28dp 横距、高 30dp、20sp/800/白 0.96）→ 间隔 4 → 歌手（高 22dp、14sp/500/白 0.65）
     → 间隔 22 → 权重区（横距 24dp）：封面卡（宽=min(区宽×0.98, 区高/0.65)、高=宽×0.65、圆角 22dp、后叠两张白渐变占位卡）
     → 间隔 14 → 玻璃歌词条（高 48dp、圆角 22dp：收藏 40 区/图标 20、单行歌词 13sp/500/白 0.92 居中、播放 40 区/图标 24）
     → 间隔 12。默认态无进度条、无菜单/队列键；点封面进展开态（卡内歌词窗＋四玻璃键＋Scrubber），玻璃条中段文案变「返回到封面模式」。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="42dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/tpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:lineHeight="26dp"
            android:maxLines="1"
            android:textColor="#F5FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- 歌手行：歌手 ♡ 专辑名（GZ 截图同款），歌手点进歌手搜索、专辑点进专辑搜索；分隔心跟专辑同显同藏 -->
        <TextView
            android:id="@+id/tpArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineHeight="18dp"
            android:maxLines="1"
            android:textColor="#8CFFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/tpAlbumSep"
            android:layout_width="27dp"
            android:layout_height="13dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:src="@drawable/ic_music_heart"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tpAlbum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineHeight="18dp"
            android:maxLines="1"
            android:textColor="#8CFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="22dp" />

    <!-- 封面权重区：手势挂 tpCoverWrap（点按切换展开态/双击收藏/横滑切歌/长按工具面板，代码侧分流） -->
    <FrameLayout
        android:id="@+id/tpCoverWrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:id="@+id/tpCoverCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_cover_card_back"
                android:rotation="2.5" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_cover_card_back"
                android:rotation="-2.5" />

            <ImageView
                android:id="@+id/tpCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="12dp"
                android:scaleType="centerCrop" />

            <!-- 出场封面层（redo3 F1）：切歌时旧封面暂存于此做 出场动画，平时 gone -->
            <ImageView
                android:id="@+id/tpCoverExit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 展开态：卡内歌词窗/信息卡＋四玻璃键＋Scrubber（GZ PS:8987-9145） -->
            <LinearLayout
                android:id="@+id/tpCoverExpanded"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cover_expanded"
                android:elevation="13dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
                        android:id="@+id/tpLyricView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:id="@+id/tpCoverInfo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tpInfoTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#F5FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tpInfoArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#A6FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tpInfoAlbum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#A6FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tpInfoSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#A6FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tpPrev"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_player_glass_btn"
                        android:contentDescription="@string/music_prev"
                        android:padding="10dp"
                        android:src="@drawable/ic_music_prev"
                        android:tint="#FFFFFF" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/tpQueue"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_player_glass_btn"
                        android:contentDescription="@string/music_queue"
                        android:padding="10dp"
                        android:src="@drawable/ic_music_queue"
                        android:tint="#FFFFFF" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/tpBtnInfoExp"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_player_glass_btn"
                        android:contentDescription="@string/music_song_info"
                        android:padding="10dp"
                        android:src="@drawable/ic_music_note"
                        android:tint="#FFFFFF" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/tpNext"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_player_glass_btn"
                        android:contentDescription="@string/music_next"
                        android:padding="10dp"
                        android:src="@drawable/ic_music_next"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <!-- Scrubber（与经典同一套：顶盒筹行＋细轨＋底时间行） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tpPositionTop"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:alpha="0"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.018"
                            android:text="00:00"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/tpChipQuality"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_player_chip"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/tpQualityValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.054"
                                    android:maxLines="1"
                                    android:textColor="#B8FFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/tpChipLyric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_player_chip"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp">

                                <TextView
                                    android:id="@+id/tpLyricChipText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.054"
                                    android:maxLines="1"
                                    android:text="@string/music_lyric_chip_line"
                                    android:textColor="#B8FFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tpDurationTop"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:alpha="0"
                            android:gravity="end"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.018"
                            android:text="00:00"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/tpSeek"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:progressDrawable="@drawable/bg_player_seek_progress"
                        android:thumb="@drawable/bg_player_seek_thumb" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="0dp">

                        <TextView
                            android:id="@+id/tpPosition"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.018"
                            android:text="00:00"
                            android:textColor="#A6FFFFFF"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tpDuration"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.018"
                            android:text="00:00"
                            android:textColor="#A6FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <!-- 玻璃歌词条（GZ CoverLyricGlassBar :9495：高 48dp、圆角 22dp、横距 24dp 容器内） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_cover_glass_bar"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/tpBtnFav"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_favorite"
                android:padding="10dp"
                android:src="@drawable/ic_music_heart"
                android:tint="#73FFFFFF" />

            <TextView
                android:id="@+id/tpLyricLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#EBFFFFFF"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/tpPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/pl_play_pause"
                android:padding="8dp"
                android:src="@drawable/ic_music_play"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />
</LinearLayout>
