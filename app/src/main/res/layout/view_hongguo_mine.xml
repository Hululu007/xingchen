<?xml version="1.0" encoding="utf-8"?>
<!-- 红果「我的」面：嵌在刷剧页壳内（底栏「我的」格），构成＝登录区＋页签排
     （历史/收藏/点赞/预约，序为他亲定；预约链已抠实落码 dd184c44）＋海报格子。
     无自带返回箭头（走系统返回），顶部留距由刷剧页按状态栏 insets 注入 padding。 -->
<com.fongmi.android.tv.hongguo.ui.HgMineView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 头部（官方真值）：未登录＝大标题「免费短剧 尽在红果」20sp 粗 #FF000000
         ＋副行「欢迎来到红果短剧」16sp #66000000＋右「立即登录」钮（14sp 粗白字、
         padding 16×8dp、圆角 8dp）；已登录＝头像 60dp＋昵称 20sp 粗。
         旧版自加的「我的」标题行与灰盒账号条官方皆无，摘除。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/hg_mine_guest_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="免费短剧 尽在红果"
                    android:textColor="#FF000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="欢迎来到红果短剧"
                    android:textColor="#66000000"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hg_mine_login_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hg_login_btn"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="立即登录"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_mine_user_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="22dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <TextView
                    android:id="@+id/hg_mine_avatar_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hg_avatar_circle"
                    android:gravity="center"
                    android:text="红"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <ImageView
                    android:id="@+id/hg_mine_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hg_mine_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 关系行（官方 HongguoMineRelationLayout b98 定版：三组
                     横排，每组＝计数 14sp＋单位 12sp＋标签 12sp、全 #B2000000
                     （skin_color_gray_70），组距 16dp，行 marginTop 6dp；
                     计数＝user_relation 的 follow_user_num/fans_num/
                     recv_digged_count，经 profile/get 回源；无源整行 gone，
                     不显假 0）。 -->
                <LinearLayout
                    android:id="@+id/hg_mine_relation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/hg_mine_rel_follow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"
                        android:textColor="#B2000000"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/hg_mine_rel_follow_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B2000000"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关注"
                        android:textColor="#B2000000"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/hg_mine_rel_fans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="2dp"
                        android:textColor="#B2000000"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/hg_mine_rel_fans_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B2000000"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="粉丝"
                        android:textColor="#B2000000"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/hg_mine_rel_digg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="2dp"
                        android:textColor="#B2000000"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/hg_mine_rel_digg_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B2000000"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="获赞"
                        android:textColor="#B2000000"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 页签条（官方 qb3/f：标题 16sp 选中粗体；右端搜索图标 20dp）。
         页签＝历史/收藏/点赞/预约（短剧范围，他亲定预约放点赞后面；国内版
         预约就是页内页签形态、与功能位「我的预约」互斥，本面取页签形态）。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hg_mine_tab_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="历史"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_mine_tab_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="收藏"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_mine_tab_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="点赞"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_mine_tab_reserve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="预约"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/hg_mine_search"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hg_search" />
    </LinearLayout>

    <!-- 子筛行（官方书架壳 auf：二级页签条 42dp 高、右端筛选/编辑 14sp 粗）。
         筹集按页签换：历史＝全部/已看完/未看完；收藏＝全部/真人剧/追更（他定）；
         点赞无子筛。编辑进多选删除态。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/hg_mine_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/hg_mine_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="编辑"
            android:textColor="#FF000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 追更面内自带筛选行（官方 MineFollowUpdateFilter：全部/已看完/未看完）：
         仅收藏页签的「追更」子筛选中时出现，与上方子筛行同形态。 -->
    <LinearLayout
        android:id="@+id/hg_mine_follow_chips"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_mine_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:textColor="#999999"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 网格间距照官方 az3/a 定版公式由 HgMineView 的 ItemDecoration 给
         （横向单位 8dp 按列分配、行底 18dp、首行顶 11dp），容器本身不留距 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hg_mine_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- 编辑模式底条（选中计数＋删除动作；非编辑态 gone） -->
    <LinearLayout
        android:id="@+id/hg_mine_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hg_mine_edit_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#666666"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hg_mine_edit_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="删除"
            android:textColor="#E5484D"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.fongmi.android.tv.hongguo.ui.HgMineView>
