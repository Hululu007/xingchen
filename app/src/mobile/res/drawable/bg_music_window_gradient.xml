<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐页起始窗口底：与 MusicGlassBackgroundView 场景同值的纵向渐变
     （上 #9A7B57 → 中 #6E4E30 → 下 #4B3926，即 GRAD_TOP/GRAD_MID/GRAD_BOT）。
     只作进页首帧之前的起始面，让起始窗口≈页面定案背景，不再是一块平板中棕；
     四团光斑不进起始面（静态近似），页面首帧由 MusicGlassBackgroundView 本体接管。
     XML gradient 中点固定 0.5、场景停点 0.45，起始面近似允许此差。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF9A7B57"
        android:centerColor="#FF6E4E30"
        android:endColor="#FF4B3926"
        android:type="linear" />
</shape>
