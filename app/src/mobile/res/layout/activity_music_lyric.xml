<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏歌词页（独立页，照瓜子全屏歌词面构成＋gz-player-values 第八节）：
     根＝封面氛围（dominant 色＋糊封面，与播放页同一外壳，封面拉满整屏垫底与背景一体）；
     内容列：歌名行（歌名＋右三裸键 队列/歌词样式/播放暂停，盒 40dp 贴连）→ 歌手♡专辑行 →
     歌词大字沉浸区（横边距 28dp）→ 进度栈（双筹＋轨道＋底行，与播放页同一 ClassicScrubberView）。
     无自带返回箭头（铁律），回上一页走系统返回；顶部状态栏留白由 Activity 按窗口嵌饰给。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyricRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1C1C1E">

    <com.fongmi.android.tv.ui.music.view.CoverAmbientView
        android:id="@+id/lyricAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/lyricContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/lyricMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lyricTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:letterSpacing="-0.0222"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lyricBtnQueue"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/player_queue"
                        android:padding="10dp"
                        android:src="@drawable/ic_music_queue"
                        android:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/lyricBtnStyle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/player_lyric_style"
                        android:padding="10dp"
                        android:src="@drawable/ic_lyric_wave"
                        android:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/lyricBtnPlay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/player_play_pause"
                        android:padding="6dp"
                        android:src="@drawable/ic_music_pause"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lyricArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#73FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/lyricBtnFav"
                    android:layout_width="27dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/player_favorite"
                    android:paddingStart="7dp"
                    android:paddingTop="4.5dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="4.5dp"
                    android:src="@drawable/ic_music_heart" />

                <TextView
                    android:id="@+id/lyricAlbum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#73FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <com.fongmi.android.tv.ui.music.view.MusicLyricStageView
            android:id="@+id/lyricStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <com.fongmi.android.tv.ui.music.view.ClassicScrubberView
            android:id="@+id/lyricScrubber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="45dp" />
    </LinearLayout>
</FrameLayout>
