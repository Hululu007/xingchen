<?xml version="1.0" encoding="utf-8"?>
<!-- 全域玻璃件·在播结果行框：与 bg_music_glass_row 同语言，玻璃面带本 App 强调红的淡染色＋红描边标识在播；按压态再提亮。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFBFB" android:endColor="#FFFFF0F1" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#80FA243C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFF5F5" android:endColor="#FFFFE9EA" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#4DFA243C" />
        </shape>
    </item>
</selector>
