<?xml version="1.0" encoding="utf-8"?>
<!-- 红果刷剧页：全屏竖向 ViewPager2 一页一集；顶栏（☰＋四页签＋搜索）浮在流上；
     全屏极简控制条（hg_fs_bar）默认隐藏，进全屏点屏唤出、自动再隐。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/hg_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/hg_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/hg_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="菜单"
            android:padding="9dp"
            android:src="@drawable/ic_hg_menu" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/hg_tab_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关注"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tab_comic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="漫剧"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tab_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="真人剧"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tab_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="推荐"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/hg_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="搜索"
            android:padding="9dp"
            android:src="@drawable/ic_hg_search" />
    </LinearLayout>

    <!-- 竖屏剧页标题栏（官方 ShortSeriesActivity 标题栏构成：返回＋标题＋
         倍速位＋更多；官方是 Compose 件，自家以原生 View 近似，容器高 44dp
         照官方 ikp）。只在集流模式在场，横屏观看态随 chrome 一起隐。 -->
    <LinearLayout
        android:id="@+id/hg_series_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hg_series_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="返回"
            android:padding="9dp"
            android:src="@drawable/ic_hg_back" />

        <TextView
            android:id="@+id/hg_series_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_series_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="倍速"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/hg_series_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="更多"
            android:padding="9dp"
            android:src="@drawable/ic_hg_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hg_refresh_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_hg_refresh_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/hg_refresh_spin"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hg_refresh_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下拉刷新"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hg_fs_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hg_fs_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="播放或暂停"
            android:padding="8dp"
            android:src="@drawable/ic_hg_pause" />

        <SeekBar
            android:id="@+id/hg_fs_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/hg_fs_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/hg_fs_series"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 横屏独立页 chrome（官方 ShortSeriesLandActivity 面，只在横屏实例
         在场）：状态条（cah：网络/时钟/电量）＋底部横排控制条（ca_：点赞/
         评论/收藏横排＋弹幕开关＋清晰度值＋倍速＋选集）＋锁定钮＋暂停提示。
         显隐由 setChromeHidden 的横屏分支统一收口。 -->
    <LinearLayout
        android:id="@+id/hg_land_status"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hg_land_net"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hg_wifi" />

        <TextView
            android:id="@+id/hg_land_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hg_land_battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hg_battery" />
    </LinearLayout>

    <!-- 横排控制条照官方 ca_：外层 40dp 满宽、内层宽 78% 居中；三件 40dp 高、
         图标 32dp、计数 10sp 压图标右下（左偏 20dp/底偏 2dp）、件距 20dp；
         右簇＝倍速位（hls：值或「倍速」）＋清晰度位（hlk）＋选集（hl6），
         均为 14sp 粗体、间距 32dp。内层宽度在代码里按屏宽×0.78 落位。 -->
    <FrameLayout
        android:id="@+id/hg_land_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hg_land_bar_inner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/hg_land_like"
                android:layout_width="wrap_content"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/hg_land_like_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="点赞"
                    android:src="@drawable/ic_hg_heart" />

                <TextView
                    android:id="@+id/hg_land_like_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hg_land_comment"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="20dp">

                <ImageView
                    android:id="@+id/hg_land_comment_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="评论"
                    android:src="@drawable/ic_hg_comment" />

                <TextView
                    android:id="@+id/hg_land_comment_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hg_land_fav"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="20dp">

                <ImageView
                    android:id="@+id/hg_land_fav_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="收藏"
                    android:src="@drawable/ic_hg_star" />

                <TextView
                    android:id="@+id/hg_land_fav_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/hg_land_danmaku"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:text="弹"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/hg_land_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hg_land_definition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hg_land_episodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="选集"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:id="@+id/hg_land_lock"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:contentDescription="锁定"
        android:padding="7dp"
        android:src="@drawable/ic_hg_unlock"
        android:visibility="gone" />

    <!-- 暂停提示照官方 ce9：播放三角 32dp 在左下（左 60dp/底 28dp），
         时间文本 12sp 粗在右下（右 60dp、底＝28+32+12＝72dp）；旧居中大圆钮作废。 -->
    <ImageView
        android:id="@+id/hg_land_play_hint"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_hg_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_land_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="72dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 长按快进提示（官方 SpeedTipsView 同位：顶部居中胶囊「2倍速快进中」，
         长按快进期间亮、松手灭；底复用下拉刷新胶囊的 bg_hg_refresh_pill）。 -->
    <TextView
        android:id="@+id/hg_speed_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_hg_refresh_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="2倍速快进中"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 红果自家底栏（他亲定两格：首页/我的；剧场不要）。首页＝刷剧流本体、
         我的＝壳内「我的」面，两格互切不新开 Activity；进全屏随界面一起全隐藏。 -->
    <LinearLayout
        android:id="@+id/hg_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hg_tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/hg_tab_home_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="首页"
                android:src="@drawable/ic_hg_home" />

            <TextView
                android:id="@+id/hg_tab_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="首页"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_tab_mine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/hg_tab_mine_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="我的"
                android:src="@drawable/ic_hg_mine" />

            <TextView
                android:id="@+id/hg_tab_mine_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/hg_mine"
        layout="@layout/view_hongguo_mine"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="50dp"
        android:visibility="gone" />

    <!-- 三杠小抽屉：侧边压在刷剧页上，半幅、高度随内容；不再整屏开页。 -->
    <FrameLayout
        android:id="@+id/hg_drawer_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/hg_drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000" />

        <include
            android:id="@+id/hg_drawer"
            layout="@layout/view_hongguo_drawer"
            android:layout_width="272dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start" />
    </FrameLayout>
</FrameLayout>
