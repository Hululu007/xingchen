<?xml version="1.0" encoding="utf-8"?>
<!-- 红果流内侧滑详情面板（批四卡 16）：官方 AbsSeriesLeftSlideDetail
     Fragment／VideoFeedRightSlideFragment 的轻量详情路——面板内嵌详情
     本体、先看详情再决定是否进全页。咱家构成＝轻量详情（封面/剧名/
     标签/简介/集数＋追更态＋选集与全页详情两入口），数据只用详情回包
     实有字段；触发手势方向/阈值与面板宽度占比官方未抠到，本面由
     信息区点入唤出、宽度为自家值（账 hongguo-batch4-fill）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF2A211A"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="48dp"
    android:paddingEnd="18dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hg_dp_cover"
            android:layout_width="76dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_hg_detail_cover"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hg_dp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hg_dp_subline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hg_dp_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_dp_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:lineSpacingExtra="5dp"
        android:maxLines="5"
        android:textColor="#D9FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_dp_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 追更态（读追剧架正源，批二口径）：星＋文案，两态翻转 -->
    <LinearLayout
        android:id="@+id/hg_dp_follow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_hg_detail_card"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hg_dp_follow_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="追更"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hg_dp_episodes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_hg_detail_card"
            android:gravity="center"
            android:text="选集"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hg_dp_full"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hg_detail_play"
            android:gravity="center"
            android:text="查看详情"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
