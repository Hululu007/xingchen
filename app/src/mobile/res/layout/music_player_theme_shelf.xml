<?xml version="1.0" encoding="utf-8"?>
<!-- 黑胶唱片架主题（批 3 D 路，施工图 §5）：纯色底 #F1F0ED、无流体/糊底。
     顶行构成照瓜子 RecordShelfPlayer 源码：左收起键＋居中标题列＋右播放工具键
     （任务简述的「左标题 600＋右歌词键/设置键」与源码不符，报告已注明待裁）。
     舞台高由代码按 stage−23dp 在布局期定死（X-14）；歌词面顶齐舞台底、圆角下 24 上 0。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1F0ED"
    android:orientation="vertical">

    <!-- 顶行 64dp、横垫 16dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/tpBtnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_collapse"
            android:padding="12dp"
            android:src="@drawable/ic_music_chevron_down" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="#FF252522"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tpArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FF86857E"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tpBtnTools"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_tools"
            android:padding="12dp"
            android:src="@drawable/ic_music_more" />
    </LinearLayout>

    <!-- 舞台：宽 match、高代码定死（stage−23dp）；3 槽横滑与点唱片收藏在视图内处理 -->
    <com.fongmi.android.tv.ui.music.ShelfStageView
        android:id="@+id/tpShelfStage"
        android:layout_width="match_parent"
        android:layout_height="240dp" />

    <!-- 歌词面：顶齐舞台底、余高权重、内垫 (10,12,12) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_shelf_lyric_face">

        <com.fongmi.android.tv.ui.music.ShelfLyricView
            android:id="@+id/tpShelfLyric"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp" />
    </FrameLayout>

    <!-- 进度区：横垫 28dp；时间 10sp；轨 2dp（底轨 Ink×0.12、填充 h0，代码刷色） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:paddingHorizontal="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tpShelfPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF86857E"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tpShelfDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF86857E"
                android:textSize="10sp" />
        </LinearLayout>

        <com.fongmi.android.tv.ui.music.CdSeekBarView
            android:id="@+id/tpShelfSeek"
            android:layout_width="match_parent"
            android:layout_height="10dp" />
    </LinearLayout>

    <!-- 主控行 76dp、横垫 20dp、纵向偏移 −12dp、末尾 8dp 垫：键盒 48/48/68/48/48、图标 24/32/52/32/24；
         间距＝GZ SpaceBetween（两端贴边、余量四等分到键间），以四个等权 spacer 实现 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:translationY="-12dp">

        <ImageView
            android:id="@+id/tpShelfBtnMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_mode"
            android:padding="12dp"
            android:src="@drawable/ic_music_sequential" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpShelfBtnPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_prev"
            android:padding="8dp"
            android:src="@drawable/ic_music_prev" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpShelfPlay"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@string/music_play_pause"
            android:padding="8dp"
            android:src="@drawable/ic_music_pause" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpShelfBtnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_next"
            android:padding="8dp"
            android:src="@drawable/ic_music_next" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpShelfBtnQueue"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_queue"
            android:padding="12dp"
            android:src="@drawable/ic_music_queue" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />
</LinearLayout>
