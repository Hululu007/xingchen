<?xml version="1.0" encoding="utf-8"?>
<!-- 猜你喜欢页分区头（列表位 2）：「每日精选」＋计数＋右侧「换个顺序」（池是固定三源轮排，只做本地重排）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="18dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_guess_sub"
        android:textColor="#F1F4F5"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGuessSectionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#99FFFFFF"
        android:textSize="12sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnGuessRefresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_capsule"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="换个顺序"
        android:textColor="#1C1C1E"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvGuessRefresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="#636366"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
