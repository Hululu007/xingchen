<?xml version="1.0" encoding="utf-8"?>
<!-- 红果搜索双列卡封面顶部渐变（带圆角版）：渐变值沿官方 amy 原值
     （angle 270、#26000000 到 #01000000）；封面本身带 6dp 圆角，直角
     渐变条压上去会在封面两上角戳出方角，此版只给上两角 6dp 跟封面走。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#01000000"
        android:startColor="#26000000"
        android:type="linear" />
    <corners
        android:topLeftRadius="6dp"
        android:topRightRadius="6dp" />
</shape>
