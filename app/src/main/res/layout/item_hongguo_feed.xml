<?xml version="1.0" encoding="utf-8"?>
<!-- 刷剧页单元：一集一页。布局求平：视频面挂载口＋封面＋右列＋底部信息＋本剧条＋细进度线。
     视频面（PlayerView）由 Activity 全局一份，settle 后移进当前页的 hg_surface_host。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hg_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/hg_surface_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/hg_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hg_bottom_scrim" />

    <TextView
        android:id="@+id/hg_fullscreen_watch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hg_chip"
        android:drawableStart="@drawable/ic_hg_fullscreen"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="全屏观看"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 右列（官方真值：容器 paddingEnd 4dp/paddingTop 7dp、头像 41.5dp、订阅角标 22dp、
         动作间距 12dp、单件高 40dp/图标 32dp/计数在图标下方居中、点赞槽宽 46dp；
         序位照 undecided-dig 的 cv5 动作序（Series 家族）：头像→收藏→评论→点赞→分享；
         分享件 SeriesShareView 在官方缺省 gone（显隐条件未抠到），与官方实拍/
         录屏右列四件（头像/星/评论/心）一致——咱家同置 gone 保留组件不常显；
         分享件无计数时图标下显「分享」二字＝官方 SeriesShareView 的
         getShareCountText 缺省文案，图标 ic_hg_share 为自绘同形（已登记 strip 清单）） -->
    <LinearLayout
        android:id="@+id/hg_right_rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="58dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="7dp">

        <FrameLayout
            android:id="@+id/hg_avatar_box"
            android:layout_width="41.5dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/hg_avatar"
                android:layout_width="41.5dp"
                android:layout_height="41.5dp"
                android:layout_gravity="top|center_horizontal"
                android:contentDescription="作者头像" />

            <TextView
                android:id="@+id/hg_avatar_initial"
                android:layout_width="41.5dp"
                android:layout_height="41.5dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_hg_avatar_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_follow_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_hg_follow_badge"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/hg_act_fav"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="收藏"
                android:src="@drawable/ic_hg_star" />

            <TextView
                android:id="@+id/hg_fav_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_comment"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="评论"
                android:src="@drawable/ic_hg_comment" />

            <TextView
                android:id="@+id/hg_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_like"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="点赞"
                android:src="@drawable/ic_hg_heart" />

            <TextView
                android:id="@+id/hg_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_act_share"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="分享"
                android:src="@drawable/ic_hg_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="分享"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hg_danmaku_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="158dp">

        <TextView
            android:id="@+id/hg_danmaku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hg_chip"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="弹"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- 关态斜杠（集流页官方实拍 113558：弹幕关时「弹」带斜杠常显，
             与官方弹幕关图标的三态画法同义；只集流模式用） -->
        <View
            android:id="@+id/hg_danmaku_slash"
            android:layout_width="30dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="#FFFFFF"
            android:rotation="-45"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hg_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="50dp"
        android:orientation="vertical">

        <!-- 返回指定集引导筹（官方 ctm 定版：高 24dp、底 #33FFFFFF 圆角
             8dp、图标 16dp、文案 12sp 白、尾箭头 10dp）：本剧有断点且断点
             集不在第一集时才出（官方触发链定版），文案串「从第1集开始看」，
             点它回第一集从头播；只集流模式出 -->
        <LinearLayout
            android:id="@+id/hg_guide_chip"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hg_guide_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="从第1集开始看"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_catalog_arrow" />
        </LinearLayout>

        <TextView
            android:id="@+id/hg_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 集流作者行（官方 InfoPanel 作者行 cuc 定版）：头像 30dp 圆形＋
             作者名 16sp 粗＋箭头 8×16＋关注钮（底白 solid 圆角 4dp、文案
             「关注」10sp 粗橘 #FFFA7705、内距 H4/V3；未关注且有作者 uid
             才亮，已关注/无 uid 不亮——与官方 fox 缺省 gone 同向）。
             只集流模式出；流页走上面的 hg_author 纯文本行（流页实拍同此） -->
        <LinearLayout
            android:id="@+id/hg_author_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hg_info_avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_detail_arrow" />

            <TextView
                android:id="@+id/hg_follow_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hg_follow_mini"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3dp"
                android:text="关注"
                android:textColor="#FFFA7705"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 系列剧款（账 §5/§3）：多季系列条目的另一副样子，默认藏；
             胶囊条＝系列剧入口（与剧条/左滑同去处），角标＋剧名、标签筹一排在其下 -->
        <LinearLayout
            android:id="@+id/hg_series_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/hg_album_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hg_play" />

                <TextView
                    android:id="@+id/hg_album_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="›"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_series_title_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hg_badge_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hg_badge"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hg_series_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tags_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 集流标题行（官方 InfoPanel 标题位）：角标筹＋剧名 20sp 粗。
             只集流非专辑款出（专辑款用系列剧款内的标题行、流页不设此行——
             流页标题在剧条里）；此前集流普通款摞里没有标题行、是缺件。
             点它开选集单（与选集条同去处） -->
        <LinearLayout
            android:id="@+id/hg_ep_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/hg_ep_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hg_badge"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_ep_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 标签筹行（官方 InfoPanel 摞内常设行 hrq：数据有才出筹）：
             此前只有系列剧款里有、普通款有标签也不显——本行给非专辑款用，
             填充逻辑与系列款共用一份 -->
        <LinearLayout
            android:id="@+id/hg_tags_row_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- 热评/主演说行（账 §3.4）：数据有才显，长文带「展开」 -->
        <LinearLayout
            android:id="@+id/hg_hot_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/hg_hot_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hg_hot_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="展开"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/hg_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hg_desc_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="展开"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 次级信息行（官方 InfoHeader 的 recommendReason）：数据一直在
             条目里（recText）但此前从未绑上屏——本批补行。官方承载布局
             未定位，字号/颜色为自定小字（账里标明待核），数据有才显 -->
        <TextView
            android:id="@+id/hg_rec_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 作者声明（账 §3.5）：数据有才显，没有不编 -->
        <TextView
            android:id="@+id/hg_statement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 未上线剧的预约片：回包带 appointment 才亮（适配器控制），文案照官方串（点击预约/已预约＋上线文案） -->
        <TextView
            android:id="@+id/hg_reserve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hg_chip"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 底部行：选集条＋全屏方钮。材料/几何按模式分工（适配器 bind 时切换，
         本布局缺省值＝集流形态）：集流＝官方 CatalogView 材料（cto/ctp 定版：
         条高 40dp、底 #1AFFFFFF 圆角 8dp、文案 14sp 粗起点 16dp、尾箭头图
         20×10、文案＝前缀＋状态段不带剧名——官方实拍 113558 证）；行侧距
         12dp/底距 8dp 照实拍。流页＝全宽深底 strip＋播放图标＋「›」（官方流页
         实拍 113482 同形态，与集流是两副面孔，不共用材料）。
         全屏方钮只集流竖屏出（用户亲点：按下进横屏全屏，与全屏观看筹同去处；
         清屏态唯一留屏件、且变淡防烧屏） -->
    <LinearLayout
        android:id="@+id/hg_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hg_series_bar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hg_catalog_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hg_series_play_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_play"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hg_series_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/hg_series_arrow"
                android:layout_width="20dp"
                android:layout_height="10dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_catalog_arrow" />

            <TextView
                android:id="@+id/hg_series_arrow_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="›"
                android:textColor="#CCFFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/hg_fs_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_hg_catalog_bar"
            android:contentDescription="全屏观看"
            android:padding="10dp"
            android:src="@drawable/ic_hg_expand"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hg_progress_box"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="bottom">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:background="#33FFFFFF" />

        <View
            android:id="@+id/hg_progress_fill"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:background="#FFFFFF"
            android:transformPivotX="0dp"
            android:transformPivotY="1dp" />

        <View
            android:id="@+id/hg_progress_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_hg_progress_dot" />
    </FrameLayout>

    <ImageView
        android:id="@+id/hg_pause_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:src="@drawable/ic_hg_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hg_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hg_chip"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="加载失败，点按重试"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
