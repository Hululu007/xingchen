<?xml version="1.0" encoding="utf-8"?>
<!-- 榜单列表独立页（拆页 p5，2026-10-25）：从旧列表壳的 charts 模式拆出。
     构成照旧页 charts 模式实际引用子集：顶栏（标题＋搜索钮）＋大标题行（标题代码隐藏、
     只留「N 个榜单」计数＋刷新钮）＋工具栏（播放全部／顺序播放代码恒隐藏、只留排序键）
     ＋列表（焦点卡＋分区头＋普通卡，行布局复用 item_music_chart_*）＋空态覆盖层。
     根与背景层照旧列表布局：根底 home_bg_page 兜底＋MusicGlassBackgroundView 铺满。
     无返回箭头（铁律），关页走系统返回；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/music_charts"
                android:textColor="#1C1C1E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/music_search"
                android:padding="12dp"
                android:src="@drawable/ic_music_search" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/bigTitleRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBigTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBigCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#9AA7B8"
                android:textSize="20sp" />

            <!-- 榜单列表页手动刷新（GZ TopListRefreshButton）：点按重新拉取 -->
            <ImageView
                android:id="@+id/btnChartsRefresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:padding="4dp"
                android:src="@drawable/ic_action_refresh"
                android:tint="#9AA7B8"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivPlayAllIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_shuffle"
                    android:tint="#FA243C" />

                <TextView
                    android:id="@+id/tvPlayAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_shuffle_play"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlaySeq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FA243C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_play_all_order"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnSort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/music_sort_default"
                android:padding="12dp"
                android:src="@drawable/ic_music_sort" />

            <TextView
                android:id="@+id/tvSortCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA7B8"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- 状态层（空状态与「正在加载…」共用）：根 FrameLayout 覆盖层、layout_gravity 居中锚定 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA7B8"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
