<?xml version="1.0" encoding="utf-8"?>
<!--
     音乐搜索独立页（2026-10-25 用户定案）：构成只有——
     标题「搜索」＋搜索框行（玻璃胶囊＋取消）＋搜索历史（仅初始态有存量时摆）
     ＋结果列表＋状态层（加载／空态）。没有分类页签、没有源横排 chips、
     没有工具行（随机／播放全部／来源下拉／排序）、没有组筛选条、
     没有落地页热门／猜你想搜（定案摘除，不许回潮）。
     结果按源分段排（2026-10-26 他亲点）：同源一段、段序＝源快照序、段内回包序。
     皮走液态玻璃：根底 home_bg_page 兜底＋MusicGlassBackgroundView 铺满
     （与首页同一套背景），玻璃件用全 App 共用 bg_music_glass_* 一套。
     无返回箭头（铁律），关页走系统返回／搜索框行「取消」；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/music_search"
                android:textColor="#1C1C1E"
                android:textSize="26sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_music_glass_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_search"
                    android:tint="#8E8E93" />

                <EditText
                    android:id="@+id/etKeyword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/music_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#1C1C1E"
                    android:textColorHint="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/searchCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:text="@string/music_search_cancel"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 搜索历史（2026-10-25 用户点名补回，只要历史、不要热门／猜你想搜）：
             仅初始态且有历史时由代码显示——标题行（历史记录＋清除）＋胶囊流，点词即搜 -->
        <LinearLayout
            android:id="@+id/historyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="历史记录"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/historyClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="清除"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.fongmi.android.tv.ui.widget.FlowLayout
                android:id="@+id/historyFlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- 搜索页构成定案（2026-10-25 他亲口）：只留标题＋搜索框＋取消＋结果列表＋搜索历史；
             分类页签与源横排 chips 已按定案摘除（扫描 M25），搜索恒走单曲＋全源聚合 -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- 状态层（空状态与「正在加载…」共用）：根 FrameLayout 覆盖层、layout_gravity 居中锚定，不随键盘挤位 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA7B8"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
