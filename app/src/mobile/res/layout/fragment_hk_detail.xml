<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/fragment_hk_detail_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/hk_capsule_light"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="20dp">

                <ImageButton
                    android:id="@+id/btn_back_detail"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_hk_back" />

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="#101216"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 8.83 原版加载指示：顶部细进度线（同列表页），没有中间大转圈 -->
            <ProgressBar
                android:id="@+id/progress_detail_top"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="#D4A017"
                android:visibility="gone" />

            <!-- 8.83 原版：详情页走通用列表渲染器（FilmListActivity + ArticleListAdapter），
                 不再用专用定制布局。条目按 col_type 渲染：detail_header/long_text/flex_button -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tv_detail_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="加载失败，点我重试"
                android:textColor="#101216"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>