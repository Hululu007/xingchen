<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏页选集侧抽屉（官方 caa 原文：右锚 244dp 板、底 rl＝#FF161616 左
     圆角 16dp；关闭图标 24dp、距上/距左各 16dp；标题「选集」18sp 白
     （@dimen/om＋@color/q）整板水平居中、与关闭图标同顶；列表自板顶
     64dp 起）。集格与选集单同源（item_hongguo_episode）；列数按 244dp
     宽适配为 3 列（官方抽屉内列数未抠到，自家适配）。注意：集格文字色
     由 HgEpisodeDrawer 按浅底取值，深板下需其同步换深底色（宿主侧配套，
     不在本布局内）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hg_land_ep_panel"
    android:elevation="1dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/hg_ld_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="16dp"
            android:contentDescription="关闭"
            android:src="@drawable/ic_hg_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:text="选集"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hg_ld_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1" />
</LinearLayout>
