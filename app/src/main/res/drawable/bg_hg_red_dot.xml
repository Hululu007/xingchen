<?xml version="1.0" encoding="utf-8"?>
<!-- 追更红点（官方 follow 页签红点件 skin_follow_tab_circle_red_dot 定版：
     oval、填充 #FFFA6725、1dp 描边 #FFF7F5F2；官方件自带 14dp 内在尺寸，
     咱家载体是子筛筹、描点位 10dp 压筹右上角内侧，色与描边照官方原值）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFA6725" />
    <stroke
        android:width="1dp"
        android:color="#FFF7F5F2" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>
