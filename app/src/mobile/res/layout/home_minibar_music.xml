<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐迷你条（只在音乐首页显示，白名单在 ListenMiniBar）：暗磨砂圆角胶囊（2026-10-27 试点）——
     左 56dp 方框（进度环满框＋45dp 圆形封面居中，播放转圈）＋歌名＋下一首＋右侧 56dp 大圆播放键。
     条底先挂 home_bg_minibar 作 XML 可见下限，运行时由 ListenMiniBar 换同源 MusicFrostDrawable(999)；
     播放键先挂 bg_home_frost_circle 作下限，运行时同换 MusicFrostDrawable(999)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_bg_minibar"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <com.fongmi.android.tv.ui.minibar.HomeProgressRingView
            android:id="@+id/homeRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/homeCover"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/homeNext"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/home_next"
        android:padding="11dp"
        android:src="@drawable/ic_music_next" />

    <ImageView
        android:id="@+id/homePlay"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_home_frost_circle"
        android:contentDescription="@string/home_play"
        android:elevation="4dp"
        android:padding="19dp"
        android:src="@drawable/ic_music_play" />
</LinearLayout>
