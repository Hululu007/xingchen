<?xml version="1.0" encoding="utf-8"?>
<!-- 我的歌单列表独立页（拆页 p8，2026-10-25）：从 MusicListActivity 的 sheets 模式拆出。
     构成照旧页 sheets 模式实际引用子集：搜索条（操作行搜索钮切换显隐）＋GZ 页头（YOUR PLAYLISTS
     ＋大标题＋多选／全部 pill）＋操作行（新建／导入／搜索圆钮）＋歌单页空态块＋工具条
     （仅多选态可见：删除所选）＋列表（歌单行复用 item_music_playlist_row）＋空态覆盖层（加载态共用）。
     旧页顶栏在 sheets 下恒隐藏、本页不带。
     根与背景层照 activity_music_list.xml：根底 home_bg_page 兜底＋MusicGlassBackgroundView 铺满。
     无返回箭头（铁律），关页走系统返回；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_music_glass_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_search"
                    android:tint="#8E8E93" />

                <EditText
                    android:id="@+id/etKeyword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/music_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#1C1C1E"
                    android:textColorHint="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/searchCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:text="@string/music_search_cancel"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 歌单页头：GZ 页头 YOUR PLAYLISTS 10sp＋我的歌单 28sp＋右上多选／全部 pill -->
        <LinearLayout
            android:id="@+id/sheetsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="YOUR PLAYLISTS"
                    android:textColor="#8E8E93"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/sheetsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontWeight="800"
                    android:letterSpacing="-0.03"
                    android:textColor="#1C1C1E"
                    android:textSize="28sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSheetsMulti"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_overview"
                android:drawableStart="@drawable/ic_music_check_14"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="多选"
                android:textColor="#1C1C1E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSheetsFilter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_overview"
                android:drawableStart="@drawable/ic_music_stack_14"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="全部 ▾"
                android:textColor="#1C1C1E"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 操作行：深色 pill 新建＋浅色 pill 导入＋44dp 搜索圆钮，行内间距 10dp -->
        <LinearLayout
            android:id="@+id/sheetsOpRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSheetsNew"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_sheets_new"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="＋ 新建歌单"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSheetsImport"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_light22"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="导入歌单"
                android:textColor="#1C1C1E"
                android:textSize="14sp" />

            <!-- GZ 的搜索钮是 plain 放大镜、没有圆圈描边底 -->
            <ImageView
                android:id="@+id/btnSheetsSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:padding="12dp"
                android:src="@drawable/ic_music_search" />
        </LinearLayout>

        <!-- 歌单页空态：瓜子 EmptyPlaylistsHint 口径（图标 28dp、主标题 14sp、副标题 12sp、块顶 24dp）；
             搜索过滤无匹配时同块改纯文本态（无图标），不走通用 empty 覆盖层。 -->
        <LinearLayout
            android:id="@+id/sheetsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/sheetsEmptyIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_music_playlist_empty" />

            <TextView
                android:id="@+id/sheetsEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/music_no_playlist"
                android:textColor="#9A9AA0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sheetsEmptySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/music_no_playlist_hint"
                android:textColor="#D99A9AA0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 工具条：歌单页仅多选态可见（删除所选走 btnPlayAll 位）；顺序播放／排序键照旧布局保留、
             多选态下排序键隐藏，口径与旧页一致 -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btnPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivPlayAllIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_shuffle"
                    android:tint="#FA243C" />

                <TextView
                    android:id="@+id/tvPlayAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_shuffle_play"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlaySeq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FA243C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_play_all_order"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSourceFilter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_overview"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="全部来源 ▾"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnSort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/music_sort_default"
                android:padding="12dp"
                android:src="@drawable/ic_music_sort" />

            <TextView
                android:id="@+id/tvSortCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA7B8"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- 状态层（「正在加载…」用）：根 FrameLayout 覆盖层、layout_gravity 居中锚定 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA7B8"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
