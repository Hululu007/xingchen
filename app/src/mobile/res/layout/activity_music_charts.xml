<?xml version="1.0" encoding="utf-8"?>
<!-- 榜单列表独立页（拆页 p5，2026-10-25）：从旧列表壳的 charts 模式拆出。
     构成：顶栏（只留搜索钮）＋列表（焦点卡＋分区头＋普通卡，行布局复用
     item_music_chart_*）＋空态覆盖层。2026-10-26 他亲点：标题行与焦点卡之间整带
     （「N 个榜单」计数行＋刷新钮＋排序箭头及其高度）全删，焦点卡直接顶到顶栏下；
     标题行保持他截图里的样子不增不减，本页不另补标题视图。
     根与背景层照旧列表布局：根底 home_bg_page 兜底＋MusicGlassBackgroundView 铺满。
     无返回箭头（铁律），关页走系统返回；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/music_search"
                android:padding="12dp"
                android:src="@drawable/ic_music_search" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- 状态层（空状态与「正在加载…」共用）：根 FrameLayout 覆盖层、layout_gravity 居中锚定 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA7B8"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
