<?xml version="1.0" encoding="utf-8"?>
<!-- 封面卡片 cover_immersive（批 3，照施工图 §3 全表）：
     顶 42dp → 歌名（高 30）→ 隔 4 → 歌手（高 22）→ 隔 22 → 封面权重区（横距 24）→ 隔 14 → 玻璃条 → 底 12。
     默认态：三卡叠放＋玻璃条（收藏／单行歌词／播放），无进度条；
     点封面展开：封面区换成歌词（居中）或信息卡＋四玻璃键＋Scrubber，玻璃条换「返回到封面模式」。
     与经典共用 id 的视图类型逐项一致（tpTitle/tpArtist/tpCover/tpCoverExit/tpLyricView/tpScrubber 等）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="42dp" />

    <TextView
        android:id="@+id/tpTitle"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:ellipsize="end"
        android:fontWeight="800"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineHeight="26dp"
        android:maxLines="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="#F5FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <TextView
        android:id="@+id/tpArtist"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:ellipsize="end"
        android:fontWeight="500"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineHeight="18dp"
        android:maxLines="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="#8CFFFFFF"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="22dp" />

    <!-- 封面权重区：横距 24dp；内含默认态三卡叠放与展开态列（代码切换） -->
    <FrameLayout
        android:id="@+id/tpCoverArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_weight="1">

        <com.fongmi.android.tv.ui.music.CoverStackView
            android:id="@+id/tpCoverStack"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 左后卡：×0.93、旋转 −4°、偏移 (−12,−18)dp -->
            <ImageView
                android:id="@+id/tpCoverBack1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:background="@drawable/bg_cover_card_back"
                android:scaleType="centerCrop" />

            <!-- 右后卡：×0.93、旋转 +4°、偏移 (12,−14)dp（CoverStackView 布局） -->
            <ImageView
                android:id="@+id/tpCoverBack2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:background="@drawable/bg_cover_card_back"
                android:scaleType="centerCrop" />

            <!-- 出场卡层：切歌换卡 ThreeCard 出场（滑出＋淡出＋缩放→0.92），平时 gone -->
            <ImageView
                android:id="@+id/tpCardExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 前卡：点按切换展开／信息两态；双击收藏／长按工具面板与经典同口径 -->
            <FrameLayout
                android:id="@+id/tpCoverWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/tpCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/tpCoverExit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </com.fongmi.android.tv.ui.music.CoverStackView>

        <!-- 展开态列：歌词／信息视口（weight 余高）→ 四玻璃键（间距 24）→ 隔 12 → Scrubber -->
        <LinearLayout
            android:id="@+id/tpExpandedCol"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 展开歌词：居中对齐；高度由代码按槽高公式（间隙×3＋行高×4）设定 -->
                <com.fongmi.android.tv.ui.music.CoverLyricView
                    android:id="@+id/tpLyricView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <!-- 信息卡：圆角 22＋黑 0.35 层（bg_cover_info_card），内容由代码按 §3 信息卡口径构建 -->
                <ScrollView
                    android:id="@+id/tpInfoScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_cover_info_card"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/tpInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp" />
                </ScrollView>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tpBtnPrev"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_prev"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_prev"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/tpBtnQueue"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_queue"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_queue"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/tpBtnInfo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_song_info"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_info"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/tpBtnNext"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_next"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_next"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <!-- 展开态 Scrubber：与经典同构（顶行双筹＋时间＋轨），走 Scrubber 默认口径 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tpPositionTop"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.018"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tpChipQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_player_chip"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tpQualityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.054"
                                android:maxLines="1"
                                android:textColor="#B8FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tpChipLyric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_player_chip"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <TextView
                                android:id="@+id/tpLyricChipText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.054"
                                android:maxLines="1"
                                android:text="@string/music_lyric_chip_line"
                                android:textColor="#B8FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tpDurationTop"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.018"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.fongmi.android.tv.ui.music.MusicScrubberView
                    android:id="@+id/tpScrubber"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <!-- 玻璃条（默认态）：高 48dp、圆角 22dp、横距 24dp、白渐变 0.26→0.08 无深色实底、内边距左右 16dp；
         内：收藏键盒 40dp 图标 20dp／单行歌词 13sp 白 0.92 居中 500 无斜度／播放键盒 40dp（图标 24dp，瓜子 CoverLyricGlassBar 实读）。
         信息态整条换「返回到封面模式」13sp（tpGlassBack）。 -->
    <LinearLayout
        android:id="@+id/tpGlassBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_cover_glass_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/tpGlassFav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_favorite"
            android:padding="10dp"
            android:src="@drawable/ic_music_heart"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tpGlassLyric"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontWeight="500"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#EBFFFFFF"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/tpGlassPlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/pl_play_pause"
            android:padding="8dp"
            android:src="@drawable/ic_music_pause"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tpGlassBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontWeight="500"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/music_info_back_cover"
            android:textColor="#EBFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />
</LinearLayout>
