<?xml version="1.0" encoding="utf-8"?>
<!-- 红果搜索历史块头：照官方 as1（fqreader_layout_reader_search_history）——
     左「搜索历史」16sp 粗黑＋右 20dp 图标位。官方图标（ave）是编辑/删除位、
     其点亮行为在 KMP 面板里未抠到；自家借此位放清除动作（沿此前底部
     「清除历史记录」行的语义），构成照 as1、行为差异见汇总留痕。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="搜索历史"
        android:textColor="#FF000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/hg_hist_clear"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="清除历史"
        android:src="@drawable/ic_hg_search_delete" />
</LinearLayout>
