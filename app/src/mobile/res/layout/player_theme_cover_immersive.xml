<?xml version="1.0" encoding="utf-8"?>
<!-- 封面卡片主题：歌名居中置顶；中央大圆角封面卡（宽高比 0.65 口径由权重区近似，叠卡边用一层偏移半透明同图垫底）；底部玻璃胶囊（收藏＋当前歌词一行＋播放钮）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="18dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/tpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tpArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp" />

    <!-- 封面卡区：后层同图偏移垫底做叠卡边，前层主卡 -->
    <FrameLayout
        android:id="@+id/tpCoverWrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/tpCoverBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="14dp"
            android:alpha="0.35"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/tpCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="10dp"
            android:elevation="12dp"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- 底部玻璃胶囊：收藏心＋当前歌词一行（点按开全屏歌词页）＋播放/暂停 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_player_glass_capsule"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/tpBtnFav"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/music_favorite"
            android:padding="11dp"
            android:src="@drawable/ic_music_heart" />

        <TextView
            android:id="@+id/tpLyricLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#A6FFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/tpPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_player_play_ring"
            android:padding="14dp"
            android:src="@drawable/ic_music_pause"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
