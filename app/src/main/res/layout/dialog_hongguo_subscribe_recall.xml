<?xml version="1.0" encoding="utf-8"?>
<!-- 预约上线召回弹窗（官方 SubscribeRecallDialog 的自家等价）：底部单，
     标题（预约剧已上线／%d 部预约剧已上线）＋条目列表＋底部链接
     「去「我的-预约」查看所有已预约剧」。白底圆角顶与选集单同族
     （bg_hg_ep_sheet），不搞 WebView、不搞素框；链接底距在代码里叠
     系统导航区真实高度（手势让位规矩）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hg_ep_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hg_ep_grab" />

    <TextView
        android:id="@+id/hg_recall_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#FF111111"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hg_recall_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/hg_recall_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:text="去「我的-预约」查看所有已预约剧"
        android:textColor="#FFFA7705"
        android:textSize="14sp" />

</LinearLayout>
