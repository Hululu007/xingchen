<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐收藏独立页（拆页 p4，2026-10-25）：从 MusicListActivity 的 favorite 模式拆出。
     构成照旧页 favorite 模式实际引用子集：顶栏（旧 favorite 模式被英雄卡顶替、代码隐藏）
     ＋收藏英雄卡（拼贴＋大标题＋N 首＋播放全部／随机播放／多选＋搜索框＋续播卡＋区头；清空钮收藏恒隐藏、仅占位复用）
     ＋工具栏（多选态删除所选复用 btnPlayAll＋排序键）＋列表＋空态覆盖层。
     根与背景层照 activity_music_list.xml：根底 home_bg_page 兜底＋MusicGlassBackgroundView 铺满。
     无返回箭头（铁律），关页走系统返回；界面只放名字和状态，无介绍文字。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/music_playlist"
                android:textColor="#1C1C1E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/music_search"
                android:padding="12dp"
                android:src="@drawable/ic_music_search"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- 收藏英雄卡（GZ：封面拼贴 76dp＋大标题 28sp＋N 首 12sp＋
             播放全部／随机播放＋搜索框＋续播卡；收藏页清空钮恒隐藏） -->
        <LinearLayout
            android:id="@+id/favHistHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/favHistMosaic"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/card_music"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivMosaic0"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/ivMosaic1"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:scaleType="centerCrop" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivMosaic2"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/ivMosaic3"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:scaleType="centerCrop" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFavHistLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.16"
                        android:text="YOUR FAVORITES"
                        android:textColor="#8E8E93"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvFavHistTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.03"
                        android:textColor="#1C1C1E"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvFavHistCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#8E8E93"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnFavHistPlayAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_dark"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="播放全部"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnFavHistShuffle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_overview"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="随机播放"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnFavHistMulti"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_overview"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="多选"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnFavHistClear"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_overview"
                    android:visibility="gone"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="清空"
                    android:textColor="#FA243C"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/home_bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etFavHistSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索喜欢的歌曲"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="#1C1C1E"
                    android:textColorHint="#8E8E93"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnFavHistClearSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_close"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/favHistResume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_music_glass_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTINUE · 继续播放"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvFavHistResumeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFavHistResumeState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 列表区头（瓜子 SectionHeader：收藏「全部歌曲」／搜时「搜索结果」；
                 放英雄卡块内静态行，不进 adapter，空列表时代码隐藏） -->
            <TextView
                android:id="@+id/tvFavHistSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#1C1C1E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnPlayAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivPlayAllIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_shuffle"
                    android:tint="#FA243C" />

                <TextView
                    android:id="@+id/tvPlayAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_shuffle_play"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlaySeq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/card_music"
                    android:padding="8dp"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FA243C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/music_play_all_order"
                    android:textColor="#9AA7B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnSort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/music_sort_default"
                android:padding="12dp"
                android:src="@drawable/ic_music_sort" />

            <TextView
                android:id="@+id/tvSortCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA7B8"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- 状态层（空状态与「正在加载…」共用）：根 FrameLayout 覆盖层、layout_gravity 居中锚定 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA7B8"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
