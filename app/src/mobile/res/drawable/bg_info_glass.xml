<?xml version="1.0" encoding="utf-8"?>
<!-- 歌曲信息玻璃卡面（批 3，Apple 信息页 GlassSection／封面卡片信息卡共用）：
     瓜子侧是 LiquidGlass 渲染（描边黑 0.04／0.08 在深底不可见），此处以白 0.08 底＋白 0.10 描边近似呈现，圆角 20dp（GlassSection／HeroCard 实读）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#14FFFFFF" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
