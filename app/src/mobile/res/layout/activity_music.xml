<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐首页（第十稿定稿构成；本文件为首页收官从零重写，2026-10-25）：
     液态玻璃全屏背景（MusicGlassBackgroundView 独立一层）＋滚动内容层。
     顺序定死：标题 → 搜索胶囊＋⋮ → 通知权限提示条（未授权才显） → 五快捷独立玻璃片
     → 继续播放 → 三彩卡 → 心情电台卡 → 榜单卡 → 聆听报告卡 → 底部留白（给悬浮迷你条）。
     离边 16dp 由 MusicActivity 代码打在滚动层（左右 16dp、顶＝状态栏高＋12dp、底 16dp），
     背景层不吃内边距、全屏铺满；本文件不许再写根内边距。
     无返回箭头（铁律），界面只放名字和状态，无介绍文字。
     底部迷你条是 ListenMiniBar 悬浮条（只在音乐首页显示），本页不内嵌。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 液态玻璃全屏背景：单一实现 MusicGlassBackgroundView，后批各页同款复用 -->
    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/homeGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<ScrollView
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:scrollbars="none">
    <!-- ScrollView 量测链是不定高（UNSPECIFIED）：三彩卡里的光晕（match_parent）首遍量 0
         不撑卡高，卡高由文字列定；FrameLayout 二次测量再把光晕铺满卡面。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- ⓪ 顶行：渐变标题字（24sp／800／字距 -0.029／斜度 skewX(-0.12f) 代码侧）＋小金星
         ＋右上角黑胶唱片斜探出画面；顶距＝代码垫顶（状态栏高＋12dp）＋标题上边距 8dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="2dp"
            android:text="星辰音乐"
            android:textColor="#1C1C1E"
            android:textSize="24sp"
            android:letterSpacing="-0.029"
            android:fontWeight="800"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="★"
            android:textColor="#FFF5A623"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/homeVinyl"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="-14dp"
            android:layout_marginEnd="-10dp"
            android:background="@drawable/bg_music_home_vinyl"
            android:rotation="24" />
    </LinearLayout>

    <!-- ① 搜索胶囊（高 48dp、玻璃圆角 24dp）＋右侧 ⋮ 独立点击区；上距 8dp -->
    <LinearLayout
        android:id="@+id/homeSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_music_glass_search"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/home_ic_search" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/home_search_hint"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:fontWeight="500" />

        <ImageView
            android:id="@+id/homeBtnMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_more"
            android:padding="10dp"
            android:src="@drawable/home_ic_more_vert" />
    </LinearLayout>

    <!-- 通知权限提示条：没授权时才出现（默认 gone，onResume 按权限实读切换）；深底白字＋黄钮 -->
    <LinearLayout
        android:id="@+id/notifPermStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/home_bg_notif_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="通知权限未开启，后台放歌时通知栏不会显示播放条"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notifPermGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/home_bg_notif_btn"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="去开启"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ② 五快捷：五片独立玻璃片一行（第十稿定稿形态：bg_music_glass_chip、片间 6dp、
         本地音乐居中第三；2026-10-21 的「一卡五入」旧摆法已被第十稿改掉，
         1.4.27 查修批曾误并回一卡，收官按第十稿改回五片）；格内彩色图标＋名字＋真实数量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/homeQuickFavorite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_music_glass_chip"
            android:elevation="2dp"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_favorite" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_favorite"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickSheets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_music_glass_chip"
            android:elevation="2dp"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_sheets" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_sheets"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountSheets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_music_glass_chip"
            android:elevation="2dp"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_device" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_device"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickRecent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_music_glass_chip"
            android:elevation="2dp"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_recent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_recent"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickDownload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_music_glass_chip"
            android:elevation="2dp"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_download"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 继续播放白卡：头行「继续播放」标＋右上圆播放键；下行最近播放前 4 首封面横排
         （代码填充 homeContinueCovers），点封面播该首、圆键续播；零首整卡 GONE 不留空洞 -->
    <LinearLayout
        android:id="@+id/homeContinueCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_music_glass_white_card"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_continue"
                android:textColor="#FA243C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeContinueTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#999999"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/homeContinuePlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_music_continue_play"
                android:clickable="true"
                android:contentDescription="@string/home_play"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_music_play"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeContinueCovers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- ③ 三张渐变入口卡横排（上距 40dp、卡间 10dp）；卡内间隔＝权重 Spacer
         （高＝@dimen/home_entry_icon_spacer 基准参量＋权重 1 撑满），图标底对齐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/homeCardGuess"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_music_glass_entry"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="10dp">

            <com.fongmi.android.tv.ui.view.HomeEntryHaloView
                android:id="@+id/homeHaloGuess"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_guess"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:lineHeight="19dp"
                    android:letterSpacing="-0.029"
                    android:fontWeight="800"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_guess_sub"
                    android:textColor="#8C1C1C1E"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_entry_icon_spacer"
                android:layout_weight="1" />

            <!-- 封面堆：三张封面错位叠放，数据由代码填（榜单前 3 封面，无数据时回落历史封面，再无则不显） -->
            <FrameLayout
                android:id="@+id/homeGuessStack"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/homeGuessCover3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:rotation="10"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeGuessCover2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:alpha="0.8"
                    android:contentDescription="@null"
                    android:rotation="-6"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeGuessCover1"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|start"
                    android:contentDescription="@null"
                    android:rotation="-12"
                    android:scaleType="centerCrop" />
            </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/homeCardCharts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_music_glass_entry"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="10dp">

            <com.fongmi.android.tv.ui.view.HomeEntryHaloView
                android:id="@+id/homeHaloCharts"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_charts"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:lineHeight="19dp"
                    android:letterSpacing="-0.029"
                    android:fontWeight="800"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_charts_sub"
                    android:textColor="#8C1C1C1E"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_entry_icon_spacer"
                android:layout_weight="1" />

            <!-- 前三名小列表：数据由代码填（当前榜签前 3 名），无数据整列不显 -->
            <LinearLayout
                android:id="@+id/homeCardChartList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/homeCardChart1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3A3A3C"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />

                <TextView
                    android:id="@+id/homeCardChart2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3A3A3C"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />

                <TextView
                    android:id="@+id/homeCardChart3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3A3A3C"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/homeCardShuffle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_music_glass_entry"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="10dp">

            <com.fongmi.android.tv.ui.view.HomeEntryHaloView
                android:id="@+id/homeHaloShuffle"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_shuffle"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:lineHeight="19dp"
                    android:letterSpacing="-0.029"
                    android:fontWeight="800"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeShuffleSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_shuffle_sub"
                    android:textColor="#8C1C1C1E"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_entry_icon_spacer"
                android:layout_weight="1" />

            <!-- 发光播放盘：柔光晕＋深墨盘＋白三角，整卡点按仍进随心听页 -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_music_home_glow_disc" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FFFFFF" />
            </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 心情电台卡（瓜子 MoodRadioPanel：圆角 20dp、横向三色渐变按选中心情换色（代码侧算，
         向白混合 0.08/0.20/0.32）、区头 10sp/600、当前心情大字 22sp/700、文案 11sp、
         波形区宽 0.44 比例×高 92dp、pills 行边距 12/0/12/12dp、pill 高 36dp（代码侧建）、
         播放钮 40dp 圆、横向渐变 tone→向白混合 0.22（代码侧算）；卡前间隔 20dp；
         卡内边距／波形色／钮旁状态文字号未抠到，星辰侧自定 16dp／tone／11sp） -->
    <LinearLayout
        android:id="@+id/homeMoodCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_music_glass_entry"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.56"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="心情电台"
                        android:textColor="#1C1C1E"
                        android:textSize="10sp"
                        android:lineHeight="14dp"
                        android:letterSpacing="0.01"
                        android:fontWeight="600"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_player_chevron_right"
                        android:tint="#1C1C1E" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMoodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#1C1C1E"
                    android:textSize="22sp"
                    android:lineHeight="28dp"
                    android:letterSpacing="-0.018"
                    android:fontWeight="700"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMoodCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#5A5A5E"
                    android:textSize="11sp"
                    android:lineHeight="16dp" />
            </LinearLayout>

            <com.fongmi.android.tv.ui.view.MoodWaveView
                android:id="@+id/moodWave"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="0.44" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/moodPills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvMoodState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#5A5A5E"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/btnMoodPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_music_play" />
        </LinearLayout>
    </LinearLayout>

    <!-- ④ 榜单卡（卡头榜名＋完整榜单、左封面叠放带播放钮、右前 3 名、底榜签行；
         数据只用酷我＋QQ 真榜，签表拉空整卡隐藏；默认 gone，代码按状态显） -->
    <LinearLayout
        android:id="@+id/homeChartCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_music_glass_entry"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeChartTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#141414"
                android:textSize="20sp"
                android:lineHeight="26dp"
                android:letterSpacing="-0.02"
                android:fontWeight="800"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeChartMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/home_chart_more"
                android:textColor="#9A9AA0"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/homeChartMoreIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@null"
                android:src="@drawable/ic_player_chevron_right"
                android:tint="#9A9AA0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeChartContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="90dp">

                <ImageView
                    android:id="@+id/homeChartCover3"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="50dp"
                    android:alpha="0.5"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeChartCover2"
                    android:layout_width="67dp"
                    android:layout_height="67dp"
                    android:layout_marginStart="25dp"
                    android:alpha="0.75"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeChartCover1"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeChartPlay"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/home_bg_chart_play"
                    android:contentDescription="@string/home_chart_play"
                    android:padding="4dp"
                    android:src="@drawable/ic_music_play" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/homeChartRow1"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="#141414"
                        android:textSize="13sp"
                        android:lineHeight="18dp"
                        android:fontWeight="800"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeChartName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="18sp"
                        android:text=" · "
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/homeChartArtist1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeChartRow2"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="#141414"
                        android:textSize="13sp"
                        android:lineHeight="18dp"
                        android:fontWeight="800"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeChartName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="18sp"
                        android:text=" · "
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/homeChartArtist2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeChartRow3"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="#141414"
                        android:textSize="13sp"
                        android:lineHeight="18dp"
                        android:fontWeight="800"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeChartName3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="18sp"
                        android:text=" · "
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/homeChartArtist3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 榜单卡空态：「暂未获取到榜单」12sp／行高 18sp＋「点击重试」11sp／行高 16sp accent 色；签行保留可切榜 -->
        <LinearLayout
            android:id="@+id/homeChartEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineHeight="18sp"
                android:text="@string/wave2_home_chart_empty"
                android:textColor="#8E8E93"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/homeChartEmptyRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineHeight="16sp"
                android:padding="4dp"
                android:text="@string/wave2_home_chart_retry"
                android:textColor="#FA243C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 榜单卡加载态：「正在加载榜单」12sp＋16dp 转圈 -->
        <LinearLayout
            android:id="@+id/homeChartLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="#FA243C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/wave2_home_chart_loading"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeChartTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 聆听报告卡（只用本地数据：播放记录数＋收藏数＋最爱歌手；记录为空时代码隐藏整卡，不编假数据） -->
    <LinearLayout
        android:id="@+id/homeReportCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_music_glass_entry"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wave2_report_title"
            android:textColor="#141414"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeReportStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/homeReportTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 底部留白：给悬浮迷你条让位（条高 76dp＋底边距，手势导航下约 104dp）；定高留白，滚到底时上方卡片正好露在条上方 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="104dp" />
    </LinearLayout>
</ScrollView>
</FrameLayout>
