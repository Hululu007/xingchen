<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐首页 v7 定稿：浅色底／搜索胶囊＋⋮／五快捷白卡／三张渐变入口卡。
     底部迷你条是 ListenMiniBar 悬浮条（只在音乐首页显示），本页不内嵌。
     无返回箭头（铁律），界面只放名字和状态，无介绍文字。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- ① 搜索胶囊条＋右侧 ⋮ -->
    <LinearLayout
        android:id="@+id/homeSearchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/home_bg_search"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/home_ic_search" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/home_search_hint"
            android:textColor="#6B6B6B"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/homeBtnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_more"
            android:padding="11dp"
            android:src="@drawable/home_ic_more_vert" />
    </LinearLayout>

    <!-- ② 五快捷白卡：收藏／歌单／本地（正中）／历史／下载，图标＋名字＋数量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/home_bg_card_white"
        android:elevation="3dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="18dp"
        android:paddingEnd="6dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/homeQuickFavorite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_favorite" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:text="@string/home_favorite"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeCountFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickSheets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_sheets" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:text="@string/home_sheets"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeCountSheets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_device" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:text="@string/home_device"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeCountDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickRecent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_recent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:text="@string/home_recent"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeCountRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickDownload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:text="@string/home_download"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeCountDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ③ 三张渐变入口卡横排垫底 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/homeCardGuess"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_weight="1"
            android:background="@drawable/home_bg_card_pink"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_guess"
                    android:textColor="#1A1A1A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/home_guess_sub"
                    android:textColor="#4D4D4D"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_watermark_heart" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/homeCardCharts"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/home_bg_card_teal"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_charts"
                    android:textColor="#1A1A1A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/home_charts_sub"
                    android:textColor="#4D4D4D"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_watermark_chart" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/homeCardShuffle"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/home_bg_card_lime"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_shuffle"
                    android:textColor="#1A1A1A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/home_shuffle_sub"
                    android:textColor="#4D4D4D"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_watermark_play" />
        </FrameLayout>
    </LinearLayout>

    <!-- 底部留白：给悬浮迷你条让位（条只在有音乐会话时出现） -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
