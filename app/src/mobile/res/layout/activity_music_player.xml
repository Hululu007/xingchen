<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐播放页·经典主题（默认，从零重写，照瓜子源码抠值全表第三节＋对照表回补）：
     根＝氛围层（封面 dominant 色＋糊封面）满铺；内容列（瓜子原列结构）：封面权重盒 →
     歌名列（与封面零间隔、渲染下移 12dp 在代码里给、底部内边距 8dp）→ 页内歌词（weight 1）
     → 间隔 6dp → 进度条 → 间隔 45dp。歌名行（18sp＋右三键：菜单/队列/播停）、歌手♡专辑行。
     无自带返回箭头（铁律）、无上一首/下一首运输行（经典靠封面竖滑切歌，瓜子原样）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1C1C1E">

    <com.fongmi.android.tv.ui.music.view.CoverAmbientView
        android:id="@+id/playerAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/playerCoverBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.fongmi.android.tv.ui.music.view.FadingCoverView
                android:id="@+id/playerCoverOut"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <com.fongmi.android.tv.ui.music.view.FadingCoverView
                android:id="@+id/playerCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <com.fongmi.android.tv.ui.music.view.BurstHeartView
                android:id="@+id/playerBurst"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/playerMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:letterSpacing="-0.0222"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/playerBtnMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/player_tools"
                        android:padding="9.5dp"
                        android:src="@drawable/ic_player_menu_lines" />

                    <ImageView
                        android:id="@+id/playerBtnQueue"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/player_queue"
                        android:padding="10dp"
                        android:src="@drawable/ic_music_queue"
                        android:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/playerBtnPlay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/player_play_pause"
                        android:padding="6dp"
                        android:src="@drawable/ic_music_pause"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playerArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#73FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/playerBtnFav"
                    android:layout_width="27dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/player_favorite"
                    android:paddingStart="7dp"
                    android:paddingTop="4.5dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="4.5dp"
                    android:src="@drawable/ic_music_heart" />

                <TextView
                    android:id="@+id/playerAlbum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#73FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <com.fongmi.android.tv.ui.music.view.InPageLyricsView
            android:id="@+id/playerLyrics"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <FrameLayout
            android:id="@+id/playerScrubberBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp">

            <com.fongmi.android.tv.ui.music.view.ClassicScrubberView
                android:id="@+id/playerScrubber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/playerMiniGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/miniChipQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_music_mini_chip"
                        android:letterSpacing="0.05"
                        android:paddingLeft="12dp"
                        android:paddingTop="5dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="5dp"
                        android:textColor="#B8FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/miniChipLyric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_music_mini_chip"
                        android:letterSpacing="0.05"
                        android:paddingLeft="12dp"
                        android:paddingTop="5dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="5dp"
                        android:textColor="#B8FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.fongmi.android.tv.ui.music.view.MiniProgressView
                    android:id="@+id/playerMiniProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="45dp" />
    </LinearLayout>
</FrameLayout>
