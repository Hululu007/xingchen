<?xml version="1.0" encoding="utf-8"?>
<!-- 红果搜索结果卡：双列瀑布卡，构成照官方 b7l（holder_staggered_pugc_video）
     逐项落值——卡底白、paddingBottom 12dp；封面满宽（官方按数据宽高比，
     自家数据无宽高字段、用 3:4 定比，见汇总留痕）；封面居中播放钮 24dp；
     上/下 32dp 渐变（amv/amy 原值 #26000000→#01000000）压角标与左下文案
     （12sp 粗白、marginStart 10dp）；标题 14sp 粗黑、2 行、lineSpacingExtra
     4dp、左右 margin 10dp、上 margin 8dp；底部作者行＝12dp 圆头像＋19dp 高
     文案行。封面圆角 6dp 沿前批系列单行同族口径（bg_hg_cover_r6）。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginBottom="10dp"
    android:background="#FFFFFFFF"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/hg_s_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hg_cover_r6"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_hg_play_circle"
        app:layout_constraintBottom_toBottomOf="@id/hg_s_cover"
        app:layout_constraintEnd_toEndOf="@id/hg_s_cover"
        app:layout_constraintStart_toStartOf="@id/hg_s_cover"
        app:layout_constraintTop_toTopOf="@id/hg_s_cover" />

    <View
        android:id="@+id/hg_s_gradient_top"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_hg_card_gradient_top"
        app:layout_constraintEnd_toEndOf="@id/hg_s_cover"
        app:layout_constraintStart_toStartOf="@id/hg_s_cover"
        app:layout_constraintTop_toTopOf="@id/hg_s_cover" />

    <TextView
        android:id="@+id/hg_s_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_hg_badge"
        android:gravity="center_vertical"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hg_s_gradient_top"
        app:layout_constraintStart_toStartOf="@id/hg_s_cover"
        app:layout_constraintTop_toTopOf="@id/hg_s_gradient_top" />

    <View
        android:id="@+id/hg_s_gradient_bottom"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_hg_card_gradient_bottom"
        app:layout_constraintBottom_toBottomOf="@id/hg_s_cover"
        app:layout_constraintEnd_toEndOf="@id/hg_s_cover"
        app:layout_constraintStart_toStartOf="@id/hg_s_cover" />

    <TextView
        android:id="@+id/hg_s_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hg_s_gradient_bottom"
        app:layout_constraintStart_toStartOf="@id/hg_s_cover"
        app:layout_constraintTop_toTopOf="@id/hg_s_gradient_bottom" />

    <TextView
        android:id="@+id/hg_s_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="2"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hg_s_cover" />

    <ImageView
        android:id="@+id/hg_s_author_avatar"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_hg_avatar_clip"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hg_s_author_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/hg_s_author_name" />

    <TextView
        android:id="@+id/hg_s_author_name"
        android:layout_width="0dp"
        android:layout_height="19dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#66000000"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/hg_s_author_avatar"
        app:layout_constraintTop_toBottomOf="@id/hg_s_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
