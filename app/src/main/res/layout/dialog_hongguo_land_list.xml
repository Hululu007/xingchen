<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏页右侧抽屉通用壳（倍速面板 xr3.f／清晰度表共用）：板底照官方
     倍速板 p4（#F21A1A1A、左圆角 24dp，见 bg_hg_land_panel）；官方板无
     标题、列表上下各空 60dp（aey 原文），标题位保留 id 但恒藏（代码仍写
     文案防绑定失效），行样式在宿主 landDrawerRow 按 beo 定版落。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hg_land_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/hg_ll_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hg_ll_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:orientation="vertical" />
</LinearLayout>
