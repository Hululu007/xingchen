<?xml version="1.0" encoding="utf-8"?>
<!-- 首页标题行右上角黑胶唱片装饰：深墨盘面＋两圈纹路环＋粉色盘心（布局侧 rotation 24 斜探）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#FF101014"
                android:startColor="#FF3A3A40"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="13dp"
        android:left="13dp"
        android:right="13dp"
        android:top="13dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <solid android:color="#FFFF5C8A" />
        </shape>
    </item>
    <item
        android:bottom="26dp"
        android:left="26dp"
        android:right="26dp"
        android:top="26dp">
        <shape android:shape="oval">
            <solid android:color="#FFF1F1F4" />
        </shape>
    </item>
</layer-list>
