<?xml version="1.0" encoding="utf-8"?>
<!-- 第 9 项：猜你喜欢英雄卡（GZ GuessHero：玻璃卡圆角 20dp、内边距 20dp；
     叠卡容器 132x126dp、后两张 92dp、前一张 104dp、单张圆角 16dp，层间偏移量未抠到、星辰侧自定；
     图文排布未抠到，星辰侧自定为叠卡在上、文案在下；
     PRIVATE MIX 10sp 字距 2、为你精选 12sp、大标题 26sp 行高 33sp、副文案 12sp 行高 19sp、
     计数数字 28sp＋首精选歌曲 11sp、由你的热爱出发 13sp、线索行 11sp 行高 17sp；
     播放全部胶囊钮高 48dp、内边距 12dp，随机／保存为圆钮） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guessHeroRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_guess_hero"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="126dp">

        <ImageView
            android:id="@+id/deckBack2"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="top|start"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/deckBack1"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="40dp"
            android:layout_marginTop="4dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/deckFront"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="bottom|center_horizontal"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGuessPrivate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.2"
        android:text="PRIVATE MIX"
        android:textColor="#9AA7B8"
        android:textSize="10sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="为你精选"
        android:textColor="#1C1C1E"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="7sp"
        android:text="下一首，&#10;也许就心动。"
        android:textColor="#1C1C1E"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="7sp"
        android:text="沿着你的听歌足迹&#10;遇见新的喜欢"
        android:textColor="#9AA7B8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvGuessCountNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1C1C1E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="首精选歌曲"
            android:textColor="#9AA7B8"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="由你的热爱出发"
        android:textColor="#1C1C1E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGuessClue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="6sp"
        android:textColor="#9AA7B8"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnGuessPlayAll"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="播放全部"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnGuessShuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:padding="12dp"
            android:src="@drawable/ic_music_shuffle" />

        <ImageView
            android:id="@+id/btnGuessSave"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_music_plus" />
    </LinearLayout>
</LinearLayout>
