<?xml version="1.0" encoding="utf-8"?>
<!-- 封面卡片（gz-full-parity-1025 §4＋§13.1/13.2）：顶 42→歌名 30→4→歌手 22→22→封面权重区（横距 24）
     →14→玻璃条 48→底 12。默认态三卡叠放＋玻璃条（收藏后 10dp 间隔 §13.2）；展开态列：歌词/信息视口
     →四玻璃键 42dp→12→双筹＋Scrubber。前卡尺寸/叠卡几何由 CoverStackView 定（§13.1 纠正公式）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="42dp" />

    <TextView
        android:id="@+id/tpTitle"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:ellipsize="end"
        android:fontWeight="800"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineHeight="26dp"
        android:maxLines="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="#F5FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <TextView
        android:id="@+id/tpArtist"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:ellipsize="end"
        android:fontWeight="500"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineHeight="18dp"
        android:maxLines="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="#8CFFFFFF"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="22dp" />

    <FrameLayout
        android:id="@+id/tpCoverArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_weight="1">

        <com.fongmi.android.tv.ui.music.CoverStackView
            android:id="@+id/tpCoverStack"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 左后卡（绘制序先左后右 §13.1）：空占位卡，背景给渐变/描边/圆角 -->
            <ImageView
                android:id="@+id/tpCoverBack1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cover_card_back"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/tpCoverBack2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cover_card_back"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/tpCardExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/tpCoverWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/tpCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/tpCoverExit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </com.fongmi.android.tv.ui.music.CoverStackView>

        <!-- 展开态列（默认 gone，宿主切换） -->
        <LinearLayout
            android:id="@+id/tpExpandedCol"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.fongmi.android.tv.ui.music.CoverLyricView
                    android:id="@+id/tpLyricView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <ScrollView
                    android:id="@+id/tpInfoScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_cover_info_card"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/tpInfoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp" />
                </ScrollView>
            </FrameLayout>

            <!-- 展开控制行：四玻璃键 42dp、键间 24dp、底白 0.14（bg_player_glass_btn） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tpBtnPrev"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_prev"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_prev"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/tpBtnQueue"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_queue"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_queue"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/tpBtnInfo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_song_info"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_info"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/tpBtnNext"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_player_glass_btn"
                    android:contentDescription="@string/music_next"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_next"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tpPositionTop"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.018"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tpChipQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_player_chip"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tpQualityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.054"
                                android:maxLines="1"
                                android:textColor="#B8FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tpChipLyric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_player_chip"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <TextView
                                android:id="@+id/tpLyricChipText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.054"
                                android:maxLines="1"
                                android:text="@string/music_lyric_chip_line"
                                android:textColor="#B8FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tpDurationTop"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.018"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.fongmi.android.tv.ui.music.MusicScrubberView
                    android:id="@+id/tpScrubber"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <!-- 玻璃条：高 48dp、圆角 22dp、横距 24dp、内垫左右 16dp；收藏键后 10dp 间隔（§13.2） -->
    <LinearLayout
        android:id="@+id/tpGlassBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_cover_glass_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/tpGlassFav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_favorite"
            android:padding="10dp"
            android:src="@drawable/ic_music_heart"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tpGlassLyric"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontWeight="500"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#EBFFFFFF"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/tpGlassPlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/pl_play_pause"
            android:padding="8dp"
            android:src="@drawable/ic_music_pause"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tpGlassBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontWeight="500"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/music_info_back_cover"
            android:textColor="#EBFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />
</LinearLayout>
