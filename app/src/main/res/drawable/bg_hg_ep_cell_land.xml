<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏选集抽屉专用集格底（深板 #FF161616 语境，不与竖屏选集单的浅底
     bg_hg_ep_cell 串用）：圆角 8dp 同 E17；常态白 8%（#14FFFFFF，压在
     #161616 上读作 #262626 格面）、当前集（selected）橙 20%（#33FA7705，
     浅底口径为橙 10%、深底加强一档）。色值推断：官方 caa 只定版了板底
     与标题白色，集格底色包内无实物（列表由适配器绑定、无布局文件）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#33FA7705" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
