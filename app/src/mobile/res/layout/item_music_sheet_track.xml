<?xml version="1.0" encoding="utf-8"?>
<!-- 第 1 项：歌单歌曲行（GZ PlaylistSongRow：封面 46dp、歌名 14sp、第二行 12sp＝歌手［· 专辑］［· 平台］［· 不可播原因］；
     行内边距横 20dp、竖 2dp；非多选时「更多」图标 20dp、点击区 36dp；多选时 24dp 选中圆圈走 ⋮ 位） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="2dp"
    android:paddingEnd="20dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineHeight="19sp"
            android:maxLines="1"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineHeight="16sp"
            android:maxLines="1"
            android:textColor="#9AA7B8"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/player_more"
        android:padding="8dp"
        android:src="@drawable/ic_music_more" />
</LinearLayout>
