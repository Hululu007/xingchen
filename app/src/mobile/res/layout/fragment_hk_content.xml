<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:background="#f2f2f2"
            android:id="@+id/fragment_hk_content_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 用户要求删除内容页顶栏（返回键/标题/搜索图标）：返回走系统返回键，搜索走内嵌搜索条 -->

            <LinearLayout
                android:id="@+id/miniapp_tabs_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/hk_miniapp_tabs_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_miniapp_tabs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/btn_miniapp_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/dialog_option_card_light"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="全部 ▾"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 8.83 同款静态分类 tab 行容器：class/area/year/sort 各独立一行
                 （横向滚动 + 右侧 ">" 点开"请选择分类"弹窗），由 buildCategoryRow 动态建行 -->
            <LinearLayout
                android:id="@+id/category_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 8.83 同款：JS scroll_button/flex_button 动态 tab 行容器（每条目一行，各带 > 展开按钮） -->
            <LinearLayout
                android:id="@+id/ll_tab_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 8.83 同款：内容页内嵌搜索栏（搜索短剧/演员 + 搜索按钮） -->
            <LinearLayout
                android:id="@+id/search_bar_content"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/hk_capsule_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="8dp">

                <EditText
                    android:id="@+id/et_search_content"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索短剧 / 演员"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#101216"
                    android:textColorHint="#8A8F98"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_search_content_go"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/hk_gold_button"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="搜索"
                    android:textColor="#101216"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filter_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_videos"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_content_empty"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="加载失败，点我重试"
                        android:textColor="#101216"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/loading_content"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:elevation="8dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ProgressBar
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:indeterminateTint="#D4A017" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="加载中…"
                            android:textColor="#101216"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="#101216"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>