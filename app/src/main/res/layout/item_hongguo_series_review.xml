<?xml version="1.0" encoding="utf-8"?>
<!-- 红果剧详情页·剧评卡（横滑单卡，深底半透）：头像＋名＋星级一行，
     正文 4 行截断，下行点赞。数据＝HgComment（整剧评论口，expand.score
     十分制折五星）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="262dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_hg_glass_card_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hg_sr_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/hg_sr_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/hg_sr_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hg_sr_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/hg_sr_digg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
