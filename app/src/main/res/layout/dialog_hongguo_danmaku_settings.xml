<?xml version="1.0" encoding="utf-8"?>
<!-- 红果弹幕设置单（竖屏更多面板「弹幕设置」行的落点；官方
     DanmakuOptionDialog 竖屏形态的自家等价）：标题＋恢复默认＋四滑杆
     （不透明度 0–80 档对应 20%–100%、移动速度五档、显示区域四档、
     字体大小五档）。白底圆角顶与更多面板同族（bg_hg_ep_sheet），
     滑杆走红果红 #FF5A3C（与开关轨道开态同色）。改值即存 HgStore
     红果自有键并即时回刷渲染层（HongguoFeedActivity.showDanmakuSettings）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hg_ep_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hg_ep_grab" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="弹幕设置"
            android:textColor="#FF111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hg_dm_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="恢复默认"
            android:textColor="#FF666666"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="不透明度"
            android:textColor="#FF111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_dm_opacity_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF999999"
            android:textSize="13sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/hg_dm_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:max="80"
        android:progressTint="#FF5A3C"
        android:thumbTint="#FF5A3C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="移动速度"
            android:textColor="#FF111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_dm_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF999999"
            android:textSize="13sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/hg_dm_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:max="4"
        android:progressTint="#FF5A3C"
        android:thumbTint="#FF5A3C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="显示区域"
            android:textColor="#FF111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_dm_area_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF999999"
            android:textSize="13sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/hg_dm_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:max="3"
        android:progressTint="#FF5A3C"
        android:thumbTint="#FF5A3C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="字体大小"
            android:textColor="#FF111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_dm_font_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF999999"
            android:textSize="13sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/hg_dm_font"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:max="4"
        android:progressTint="#FF5A3C"
        android:thumbTint="#FF5A3C" />
</LinearLayout>
