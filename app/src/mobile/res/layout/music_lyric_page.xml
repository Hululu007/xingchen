<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏歌词页（批 2，形态只认实证：录屏 f001＋截图 112747＋对照图 113010 中机）：
     封面拉满整屏作背景、下半渐隐到封面取色底（渐隐罩由 MusicLyricPageView 在封面之上插入 ToneVeilView）；
     歌名左对齐压在歌词上方，歌名下「歌手 ♡ 专辑名」一行；歌名行右侧两个裸图标（播放列表／暂停——
     瓜子此处最左的 ☰ 已于批 7 摘除：抠实＝一起听邀请面板入口，定案不做，见批 7 报告）；
     歌词左对齐沉浸滚动。没有顶部小封面、没有底部进度条和底部按键。
     头行与歌词区的纵向位置由 MusicLyricPageView 按封面方幅（宽＝高）在 onSizeChanged 里落位。 -->
<com.fongmi.android.tv.ui.music.MusicLyricPageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- 封面：拉满整屏（centerCrop），上半实、下半被取色渐隐罩盖住 -->
    <ImageView
        android:id="@+id/ivLyricCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- 头行：歌名列（歌名＋歌手♡专辑）＋右侧三裸键；纵向位置代码落位（压在封面下沿渐隐区） -->
    <LinearLayout
        android:id="@+id/lyricHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLyricTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontWeight="800"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#F2FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLyricArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#8CFFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivLyricHeart"
                    android:layout_width="27dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:src="@drawable/ic_music_heart"
                    android:tint="#8CFFFFFF" />

                <TextView
                    android:id="@+id/tvLyricAlbum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#8CFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧两键：盒各 40dp（SongMeta 同口径）。批 7 摘键：☰（btnLyricMenu）已删——
             jadx 抠实它在瓜子打开「一起听」邀请面板（ListenTogetherInviteSheet），一起听是定案不做项，
             按「假键比缺键更糟」摘键；键组只剩队列＋暂停，wrap_content 不留空洞。 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnLyricQueue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_queue"
                android:padding="10dp"
                android:src="@drawable/ic_music_queue"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnLyricPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/pl_play_pause"
                android:padding="6dp"
                android:src="@drawable/ic_music_pause"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 歌词区：左对齐沉浸滚动，横向垫 28dp；纵向起点代码落位（头行之下） -->
    <com.fongmi.android.tv.ui.music.FullLyricView
        android:id="@+id/lyricFullView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />
</com.fongmi.android.tv.ui.music.MusicLyricPageView>
