<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/card_music_glass_24"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingEnd="14dp">

    <!-- 瓜子插件行图标位（彩色淡底方块＋彩色拼图，方块底色代码侧按行色淡染；块 44dp、图标 24dp） -->
    <ImageView
        android:id="@+id/pluginIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:padding="10dp"
        android:src="@drawable/ic_music_puzzle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1C1C1E"
                android:textSize="16sp"
                android:textStyle="bold" />
            <!-- 格式徽标（落雪／FreeJS 粉签）已整摘（2026-10-27 他令「卡片上不需要 freejs 之类的」）；
                 落雪/FreeJS 区分只在分组段头，卡片只留名字、状态、检测、开关。 -->
        </LinearLayout>

        <!-- GZ 副文案串（单行 11sp，超长截断不折行）：官方／加密／版本／作者／耗时（有数据的段才拼，无数据不编） -->
        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- C4 检测状态：6dp 圆点＋10sp 文案（四态色见 MusicPluginTest.labelColor） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_music_status" />

            <TextView
                android:id="@+id/testStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FF8E8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 批 6 检测三段行：搜索／取播放／取歌词逐段状态（通过／失败＋原因短文），已检测才显 -->
        <TextView
            android:id="@+id/pluginStages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 失败 message 行内展开（整插件失败或歌词单项失败时显，11sp；
             色按本页口径恒白——旧红 #FFFF3B30 已按 2026-10-27 他令换掉，代码侧同口径） -->
        <TextView
            android:id="@+id/pluginError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- C4 行内“检测”钮（放开关左侧；与 pluginMenu 菜单项二选一，定行内钮，菜单不另加检测项）。
         底改白钮 badge_music_test（2026-10-27 他令：白色、深字看得清；粉角标 badge_music 多处共用不动） -->
    <TextView
        android:id="@+id/pluginTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/badge_music_test"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="检测"
        android:textColor="#1C1C1E"
        android:textSize="12sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/pluginSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/pluginMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/player_more"
        android:padding="10dp"
        android:src="@drawable/ic_music_more" />

    <!-- 批 6：行内删除钮（与 ⋮ 菜单删除同一确认流程 confirmDeletePlugin） -->
    <ImageView
        android:id="@+id/pluginDelete"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:contentDescription="@string/music_delete"
        android:padding="9dp"
        android:src="@drawable/ic_music_delete" />
</LinearLayout>
