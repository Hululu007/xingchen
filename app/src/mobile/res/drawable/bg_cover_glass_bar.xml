<!-- 玻璃歌词条（GZ CoverLyricGlassBar chromeFrost：只有白渐变 0.26→0.08、描边 1dp、圆角 22dp，无深色实底；
     此前 0.80 深底已删——瓜子侧无此层，星辰旧注释自认 0.80 是调参近似值、不是瓜子数）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#42FFFFFF" android:endColor="#14FFFFFF" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
