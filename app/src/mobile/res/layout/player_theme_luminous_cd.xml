<?xml version="1.0" encoding="utf-8"?>
<!-- 流光 CD 主题：底色/文字色由代码按 CdPalette（浅 Pearl #F4F2EE／深 #14161C／自动跟随系统深色）刷 tpCdRoot 与各文字；
     页左右内边距 16dp；中央 CD 盘（封面圆贴占盘面 0.68、中心点 0.05）播放时 16°/s 旋转；歌名 15sp/行高21/600、歌手 11sp/行高15；
     歌词区照 GZ CdLyricsList：CoverCurrentLyric 组件 cover 模式、字号 21sp、居中、加粗、浅模糊（组件侧按表面明暗切方案）；
     歌词下五图标行（歌曲信息／盘心详情、音质、歌词版本、收藏、表面切换）＋细进度＋裸图标主控。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tpCdRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F2EE"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- 顶行 64dp（GZ LuminousCdPlayerKt:2704,2746,2805）：左收起键＋中部歌名/歌手＋右工具键。
         收起键形态已核瓜子原文：tf2.u()＝Rounded.KeyboardArrowDown（向下箭头），不是 ‹ 返回箭头，
         故可加（铁律只禁 ‹，不禁向下收起符号）；点按走系统返回（onBackPressed，与铁律一致）。
         中部歌名跑马灯（GZ CdMarqueeTitle，15sp/行高21/600）、歌手在下（歌手行内容不动：仍是歌手 ♡ 专辑名合并行）。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tpBtnCollapse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="收起播放页"
            android:padding="10.5dp"
            android:src="@drawable/ic_music_chevron_down" />

        <LinearLayout
            android:id="@+id/tpCdTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fontWeight="600"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineHeight="21dp"
                android:marqueeRepeatLimit="marquee"
                android:maxLines="1"
                android:selected="true"
                android:textColor="#282D36"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineHeight="15dp"
                    android:maxLines="1"
                    android:textColor="#747D89"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/tpAlbumSep"
                    android:layout_width="27dp"
                    android:layout_height="13dp"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:src="@drawable/ic_music_heart"
                    android:tint="#747D89" />

                <TextView
                    android:id="@+id/tpAlbum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineHeight="15dp"
                    android:maxLines="1"
                    android:textColor="#747D89"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/tpBtnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/music_more"
            android:padding="10.5dp"
            android:src="@drawable/ic_music_menu" />
    </LinearLayout>

    <!-- CD 盘区（手势同封面：双击收藏/长按工具面板/横滑切歌/单击开全屏歌词页，代码侧挂 tpCoverWrap）；
         瓜子纵向盘区无 weight（LuminousCdPlayerKt:2807-2812 纵向 weight=1 的是展开区，不是盘区），故删 weight 5；
         盘区高＝wrap_content（即盘高），盘径只走代码 applyCdDiscSize 的约束公式 min(区宽,可用高,400dp)。
         盘／封面／扫光布局尺寸均为 0dp：公式值由代码覆盖，不留 280/190 占位（190/280≠0.892857，量出前一帧用占位是错的）。 -->
    <FrameLayout
        android:id="@+id/tpCoverWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/tpCdDisc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/tpCover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop" />

            <!-- 出场封面层（redo3 F1）：切歌时旧封面暂存于此做 出场动画，平时 gone -->
            <ImageView
                android:id="@+id/tpCoverExit"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 切歌扫光层（GZ CdSongChange）：尺寸由代码改盖满整盘，平时不绘制 -->
            <com.fongmi.android.tv.ui.custom.CdSweepView
                android:id="@+id/tpCdSweep"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_player_center_dot" />

            <!-- 光泽层（redo3 第四轮 D11）：盖盘面，代码侧设斜向白光渐变、700ms 淡入／450ms 淡出；中心点 14dp 不动 -->
            <View
                android:id="@+id/tpCdSheen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

            <!-- 表面细节层（redo3 第四轮 D11）：盘面歌曲信息行，行首边距 40dp，内含 40dp 拇指＋歌名／歌手；透明度由代码侧 applyCdDetail 按进度公式算 -->
            <LinearLayout
                android:id="@+id/tpCdDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="40dp"
                android:paddingEnd="16dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/tpCdDetailThumb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tpCdDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#282D36"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tpCdDetailArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#747D89"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>

    <!-- 收起态弹性空隙：瓜子纵向展开区（weight=1，LuminousCdPlayerKt:2807）收起时为空白填充件；
         星辰侧以本空隙填充盘下剩余高（盘区已无 weight 时收起态不留底边空白）；展开时代码先把它排除在固定高外，
         动画结束置 GONE（动画中它随歌词区显式高自动收缩，同一布局 pass 内抵消，不产生跳变）。 -->
    <View
        android:id="@+id/tpCdGap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 歌词摘要行（wave2，GZ CdLyricSummary 独立行）：收起态显示、展开态隐藏；高 78dp、主行 16sp／副行 12sp，
         同一槽位已核对：瓜子摘要容器纵向偏移 -10dp（LuminousCdPlayerKt:2950 的 offset(0,-10)，不占布局位），
         故星辰删 marginTop 16dp、改 translationY -10dp（绘制上移 10dp，兄弟布局位不动，与瓜子 offset 同口径）；
         摘要自身左右内边距 24dp 不动（瓜子横向内边距未抠到）；点按展开。 -->
    <LinearLayout
        android:id="@+id/tpCdSummary"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:translationY="-10dp">

        <TextView
            android:id="@+id/tpCdSummaryMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#282D36"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tpCdSummarySub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#747D89"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 歌词区：CoverCurrentLyric（cover 模式，21sp/居中/加粗，点行 seek——GZ CdLyricsList 走 onLyricSeek）；
         U-06：展开 weight 1 占剩余高度，收起 78dp 摘要行（代码侧 toggleCdLyricsExpanded，展开 600ms／收起 500ms）；
         展开态左右合计每侧 28dp＝页 16dp＋歌词层 12dp；收起摘要合计每侧 40dp＝页 16dp＋摘要 24dp（摘要视图未建，收起态仍为歌词视图缩高，见报告）。
         本体 21sp 由 MPA CD 分支 setMainTextSizeSp(21) 已落（见分表对 KLV 自绘 padding 的说明）。 -->
    <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
        android:id="@+id/tpLyricView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- GZ 五图标行（LuminousCdPlayerKt:2960）：行高 52dp、左右内边距 2dp、每格 weight=1 均分全宽、图标盒 26dp、按压 0.9；
         行与歌词直接相邻（无固定间隔），下一行就是进度条。顺序与动作：①歌曲信息／盘心详情（toggleCdDetailContent）
         ②音质（showQualityDialog）③歌词版本（openLyricVersionDialog）④收藏（toggleFavorite，tpFavHeart 原歌手行旁那颗移至此）
         ⑤表面切换（LIGHT→DARK→AUTO→LIGHT 循环＋Toast）。颜色：激活态 ① 用 accent、其余 muted（代码 applyCdPalette 刷），
         收藏心由 paintFavoriteIcons 按收藏态刷 muted／红心；不可用时 alpha ×0.35（代码侧，不可用态暂无对应逻辑，见报告）。 -->
    <LinearLayout
        android:id="@+id/tpCdUtilRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tpCdUtilInfo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/music_song_info"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_info" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tpCdUtilQuality"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/music_quality"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_eq" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tpCdUtilLyric"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/music_lyric_versions"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_note" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tpFavHeart"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/music_favorite"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_heart" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/tpCdUtilTheme"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/music_cd_surface_switch"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_palette" />
        </FrameLayout>
    </LinearLayout>

    <!-- 细进度＋时间（redo3 第四轮 D14：轨线 2dp、瓜子无拇指 thumb="@null"；底轨 ink×0.10 由代码侧对 background 层着色，填充色 j 未追到底、填充层原样保留）；
         进度区外层左右内边距 8dp（叠加页 16dp 后距屏边合计 24dp，GZ CdSeekBar 外层口径），时间行同 8dp。 -->
    <!-- 细进度：滑杆高 34dp 不动；轨容器高 10dp（GZ CdSliderTrack，LuminousCdPlayerKt:1760，CD_FLOW_BASS=10）：
         SeekBar 上下各 12dp 内边距后内容区高＝34-24＝10dp，轨线仍 2dp（max/minHeight）居中其中；触摸区仍为整 34dp。 -->
    <SeekBar
        android:id="@+id/tpSeek"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="14dp"
        android:maxHeight="2dp"
        android:minHeight="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:progressDrawable="@drawable/bg_player_seek_progress_dark"
        android:thumb="@null" />

    <LinearLayout
        android:id="@+id/tpCdTimeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tpPosition"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.018"
            android:text="00:00"
            android:textColor="#BD747D89"
            android:textSize="9sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tpDuration"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.018"
            android:text="00:00"
            android:textColor="#BD747D89"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 裸图标主控行（行高 80dp：LuminousCdPlayerKt:3055；播放盒 68dp／图标播放态 54／暂停态 58dp 由代码随态改，见 MPA applyPlayButtonSize；
         行左右内边距 4dp（GZ CD_UNDERTOW_BASS），叠加页 16dp 后合计 20dp；上一首／下一首盒 44dp／图标 32dp，模式／队列盒 44dp／图标 23dp；
         行偏移改回瓜子 -10dp（LuminousCdPlayerKt:3055 的 offset(0,-10)；此前星辰自改 -6dp 防侵入时间行作废）。 -->
    <LinearLayout
        android:id="@+id/tpCdMainRow"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="-10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/tpMode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10.5dp"
            android:src="@drawable/ic_music_sequential" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/music_prev"
            android:padding="6dp"
            android:src="@drawable/ic_music_prev" />

        <ImageView
            android:id="@+id/tpPlay"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:contentDescription="@string/pl_play_pause"
            android:padding="7dp"
            android:src="@drawable/ic_music_pause" />

        <ImageView
            android:id="@+id/tpNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/music_next"
            android:padding="6dp"
            android:src="@drawable/ic_music_next" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpQueue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/music_queue"
            android:padding="10.5dp"
            android:src="@drawable/ic_music_queue" />
    </LinearLayout>
</LinearLayout>
