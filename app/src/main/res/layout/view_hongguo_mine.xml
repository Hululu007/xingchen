<?xml version="1.0" encoding="utf-8"?>
<!-- 红果「我的」面：嵌在刷剧页壳内（底栏「我的」格），构成＝登录区＋页签排
     （历史/收藏/点赞；预约页签等预约链抠实后再摆，链没通不摆）＋海报格子。
     无自带返回箭头（走系统返回），顶部留距由刷剧页按状态栏 insets 注入 padding。 -->
<com.fongmi.android.tv.hongguo.ui.HgMineView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:text="我的"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hg_mine_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="#F5F5F5"
        android:padding="14dp"
        android:textColor="#111111"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hg_mine_tab_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="历史"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_mine_tab_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="收藏"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hg_mine_tab_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="点赞"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hg_mine_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:textColor="#999999"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hg_mine_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />
</com.fongmi.android.tv.hongguo.ui.HgMineView>
