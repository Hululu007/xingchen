<?xml version="1.0" encoding="utf-8"?>
<!-- 全域玻璃件·结果行框（液态玻璃四项里的按压发亮）：默认＝共用玻璃白卡 bg_music_glass_white_card
     （半透明白渐变＝顶部流光、白描边＝边缘亮边）；按压态整面提亮＋描边加强。与其余 bg_music_glass_* 同语言。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F7FFFFFF" android:endColor="#E8FFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_music_glass_white_card" />
</selector>
