<?xml version="1.0" encoding="utf-8"?>
<!-- 红果刷剧页：全屏竖向 ViewPager2 一页一集；顶栏（☰＋四页签＋搜索）浮在流上；
     全屏极简控制条（hg_fs_bar）默认隐藏，进全屏点屏唤出、自动再隐。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/hg_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/hg_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/hg_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="菜单"
            android:padding="9dp"
            android:src="@drawable/ic_hg_menu" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/hg_tab_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关注"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tab_comic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="漫剧"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tab_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="真人剧"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hg_tab_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="推荐"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/hg_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="搜索"
            android:padding="9dp"
            android:src="@drawable/ic_hg_search" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hg_fs_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hg_fs_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="播放或暂停"
            android:padding="8dp"
            android:src="@drawable/ic_hg_pause" />

        <SeekBar
            android:id="@+id/hg_fs_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/hg_fs_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/hg_fs_series"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hg_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
