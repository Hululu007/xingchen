<?xml version="1.0" encoding="utf-8"?>
<!-- 红果更多面板（他 2026-10-28 定五项，只这五项、多一项不加）：当前倍速
     六档筹、清晰度档筹、弹幕开关、投屏、定时关闭。白底圆角顶照官方实拍
     113510；官方其余行（不感兴趣/清屏/弹幕设置/下载/字体/画幅/设置默认
     倍速）按他口径不抄。筹轨道/选中片走 bg_hg_panel_track/chip_on。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hg_ep_sheet"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hg_ep_grab" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:text="当前倍速"
        android:textColor="#FF111111"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/hg_panel_speed_row"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_hg_panel_track"
        android:orientation="horizontal"
        android:padding="3dp" />

    <LinearLayout
        android:id="@+id/hg_panel_def_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清晰度"
            android:textColor="#FF111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hg_panel_def_row"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hg_panel_track"
            android:gravity="end"
            android:orientation="horizontal"
            android:padding="3dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="弹幕"
            android:textColor="#FF111111"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/hg_panel_danmaku_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:showText="false"
            android:switchPadding="5dp"
            android:thumb="@drawable/hg_switch_thumb"
            android:track="@drawable/hg_switch_track" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hg_panel_cast"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="投屏"
            android:textColor="#FF111111"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#FFBBBBBB"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hg_panel_timer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="定时关闭"
            android:textColor="#FF111111"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_panel_timer_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="关闭"
            android:textColor="#FF999999"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#FFBBBBBB"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
