<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏歌词页（照 GZ 本体＋用户实拍 112770 转写）：上半部约 45% 是封面图本体整幅显示（非整屏糊底），
     下缘渐变融进 CoverColor 氛围底色；封面下方歌名歌手在左（歌手行带小心形收藏态）、右侧三裸图标；
     歌词区从歌名下方排到到底部胶囊上方；底部居中双胶囊（音质实测短标＋逐字）＋一条发丝细进度线。
     本页没有上一首/播放/下一首主控行（暂停只在头部第三图标）。页面不放返回箭头，走系统返回。
     45% 为照片量取（GZ 源码该页为 Pager 内整页、无此装配确数，见 section-C 未验/注明）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 封面本体区：约占上半部 45%（权重 45/55），整幅显示，下缘渐变罩融进氛围底 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="45">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- 下缘渐变：透明 → 氛围色（代码按 CoverColor 动态生成同色渐变） -->
            <View
                android:id="@+id/coverFade"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- 头部行：左歌名/歌手（歌手行小心形），右三裸图标 40dp 点击区（菜单/队列/播放暂停） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#C9CDD4"
                        android:textSize="13sp" />

                    <!-- 歌手行小心形收藏态（GZ：图标 13dp、padding 7dp） -->
                    <ImageView
                        android:id="@+id/btnFav"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:contentDescription="@string/music_favorite"
                        android:padding="7dp"
                        android:src="@drawable/ic_music_heart"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_more"
                android:padding="9dp"
                android:src="@drawable/ic_music_menu"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnQueue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/music_queue"
                android:padding="9dp"
                android:src="@drawable/ic_music_queue"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnPlayTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="7dp"
                android:src="@drawable/ic_music_play"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 歌词区：上界在标题行下、下界在底部胶囊上（不占满全屏），横向内边距 28dp -->
        <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
            android:id="@+id/lyricsView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="55"
            android:paddingStart="28dp"
            android:paddingEnd="28dp" />

        <!-- 底部：居中双胶囊（音质点按选档／逐字点按切换渲染）＋发丝细进度线（仅显示、不可拖），无主控行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <!-- 音质胶囊：实测短标（FLAC/320k…），无实测隐藏 -->
                <TextView
                    android:id="@+id/chipQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lyric_capsule"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- 逐字胶囊：当前歌词为逐字时显示、整行时隐藏 -->
                <TextView
                    android:id="@+id/chipWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_lyric_capsule"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/music_word_by_word"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 发丝进度线：仅显示不可拖（GZ 歌词页底部无控制行、进度线仅显示）；enabled=false＋透明 0 拇指 -->
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:clickable="false"
                android:enabled="false"
                android:focusable="false"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:progressDrawable="@drawable/bg_lyric_hairline_progress"
                android:thumb="@drawable/lyr_hairline_thumb" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
