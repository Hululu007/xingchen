<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Music 主题：背景层即全屏封面糊底（activity 层 ivBgBlur＋fluidAmbient，本文件无主题层背景视图，与默认主题一致）；
     大封面居中上部＋歌名/歌手/专辑行（右侧圆形玻璃爱心 tpBtnFav＋更多钮 tpBtnMenu，GZ Apple 口径）
     ＋6dp 进度＋96dp 运输键行＋系统音量条＋52dp 功能筹行。不内嵌歌词（GZ Apple 这面不放歌词，底行歌词键开歌词版本选择面板，不进全屏歌词页）。
     数值照 GZ 参数表 Apple 节。下一首块不在本主题（并行子工正在全 app 拿掉下一首块＋进度条下放，本文件不碰进度线位置）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="0dp"
    android:paddingBottom="22dp">

    <!-- 大封面：GZ Apple 封面横向边距 0、weight=1 铺满（24dp 是下方标题列的，不是封面的）；
         故根不再统一垫 24dp：封面全宽，标题列／进度／音量各段自垫 24dp（运输／功能行居中，不受根垫影响）。
         封面不写 elevation：瓜子封面 elevation 没抠到，10dp 会把上叠 −12dp 的标题压在封面层之下。 -->
    <FrameLayout
        android:id="@+id/tpCoverWrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">

        <ImageView
            android:id="@+id/tpCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 出场封面层（redo3 F1）：切歌时旧封面暂存于此做 出场动画，平时 gone -->
        <ImageView
            android:id="@+id/tpCoverExit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 歌名 20sp/800/白 0.96 / 歌手 14sp/500/白 0.60（歌名→歌手间距 5dp）/ 专辑独立第三行 12sp/500/白 0.42
         （GZ Apple 原第三行专辑行：行高 18dp、12sp、行高 16dp、白 0.42；专辑仅非空且≠未知专辑时显；不是来源·实测音质，来源·实测音质行已拿掉）；
         标题列相对封面下沿上叠 −12dp（layout_marginTop="-12dp"），横向自垫 24dp（根不再垫）；
         右侧圆形玻璃爱心＋更多钮（GZ Apple 口径：盒 34dp、图标 20dp、白 0.85、底面白 0.14、圆形、按压 0.88；
         爱心键前 8dp、爱心与三个点之间 12dp；两键 id 均为 activity 通用接线，
         tpBtnFav→toggleFavorite＋paintFavoriteIcons，tpBtnMenu→showToolsSheet，无需改 activity）。
         头上不再重复加播放/队列键——运输行已有 tpPlay、底行已有 tpQueue，重复加只会造两个播放键/两个队列键。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tpTitle"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:ellipsize="end"
                android:fontWeight="800"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:lineHeight="26dp"
                android:maxLines="1"
                android:textColor="#F5FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 歌手行：歌手单行，点进歌手搜索；右侧玻璃爱心仍是收藏键 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontWeight="500"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="18dp"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 专辑独立第三行（GZ Apple：行高 18dp、12sp、行高 16dp、白 0.42；空或“未知专辑”时隐藏，
                 显隐由 activity bindTrackViews 按 Apple 口径控制；歌手→专辑间距对差表未给值，此处不另加间距） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpAlbum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontWeight="500"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="16dp"
                    android:maxLines="1"
                    android:textColor="#6BFFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/tpBtnFav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_glass_btn"
            android:contentDescription="@string/music_favorite"
            android:padding="7dp"
            android:src="@drawable/ic_music_heart"
            android:tint="#D9FFFFFF" />

        <ImageView
            android:id="@+id/tpBtnMenu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_player_glass_btn"
            android:contentDescription="@string/music_more"
            android:padding="7dp"
            android:src="@drawable/ic_music_menu"
            android:tint="#D9FFFFFF" />
    </LinearLayout>

    <!-- 进度：轨道 6dp、横向 24dp（根不再垫，SeekBar 自垫）；Apple 调用无底时间行（redo3 A5），故不设底行 -->
    <SeekBar
        android:id="@+id/tpSeek"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:progressDrawable="@drawable/bg_player_seek6_progress"
        android:thumb="@drawable/bg_player_seek_thumb" />

    <!-- 运输键行：高 96dp；进度后整行上叠 −18dp（GZ 底部栈口径）；上/下一首盒 56、播放盒 84（按压缩放代码侧 0.88/0.9） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="-18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tpPrev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/music_prev"
            android:paddingStart="4dp"
            android:paddingTop="7dp"
            android:paddingEnd="4dp"
            android:paddingBottom="7dp"
            android:src="@drawable/ic_music_prev"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpPlay"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/pl_play_pause"
            android:paddingStart="12dp"
            android:paddingTop="15.75dp"
            android:paddingEnd="12dp"
            android:paddingBottom="15.75dp"
            android:src="@drawable/ic_music_pause"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/music_next"
            android:paddingStart="4dp"
            android:paddingTop="7dp"
            android:paddingEnd="4dp"
            android:paddingBottom="7dp"
            android:src="@drawable/ic_music_next"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- A2：系统音量行（STREAM_MUSIC；横向 24dp，行自垫；控制行后间隔 6dp）：
         瓜子 AppleMusicVolumeSlider 本体只有滑杆一行、无两端图标盒——旧两端 32dp 图标盒已删；
         音量条走专属轨色（底白 0.14、填充渐变 0.42→0.6，见 bg_player_volume_progress），
         不与进度条共用 seek6（进度填充纯色 0.58，与瓜子音量渐变轨色不符）；
         接线不变：tpVolume 仍走 wireVolume 系统音量。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <SeekBar
            android:id="@+id/tpVolume"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progressDrawable="@drawable/bg_player_volume_progress"
            android:thumb="@drawable/bg_player_seek_thumb" />
    </LinearLayout>

    <!-- 功能筹行：高 52dp，音量条后间隔 2dp（redo3 A1），图标 歌词24/音质24/播放列表28，间距 48dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tpBtnLyric"
            android:alpha="0.5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_tab_lyric"
            android:padding="8dp"
            android:src="@drawable/ic_music_note"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpBtnQuality"
            android:alpha="0.5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:contentDescription="@string/music_quality"
            android:padding="8dp"
            android:src="@drawable/ic_music_eq"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpQueue"
            android:alpha="0.5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/music_queue"
            android:padding="8dp"
            android:src="@drawable/ic_music_queue"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
