<?xml version="1.0" encoding="utf-8"?>
<!-- Emby 服务器管理页：服务器列表（Yamby 式卡片＋⋮ 菜单）+ 加服/编辑表单；风格与设置页卡片统一 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_control_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emby_server_manage"
                android:textColor="#0C0E12"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/xc_capsule_yellow"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingVertical="8dp"
                android:text="@string/emby_add_server"
                android:textColor="#0C0E12"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/emby_section_servers_sub"
            android:textColor="#1B2431"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/container_servers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_no_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/xc_setcard_v2"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/emby_no_server"
            android:textColor="#1B2431"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 加服 / 重登表单 -->
        <LinearLayout
            android:id="@+id/form_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_alias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/xc_input_bg"
                android:hint="@string/emby_hint_alias"
                android:inputType="text"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#0C0E12"
                android:textColorHint="#8E97A8"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xc_input_bg"
                android:hint="@string/emby_hint_host"
                android:inputType="textUri"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#0C0E12"
                android:textColorHint="#8E97A8"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_proto_https"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/xc_capsule_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="HTTPS"
                    android:textColor="#0C0E12"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_proto_http"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/xc_input_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="HTTP"
                    android:textColor="#0C0E12"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_port"
                    android:layout_width="104dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/xc_input_bg"
                    android:hint="@string/emby_hint_port"
                    android:inputType="number"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textAlignment="center"
                    android:textColor="#0C0E12"
                    android:textColorHint="#8E97A8"
                    android:textSize="14sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xc_input_bg"
                android:hint="@string/emby_hint_path"
                android:inputType="textUri"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#0C0E12"
                android:textColorHint="#8E97A8"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/emby_alt_url_title"
                android:textColor="#0C0E12"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_alt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btn_alt_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/xc_capsule_light"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/emby_alt_url_add"
                android:textColor="#0C0E12"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_icon_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xc_capsule_light"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/emby_icon_reset"
                android:textColor="#0C0E12"
                android:textSize="13sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/et_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xc_input_bg"
                android:hint="@string/emby_hint_user"
                android:inputType="text"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#0C0E12"
                android:textColorHint="#8E97A8"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xc_input_bg"
                android:hint="@string/emby_hint_pass"
                android:inputType="textPassword"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#0C0E12"
                android:textColorHint="#8E97A8"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emby_form_proxy"
                        android:textColor="#0C0E12"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/emby_form_proxy_sub"
                        android:textColor="#1B2431"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_form_proxy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#E5484D"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_cancel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/xc_capsule_light"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/emby_btn_cancel"
                    android:textColor="#0C0E12"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_login"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/xc_capsule_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/emby_btn_ping_login"
                    android:textColor="#0C0E12"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
