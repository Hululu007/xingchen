<?xml version="1.0" encoding="utf-8"?>
<!-- 评论行（官方实拍 113610）：头像＋灰名在正文上、正文黑字、右列心形＋数
     上下排；元信息行＝短时间＋回复；展开回复行＝前导线＋文案＋下箭头。
     回复楼层是独立行（item_hongguo_reply），不再塞进本行的容器。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/hg_c_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="头像" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hg_c_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF8A8A8A"
                android:textSize="13sp" />

            <!-- 剧评分星（剧评页签专用，十分制折五星；控件在代码里点亮）。 -->
            <LinearLayout
                android:id="@+id/hg_c_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_hg_author_star_off" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_hg_author_star_off" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_hg_author_star_off" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_hg_author_star_off" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_hg_author_star_off" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/hg_c_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#FF1F1F1F"
                android:textSize="15sp" />

            <!-- 长文截断时盖在末行右端的「… 展开」（白底垫字，形态照实拍）。 -->
            <TextView
                android:id="@+id/hg_c_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="#FFFFFFFF"
                android:paddingStart="4dp"
                android:text="… 展开"
                android:textColor="#FF3D7DD8"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/hg_c_collapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="收起"
            android:textColor="#FF3D7DD8"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hg_c_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9A9A9A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hg_c_reply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="回复"
                android:textColor="#FF9A9A9A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 展开回复行：前导横线＋「展开N条回复」＋下箭头（展开后转「收起」文案）。 -->
        <LinearLayout
            android:id="@+id/hg_c_replies_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:background="#FFE3E3E3" />

            <TextView
                android:id="@+id/hg_c_replies_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FF5C5C5C"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/hg_c_replies_chev"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_hg_chevron_down" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右列点赞：心形＋计数上下排（点按走 comment/do_action 乐观更新）。 -->
    <LinearLayout
        android:id="@+id/hg_c_like_box"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/hg_c_like_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="点赞" />

        <TextView
            android:id="@+id/hg_c_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FF8A8A8A"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
