<?xml version="1.0" encoding="utf-8"?>
<!-- 播放队列面板（GZ PlayQueueSheet＋SheetSubPanelHeader 证据 redo2-gz-queue-evidence）：
     面板底＝全 App 同源液态玻璃 MusicGlassDrawable（代码装配、仅顶角 16dp；fa37c4e0 的实白底已被用户点名作废，
     其贴底坐标修正保留）；高度占比 0.68＝PlayQueueSheetKt:343 实读、根上内距 12dp 同出；
     头部 44dp＝[标题 17sp/800] [模式筹·模式串常显] [计数筹·纯数字] [清空·红] [✕ 圆钮 40]，
     头部不放自己的返回箭头，✕ 关闭钮保留；来源行（队列级来源、全队一致才显示）；提示行「长按拖动调整顺序」；列表最大高屏高 0.68（代码钳）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="-0.0176"
            android:text="@string/sheet_queue_title"
            android:textColor="#F2F2F7"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontWeight="800" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/badgeShuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sheet_chip_shuffle"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="@string/sheet_queue_shuffle"
            android:textColor="#FA243C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/sheet_chip_inset"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/music_clear"
            android:textColor="#FA243C"
            android:textSize="13sp"
            android:fontWeight="500" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_music_glass_circle"
            android:contentDescription="@string/music_close"
            android:padding="11dp"
            android:src="@drawable/ic_music_close"
            android:tint="#B3FFFFFF" />
    </LinearLayout>

    <!-- 来源行：≣♪ 来自 X（优先读入队时写的队列级来源；老断点队列回落反查，全队同源才显示；
         route 可解析时给 › 且可点跳来源页，无 route 时只展示不可点） -->
    <LinearLayout
        android:id="@+id/sourceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_sheet_source"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_music_queue"
            android:tint="#8E8E93" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/sheet_queue_from"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:fontWeight="500" />

        <TextView
            android:id="@+id/sourceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2F2F7"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontWeight="600" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:text="@string/sheet_queue_hint"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:overScrollMode="never"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:id="@+id/emptyBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.45"
            android:contentDescription="@null"
            android:src="@drawable/ic_music_note"
            android:tint="#99FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sheet_queue_empty"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
