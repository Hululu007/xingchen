<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏歌词页（独立页，照瓜子全屏歌词面构成＋gz-player-values 第八节）：
     底层＝封面氛围（dominant 色＋糊封面）＋原封面整屏垫底向下溶入氛围（FadingCoverView，与播放页同一套）；
     歌词舞台铺满整屏（行可穿标题之下、靠舞台内 40dp 顶渐隐带收，锚点/淡出按整屏高口径）；
     标题行（歌名＋右三裸键 队列/歌词样式/播放暂停→歌手♡专辑行）与底部均为覆盖层；
     底部只留逐行/逐字双筹＋一条发丝进度线，不带音质筹/可拖轨道/时间行。
     无自带返回箭头（铁律），回上一页走系统返回；顶部状态栏留白由 Activity 按窗口嵌饰给标题行。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyricRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1C1C1E">

    <com.fongmi.android.tv.ui.music.view.CoverAmbientView
        android:id="@+id/lyricAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.music.view.FadingCoverView
        android:id="@+id/lyricCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <com.fongmi.android.tv.ui.music.view.MusicLyricStageView
        android:id="@+id/lyricStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/lyricMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lyricTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="-0.0222"
                android:maxLines="1"
                android:textColor="#F2FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/lyricBtnQueue"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/player_queue"
                    android:padding="10dp"
                    android:src="@drawable/ic_music_queue"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/lyricBtnStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/player_lyric_style"
                    android:padding="10dp"
                    android:src="@drawable/ic_lyric_wave"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/lyricBtnPlay"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/player_play_pause"
                    android:padding="6dp"
                    android:src="@drawable/ic_music_pause"
                    android:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lyricArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#73FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/lyricBtnFav"
                android:layout_width="27dp"
                android:layout_height="22dp"
                android:contentDescription="@string/player_favorite"
                android:paddingStart="7dp"
                android:paddingTop="4.5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="4.5dp"
                android:src="@drawable/ic_music_heart" />

            <TextView
                android:id="@+id/lyricAlbum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#73FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyricBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="45dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lyricChipLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lyric_capsule"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/music_lyric_chip_line"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lyricChipWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_lyric_capsule"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/music_lyric_chip_word"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/lyricProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_lyric_hairline_progress" />
    </LinearLayout>
</FrameLayout>
