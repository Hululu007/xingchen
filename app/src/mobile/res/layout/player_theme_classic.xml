<?xml version="1.0" encoding="utf-8"?>
<!-- 经典主题（默认）：封面在上→歌名行（三键）→功能筹行→内嵌歌词(4行窗口)→细进度→主控行。数值照 GZ 参数表。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- 封面区（占上部）：手势在代码侧挂 tpCoverWrap（双击收藏/长按工具面板/横滑切歌） -->
    <FrameLayout
        android:id="@+id/tpCoverWrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.4"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/tpCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="12dp"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- 歌名行：歌名 18sp/行高24、歌手 14sp 在其下；右侧三键点击区 40dp（收藏/播放列表/菜单） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tpTitle"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tpArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tpBtnFav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_favorite"
            android:padding="10dp"
            android:src="@drawable/ic_music_heart" />

        <ImageView
            android:id="@+id/tpBtnQueueTitle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_queue"
            android:padding="10dp"
            android:src="@drawable/ic_music_queue"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpBtnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/music_more"
            android:padding="9dp"
            android:src="@drawable/ic_music_more"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 功能筹行（毛玻璃筹，照定稿图）：收藏/下载/音质(实测值)/音效 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:id="@+id/tpChipFav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_player_chip"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tpChipFavIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_music_heart"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/music_favorite"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tpChipDownload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_chip"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_music_download"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/music_download"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tpChipQuality"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_chip"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tpQualityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/music_quality"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tpChipFx"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_chip"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_music_eq"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/music_fx"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 内嵌歌词：横向内边距 28dp、窗口 4 行（组件 cover 模式）；单击打开全屏歌词页 -->
    <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
        android:id="@+id/tpLyricView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="3"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />

    <!-- 细进度：轨道 4dp、时间标签 11sp 两端宽 40dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <SeekBar
            android:id="@+id/tpSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/bg_player_seek_progress"
            android:thumb="@drawable/bg_player_seek_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tpPosition"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tpDuration"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部主控行：模式/上一首 52/播放 72/下一首 52/队列（潇洒哥既定尺寸） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/tpMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_play_all"
            android:padding="12dp"
            android:src="@drawable/ic_music_sequential" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_music_prev"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpPlay"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_player_play_ring"
            android:padding="22dp"
            android:src="@drawable/ic_music_pause"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_music_next"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpQueue"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_queue"
            android:padding="12dp"
            android:src="@drawable/ic_music_queue" />
    </LinearLayout>
</LinearLayout>
