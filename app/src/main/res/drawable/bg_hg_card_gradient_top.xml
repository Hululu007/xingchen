<?xml version="1.0" encoding="utf-8"?>
<!-- 红果搜索双列卡封面顶部渐变：官方 amy.xml 原值——angle 270、
     #26000000（oj）→ #01000000（oa），32dp 高压在封面上沿。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#01000000"
        android:startColor="#26000000"
        android:type="linear" />
</shape>
