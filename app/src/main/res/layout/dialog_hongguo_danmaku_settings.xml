<?xml version="1.0" encoding="utf-8"?>
<!-- 红果弹幕设置单（官方 DanmakuOptionDialog 竖屏 a57 抠值）：单底
     #FFFAFAFA 顶圆角 12dp（acw）；标题 16sp 黑居中、右上「恢复默认」
     14sp #66000000（bhw）；四滑杆收进一张白卡（ad1：白底圆角 12dp、
     内距 16dp），组间距 24dp；签 14sp #FF000000、值 14sp #66000000；
     滑杆 28dp 高（DanmakuSeekBar 口径）：轨道垫 #FFF7F7F7（ad5）、
     进度渐变 #4D757575→#4D454545（add）、白圆钮 20dp（adl），
     左右内距 6dp、thumbOffset 2dp。改值即存 HgStore 红果自有键并
     即时回刷渲染层（HongguoFeedActivity.showDanmakuSettings）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hg_dm_settings_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="弹幕设置"
            android:textColor="#FF000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hg_dm_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="恢复默认"
            android:textColor="#66000000"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_hg_dm_settings_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="不透明度"
                android:textColor="#FF000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hg_dm_opacity_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#66000000"
                android:textSize="14sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/hg_dm_opacity"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hg_dm_seek_bg"
            android:max="80"
            android:maxHeight="28dp"
            android:minHeight="28dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:progressDrawable="@drawable/bg_hg_dm_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/hg_dm_seek_thumb"
            android:thumbOffset="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="移动速度"
                android:textColor="#FF000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hg_dm_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#66000000"
                android:textSize="14sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/hg_dm_speed"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hg_dm_seek_bg"
            android:max="4"
            android:maxHeight="28dp"
            android:minHeight="28dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:progressDrawable="@drawable/bg_hg_dm_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/hg_dm_seek_thumb"
            android:thumbOffset="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="显示区域"
                android:textColor="#FF000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hg_dm_area_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#66000000"
                android:textSize="14sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/hg_dm_area"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hg_dm_seek_bg"
            android:max="3"
            android:maxHeight="28dp"
            android:minHeight="28dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:progressDrawable="@drawable/bg_hg_dm_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/hg_dm_seek_thumb"
            android:thumbOffset="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="字体大小"
                android:textColor="#FF000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hg_dm_font_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#66000000"
                android:textSize="14sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/hg_dm_font"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hg_dm_seek_bg"
            android:max="4"
            android:maxHeight="28dp"
            android:minHeight="28dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:progressDrawable="@drawable/bg_hg_dm_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/hg_dm_seek_thumb"
            android:thumbOffset="2dp" />
    </LinearLayout>
</LinearLayout>
