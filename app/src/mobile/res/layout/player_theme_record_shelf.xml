<?xml version="1.0" encoding="utf-8"?>
<!-- 黑胶唱片架主题：横向队列陈列（每项封面方卡＋右侧滑出黑胶圆盘，当前项盘 30°/s 旋转，项视图由代码建）；
     下方白色歌词卡内嵌 KaraokeLyricsView（浅色方案）；底部主控行同经典。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <!-- 歌名 15sp/行高 21sp、歌手 11sp/行高 15sp（GZ RecordShelfPlayerKt:615-616） -->
    <TextView
        android:id="@+id/tpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineHeight="21dp"
        android:maxLines="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tpArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineHeight="15dp"
        android:maxLines="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <!-- 唱片架横滑陈列 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tpShelfList"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none" />

    <!-- 白色歌词卡 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_player_lyric_card_light"
        android:padding="8dp">

        <com.fongmi.android.tv.ui.custom.KaraokeLyricsView
            android:id="@+id/tpLyricView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 细进度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <SeekBar
            android:id="@+id/tpSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/bg_player_seek_progress"
            android:thumb="@drawable/bg_player_seek_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tpPosition"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.018"
                android:text="00:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tpDuration"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.018"
                android:text="00:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部主控行（同经典） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/tpMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_music_sequential" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_music_prev"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpPlay"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_player_play_ring"
            android:padding="22dp"
            android:src="@drawable/ic_music_pause"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tpNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_music_next"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tpBtnFav"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/music_favorite"
            android:padding="13dp"
            android:src="@drawable/ic_music_heart" />
    </LinearLayout>
</LinearLayout>
