<?xml version="1.0" encoding="utf-8"?>
<!-- 红果更多面板（他 2026-10-28 定五项：倍速/清晰度/弹幕/投屏/定时关闭；
     同日 22:40 补钉弹幕设置行 hg_panel_danmaku_settings，关藏开出）。
     质感口径照官方 V2 面板（aii＋实拍 113510）：单底 #FFFAFAFA 顶圆角
     16dp（an0/aac），内容收进白卡（sp：白、圆角 8dp、左右 16dp）分层；
     行首带官方同形线图标/字形徽标（仪表/HD 框/弹框/投屏/闹钟），行尾
     真箭头 ic_hg_chevron_right（原字形「›」清零）；开关走社区浅色板
     （开 #FFFA6725、关 #FFCCCCCC、白钮）。筹轨道/选中片走
     bg_hg_panel_track/chip_on。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hg_panel_sheet"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hg_ep_grab" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_hg_panel_card"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_panel_speed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="当前倍速"
                android:textColor="#FF111111"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_panel_speed_row"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_hg_panel_track"
            android:orientation="horizontal"
            android:padding="3dp" />

        <LinearLayout
            android:id="@+id/hg_panel_def_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_hg_panel_badge"
                android:gravity="center"
                android:text="HD"
                android:textColor="#FF111111"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="清晰度"
                android:textColor="#FF111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/hg_panel_def_row"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hg_panel_track"
                android:gravity="end"
                android:orientation="horizontal"
                android:padding="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_hg_panel_badge"
                android:gravity="center"
                android:text="弹"
                android:textColor="#FF111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="弹幕"
                android:textColor="#FF111111"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/hg_panel_danmaku_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false"
                android:switchPadding="5dp"
                android:thumb="@drawable/hg_panel_switch_thumb"
                android:track="@drawable/hg_panel_switch_track" />
        </LinearLayout>

        <!-- 弹幕设置行：弹幕开时才在（showMorePanel 按开关态定显隐、面板内
             拨开关即时跟随），关时整行摘除，与官方 insert/remove 同口径。 -->
        <LinearLayout
            android:id="@+id/hg_panel_danmaku_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_hg_panel_badge"
                android:gravity="center"
                android:text="弹"
                android:textColor="#FF111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="弹幕设置"
                android:textColor="#FF111111"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_chevron_right" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_hg_panel_card"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/hg_panel_cast"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_panel_cast" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="投屏"
                android:textColor="#FF111111"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hg_panel_timer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_panel_timer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="定时关闭"
                android:textColor="#FF111111"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/hg_panel_timer_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="关闭"
                android:textColor="#FF999999"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hg_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
