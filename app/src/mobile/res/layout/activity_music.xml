<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐首页 v7 定稿：浅色底／标题＋搜索胶囊＋⋮／五快捷白卡／三张渐变入口卡／心情电台卡。
     底部迷你条是 ListenMiniBar 悬浮条（只在音乐首页显示），本页不内嵌。
     无返回箭头（铁律），界面只放名字和状态，无介绍文字。
     离边口径（2026-10-21 15:28 纠正，前令作废）：16dp 指卡片离屏两边的边距，不是圆角——
     根布局左右内边距 16dp（代码侧再按状态栏高垫顶，见 MusicActivity）；圆角一律不动
     （搜索胶囊 24dp、三彩卡 20dp、五快捷 16dp，均为现状保持）。
     根布局不吃 fitsSystemWindows：旧版 fitsSystemWindows=true 时系统左右 inset（0）会盖掉 XML 的边距，
     实机卡片贴边；改由代码固定 16dp 离边＋状态栏高垫顶。
     首页顺序定死：标题 → 搜索胶囊条 → 五快捷白卡 → 三彩卡 → 心情电台卡 → 榜单白卡。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 全域统一背景（批 5 F1）：MusicGlassBackgroundView 单一实现，后批各页同款复用 -->
    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/homeGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<ScrollView
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:scrollbars="none">
    <!-- 内层承内容：边距由 MusicActivity 代码打在 ScrollView 根上（左右 16dp、顶＝状态栏高＋12dp、底 16dp），
         这里不许再写内边距，否则双倍。ScrollView 量测链是不定高（UNSPECIFIED）：三彩卡里的光晕
         （match_parent）首遍量 0 不撑卡高，卡高由文字列定约 124dp；FrameLayout 二次测量再把光晕铺满卡面。
         之前卡被拉满屏，就是根 LinearLayout 的 AT_MOST 剩余高度经 match_parent 光晕传进卡里。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- ⓪ 首页标题（GZ HomeTopBar 样式：28sp／800／字距 -0.8／颜色 #1C1C1E／下 2dp；
         文案按他亲口定用“星辰音乐”（不用 GZ 的“发现好音乐”）；另加歌词同款斜度 skewX(-0.12f)；
         顶距＝代码垫顶（状态栏高＋12dp）＋标题上边距 8dp（他 18:06 令整体下移一档，用户审美令高于 GZ 值）；
         搜索条下移量＝标题块高度（28sp 行高约 34dp＋下 2dp，约 36dp，真机实测为准） -->
    <!-- 批 5 F2／第十稿顶行：渐变标题字＋小金星＋右上角黑胶唱片斜探出画面；
         F1 按 brief 加的头像占位＋问候副行在定稿（对照单 §九与第十稿构成）里没有，摘除 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="2dp"
            android:text="星辰音乐"
            android:textColor="#1C1C1E"
            android:textSize="24sp"
            android:letterSpacing="-0.029"
            android:fontWeight="800"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="★"
            android:textColor="#FFF5A623"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/homeVinyl"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="-14dp"
            android:layout_marginEnd="-10dp"
            android:background="@drawable/bg_music_home_vinyl"
            android:rotation="24" />
    </LinearLayout>

    <!-- ① 搜索条＋右侧 ⋮（高 48dp、圆角 24dp 保持不动；上距 8dp＝他 18:07 令标题与搜索框拉开，用户审美令） -->
    <LinearLayout
        android:id="@+id/homeSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_music_glass_search"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/home_ic_search" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/home_search_hint"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:fontWeight="500" />

        <ImageView
            android:id="@+id/homeBtnMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_more"
            android:padding="10dp"
            android:src="@drawable/home_ic_more_vert" />
    </LinearLayout>

    <!-- ⓪½ 通知权限提示条：没授权时才出现（默认 gone，MusicActivity.onResume 按权限实读切换）；
         深底白字＋黄钮，不用白底；已授权永远不出现、不占位 -->
    <LinearLayout
        android:id="@+id/notifPermStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/home_bg_notif_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="通知权限未开启，后台放歌时通知栏不会显示播放条"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notifPermGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/home_bg_notif_btn"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="去开启"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ② 五快捷：一张玻璃白卡内五格（第十稿定案「五入一卡」，不许拆成五张独立方格——
         1.4.27 真机截图里五格各带一张玻璃片、与定案不符，本批并卡）；格内图标＋名字＋数量
         （皮照参照图 112782_4：柔和粉彩图标、标签粗黑、数字浅灰） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_music_glass_white_card"
        android:elevation="2dp"
        android:padding="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/homeQuickFavorite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_favorite" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_favorite"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickSheets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_sheets" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_sheets"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountSheets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_device" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_device"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickRecent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_recent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_recent"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeQuickDownload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="11dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/home_ic_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"
                android:text="@string/home_download"
                android:textColor="#141414"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCountDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#B2B2B2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 继续播放白卡（批 5 F2 按第十稿改回四封面横排，压过 F1 的单曲形态）：
         头行「继续播放」标＋右上圆播放键；下行最近播放前 4 首封面横排（代码填充 homeContinueCovers），
         点封面播该首（以历史为队列续接）、圆键续最近一首；不足 4 首按实数显、零首整卡 GONE 不留空洞 -->
    <LinearLayout
        android:id="@+id/homeContinueCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_music_glass_white_card"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_continue"
                android:textColor="#FA243C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeContinueTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#999999"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/homeContinuePlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_music_continue_play"
                android:clickable="true"
                android:contentDescription="@string/home_play"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_music_play"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeContinueCovers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- ③ 三张渐变入口卡横排垫底（上距 40dp＝往下移＋拉开，见表 H7；卡间横向间距 10dp 不动）
         卡内间隔＝权重 Spacer：Spacer 高＝基准参量（非汽车 30dp／汽车 48dp，见 values[-car]/dimens.xml）
         ＋权重 1 撑满剩余空间；卡 FrameLayout 与内列改 match_parent，使权重有撑满空间、图标底对齐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/homeCardGuess"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_music_glass_entry"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="10dp">

            <com.fongmi.android.tv.ui.view.HomeEntryHaloView
                android:id="@+id/homeHaloGuess"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_guess"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:lineHeight="19dp"
                    android:letterSpacing="-0.029"
                    android:fontWeight="800"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_guess_sub"
                    android:textColor="#8C1C1C1E"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_entry_icon_spacer"
                android:layout_weight="1" />

            <!-- 封面堆（批 5 F2／第十稿）：三张封面错位叠放，数据由代码填（榜单前 3 封面，无数据时回落历史封面，再无则不显） -->
            <FrameLayout
                android:id="@+id/homeGuessStack"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/homeGuessCover3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:rotation="10"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeGuessCover2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:alpha="0.8"
                    android:contentDescription="@null"
                    android:rotation="-6"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeGuessCover1"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|start"
                    android:contentDescription="@null"
                    android:rotation="-12"
                    android:scaleType="centerCrop" />
            </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/homeCardCharts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_music_glass_entry"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="10dp">

            <com.fongmi.android.tv.ui.view.HomeEntryHaloView
                android:id="@+id/homeHaloCharts"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_charts"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:lineHeight="19dp"
                    android:letterSpacing="-0.029"
                    android:fontWeight="800"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_charts_sub"
                    android:textColor="#8C1C1C1E"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_entry_icon_spacer"
                android:layout_weight="1" />

            <!-- 前三名小列表（批 5 F2／第十稿）：数据由代码填（当前榜签前 3 名），无数据整列不显 -->
            <LinearLayout
                android:id="@+id/homeCardChartList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/homeCardChart1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3A3A3C"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />

                <TextView
                    android:id="@+id/homeCardChart2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3A3A3C"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />

                <TextView
                    android:id="@+id/homeCardChart3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3A3A3C"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/homeCardShuffle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_music_glass_entry"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="10dp">

            <com.fongmi.android.tv.ui.view.HomeEntryHaloView
                android:id="@+id/homeHaloShuffle"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_shuffle"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:lineHeight="19dp"
                    android:letterSpacing="-0.029"
                    android:fontWeight="800"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeShuffleSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_shuffle_sub"
                    android:textColor="#8C1C1C1E"
                    android:textSize="9sp"
                    android:lineHeight="13dp" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/home_entry_icon_spacer"
                android:layout_weight="1" />

            <!-- 发光播放盘（批 5 F2／第十稿）：柔光晕＋深墨盘＋白三角，整卡点按仍进随心听页 -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_music_home_glow_disc" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_play"
                    android:tint="#FFFFFF" />
            </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 心情电台卡（GZ MoodRadioPanel：圆角 20dp、横向三色渐变（按选中心情换色，向白混合 0.08/0.20/0.32，代码侧算）、
         区头 10sp/600/字距0.1/行高14sp＋12dp 箭头标、当前心情大字 22sp/700/字距-0.4/行高28sp、
         文案 11sp/行高16sp、纵向间距 6dp、波形区宽 0.44 比例×高 92dp（播放振幅 1.0／暂停 0.35）、
         pills 行间距 8dp、行边距 12/0/12/12dp、pill 高 36dp、内边距 12/8dp、圆点 5dp、文字 12sp/行高16sp、
         选中字重700底 tone 0.18、未选中字重500、播放钮 40dp 圆、横向渐变 tone→tone 向白混合 0.22、
         图标播放中 18dp／未播放 24dp、按压缩放 0.9；卡前间隔 20dp（GZ）；
         卡内边距／波形色／钮旁状态文字号未抠到，星辰侧自定 16dp／tone 0.7／11sp；
         队列标题「心情电台 · XX」、搜不到 toast 同款；默认选中＝上次选择（prefs），无则怀旧；
         “是本心情”判定＝ prefs 快照与现队列同序同曲（同随心听副题口径），不留假态） -->
    <LinearLayout
        android:id="@+id/homeMoodCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_music_glass_entry"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.56"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="心情电台"
                        android:textColor="#1C1C1E"
                        android:textSize="10sp"
                        android:lineHeight="14dp"
                        android:letterSpacing="0.01"
                        android:fontWeight="600"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_player_chevron_right"
                        android:tint="#1C1C1E" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMoodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#1C1C1E"
                    android:textSize="22sp"
                    android:lineHeight="28dp"
                    android:letterSpacing="-0.018"
                    android:fontWeight="700"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMoodCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#5A5A5E"
                    android:textSize="11sp"
                    android:lineHeight="16dp" />
            </LinearLayout>

            <com.fongmi.android.tv.ui.view.MoodWaveView
                android:id="@+id/moodWave"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="0.44" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/moodPills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvMoodState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#5A5A5E"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/btnMoodPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_music_play" />
        </LinearLayout>
    </LinearLayout>

    <!-- ④ 榜单白卡（用户 06:20 令，形态照参照图 112784_6：卡头榜名＋完整榜单、
         左封面叠放带播放三角、右前 3 名、底榜签行；数据只用酷我＋QQ 真榜，取不到整卡隐藏） -->
    <LinearLayout
        android:id="@+id/homeChartCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_music_glass_entry"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeChartTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#141414"
                android:textSize="20sp"
                android:lineHeight="26dp"
                android:letterSpacing="-0.02"
                android:fontWeight="800"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeChartMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/home_chart_more"
                android:textColor="#9A9AA0"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/homeChartMoreIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@null"
                android:src="@drawable/ic_player_chevron_right"
                android:tint="#9A9AA0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeChartContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="90dp">

                <ImageView
                    android:id="@+id/homeChartCover3"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="50dp"
                    android:alpha="0.5"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeChartCover2"
                    android:layout_width="67dp"
                    android:layout_height="67dp"
                    android:layout_marginStart="25dp"
                    android:alpha="0.75"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeChartCover1"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/homeChartPlay"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/home_bg_chart_play"
                    android:contentDescription="@string/home_chart_play"
                    android:padding="4dp"
                    android:src="@drawable/ic_music_play" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/homeChartRow1"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="#141414"
                        android:textSize="13sp"
                        android:lineHeight="18dp"
                        android:fontWeight="800"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeChartName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="18sp"
                        android:text=" · "
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/homeChartArtist1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeChartRow2"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="#141414"
                        android:textSize="13sp"
                        android:lineHeight="18dp"
                        android:fontWeight="800"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeChartName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="18sp"
                        android:text=" · "
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/homeChartArtist2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeChartRow3"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="#141414"
                        android:textSize="13sp"
                        android:lineHeight="18dp"
                        android:fontWeight="800"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/homeChartName3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="18sp"
                        android:text=" · "
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/homeChartArtist3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="#9A9AA0"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 第二波：榜单卡空态（瓜子 HomeRankingCardKt：「暂未获取到榜单」12sp／行高 18sp＋「点击重试」11sp／行高 16sp accent 色、按压 0.96；
             星辰侧无现成按压 helper，按压缩放未实现；签行保留可切榜） -->
        <LinearLayout
            android:id="@+id/homeChartEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineHeight="18sp"
                android:text="@string/wave2_home_chart_empty"
                android:textColor="#8E8E93"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/homeChartEmptyRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineHeight="16sp"
                android:padding="4dp"
                android:text="@string/wave2_home_chart_retry"
                android:textColor="#FA243C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 第二波：榜单卡加载态（瓜子 HomeRankingCardKt：「正在加载榜单」＋16dp 转圈；加载文字字号未完全解码，沿用空态 12sp） -->
        <LinearLayout
            android:id="@+id/homeChartLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="#FA243C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/wave2_home_chart_loading"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeChartTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 第二波：聆听报告卡（只用本地数据：播放记录数＋收藏数＋最爱歌手；记录为空时代码隐藏整卡，不编假数据） -->
    <LinearLayout
        android:id="@+id/homeReportCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_music_glass_entry"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wave2_report_title"
            android:textColor="#141414"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeReportStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/homeReportTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#1C1C1E"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 底部留白：给悬浮迷你条让位（条只在有音乐会话时出现）。
         条高 76dp（56＋上下各 10）＋底边距（导航 inset＋12dp），手势导航下约 104dp；
         定高留白，不用 weight（ScrollView 不定高下 weight 无效），滚到底时榜单卡正好露在条上方。 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="104dp" />
    </LinearLayout>
</ScrollView>
</FrameLayout>
