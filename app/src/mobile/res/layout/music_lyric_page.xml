<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏歌词页（定案形态＝他的图 112930＋2026-10-22「歌词页重做」定案）：
     背景＝封面模糊底（播放页喂糊底位图，上盖半透取色罩保可读；歌词页模糊值未单独抠到、与播放页糊底同配方）；
     页眉＝封面缩略图＋歌名＋歌手＋右上 Tr 钮（点开主歌词三选菜单，原文恒有、翻译/音译有数据才出）；
     歌词左对齐沉浸滚动。没有底部进度条、没有底部按键。
     录屏 f001 的形态（清封面＋歌名行队列/暂停键）是瓜子的另一歌词面，与本页定案不同——
     本页以 112930 定案为准，冲突在五主题对照表单列。头行纵向位置由 MusicLyricPageView 按状态栏高在代码里落位。 -->
<com.fongmi.android.tv.ui.music.MusicLyricPageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- 背景：封面糊底（代码喂位图，API31+ 另挂 24dp 模糊效，与整页糊底同口径） -->
    <ImageView
        android:id="@+id/ivLyricCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- 页眉：缩略图＋歌名/歌手列＋Tr 钮 -->
    <LinearLayout
        android:id="@+id/lyricHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/ivLyricThumb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLyricTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontWeight="800"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#F2FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLyricArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tr 钮：40dp 玻璃圆（底由代码刷），点开主歌词三选菜单 -->
        <TextView
            android:id="@+id/btnLyricTr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Tr"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 歌词区：左对齐沉浸滚动，横向垫 28dp；纵向起点代码落位（页眉之下） -->
    <com.fongmi.android.tv.ui.music.FullLyricView
        android:id="@+id/lyricFullView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp" />
</com.fongmi.android.tv.ui.music.MusicLyricPageView>
