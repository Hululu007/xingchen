<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐底部工具面板（浅色令牌照 GZ 参数表第 7 节浅色套）：面板底 sheetPanelBg #F3F3F3（bg_sheet_panel，
     上圆角 16dp＋描边黑 0.06）、内容区可滚动，内边距 16dp/底部 10dp（GlassSheetPanel 口径），
     子面板在代码里换 container 内容。P04：瓜子工具面板根本没有拖动条（宿主非 M3、handle 槽 null），
     星辰自绘 36×4dp 黑 0.14 条已删，不留。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_panel"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="680dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
