<?xml version="1.0" encoding="utf-8"?>
<!-- 红果三杠小抽屉内容：侧边滑出、半幅、尺寸随内容（几行设置就几行高）。
     只放真能用的现成开关：启动直达短剧（他亲定名，第一项）/弹幕/自动连播/清红果缓存。
     皮（2026-10-28 换）：深色面与刷剧页/各半屏单同套（旧纯白板脸被他点名难看、
     撞「弹窗不用白底」令）——面板深底圆角、开关走红果红选中态、清缓存并入整面成行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hg_drawer"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="#F5F5F5"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="启动直达短剧"
            android:textColor="#EDEDED"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/hg_drawer_direct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="启动直达短剧"
            android:switchPadding="5dp"
            android:thumb="@drawable/hg_switch_thumb"
            android:track="@drawable/hg_switch_track" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="弹幕"
            android:textColor="#EDEDED"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/hg_drawer_danmaku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="弹幕"
            android:switchPadding="5dp"
            android:thumb="@drawable/hg_switch_thumb"
            android:track="@drawable/hg_switch_track" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自动连播"
            android:textColor="#EDEDED"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/hg_drawer_autonext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="自动连播"
            android:switchPadding="5dp"
            android:thumb="@drawable/hg_switch_thumb"
            android:track="@drawable/hg_switch_track" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#26FFFFFF" />

    <TextView
        android:id="@+id/hg_drawer_clear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="清红果缓存"
        android:textColor="#EDEDED"
        android:textSize="14sp" />
</LinearLayout>
