<?xml version="1.0" encoding="utf-8"?>
<!-- 猜你喜欢独立页（首页三彩卡「猜你喜欢·每日精选」的子页）：自有底铺满整屏——
     根 home_bg_page 兜底＋MusicGlassBackgroundView 同源场景一层；内容只有列表＋空态覆盖层。
     旧页顶栏／大标题行／工具条在 guess 下恒隐藏，本页直接不带。无返回箭头，走系统返回。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_page"
    android:fitsSystemWindows="true">

    <com.fongmi.android.tv.ui.music.MusicGlassBackgroundView
        android:id="@+id/musicGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:textColor="#636366"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
