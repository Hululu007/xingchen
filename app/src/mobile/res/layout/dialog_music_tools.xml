<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐底部工具面板（浅色令牌照 GZ 参数表第 7 节浅色套）：面板底＝全 App 同源液态玻璃 MusicGlassDrawable（代码装配、仅顶角 16dp）
     （面板底＝全 App 同源液态玻璃 MusicGlassDrawable，代码装配、仅顶角 16dp；内分组卡／格／段控件同源真玻璃）、
     内容区可滚动，内边距 左右 16dp／顶部 16dp／底部 10dp（GlassSheetPanel 口径），
     子面板在代码里换 container 内容。P04：瓜子工具面板根本没有拖动条（宿主非 M3、handle 槽 null），
     星辰自绘 36×4dp 黑 0.14 条已删，不留。
     限高说明：原生 ScrollView 不处理 maxHeight，680dp 上限曾形同虚设、面板顶满屏截断最后一行；
     此处用 MaxHeightScrollView 强制执行 maxHeight，超限部分在限高内正常滚动。
     瓜子对齐后主面板内容约 552dp（竖屏），低于 680dp 上限，竖屏整页露出不滚动；
     680dp 只作小屏／横屏的安全网，不再是常态卡点。瓜子本家没有固定上限（M3 底表单按内容定高）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.MaxHeightScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="680dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp" />
    </com.fongmi.android.tv.ui.custom.MaxHeightScrollView>
</LinearLayout>
